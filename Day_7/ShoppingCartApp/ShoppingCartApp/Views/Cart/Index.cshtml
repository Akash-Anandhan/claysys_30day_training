@model IEnumerable<ShoppingCartApp.Models.CartItem>
@{
    ViewData["Title"] = "My Cart";
    var total = Model.Sum(c => c.UnitPrice * c.Quantity);
}
@if (TempData["Error"] != null)
{
        <div style="color:red">
        @TempData["Error"]
        </div>
}

<h2 class="mb-4"><i class="bi bi-cart3"></i> My Cart</h2>

@if (!Model.Any())
{
        <div class="text-center py-5">
            <i class="bi bi-cart-x" style="font-size:4rem; color:#ccc;"></i>
            <h4 class="mt-3 text-muted">Your cart is empty</h4>
            <a asp-controller="Product" asp-action="Index" class="btn btn-dark mt-3">
                <i class="bi bi-arrow-left"></i> Continue Shopping
            </a>
        </div>
}
else
{
        <div class="row">
            <div class="col-md-8">
                <div class="card shadow-sm">
                    <div class="card-body p-0">
                        <table class="table table-hover mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th>Product</th>
                                    <th>Price</th>
                                    <th>Quantity</th>
                                    <th>Subtotal</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var item in Model)
                            {
                                        <tr>
                                            <td class="align-middle">
                                                <div class="d-flex align-items-center gap-3">
                                                    <img src="@item.Product.ImageUrl" width="60" height="60"
                                                         style="object-fit:cover;" class="rounded" />
                                                    <span class="fw-semibold">@item.Product.Name</span>
                                                </div>
                                            </td>
                                            <td class="align-middle">$@item.UnitPrice.ToString("0.00")</td>
                                            <td class="align-middle" style="width:140px;">
                                                <form asp-action="UpdateQuantity" method="post" class="d-flex gap-1">
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <input type="number" name="quantity" value="@item.Quantity"
                                                           min="1" max="99" class="form-control form-control-sm" style="width:70px;" />
                                                    <button type="submit" class="btn btn-outline-secondary btn-sm">
                                                        <i class="bi bi-arrow-clockwise"></i>
                                                    </button>
                                                </form>
                                            </td>
                                            <td class="align-middle fw-bold text-success">
                                                $@((item.UnitPrice * item.Quantity).ToString("0.00"))
                                            </td>
                                            <td class="align-middle">
                                                        <form asp-action="Remove" method="post" class="remove-form">
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <button type="submit" class="btn btn-outline-danger btn-sm">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Order Summary -->
            <div class="col-md-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-dark text-white">
                        <h5 class="mb-0">Order Summary</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Items (@Model.Count())</span>
                            <span>$@total.ToString("0.00")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Shipping</span>
                            <span class="text-success">Free</span>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between fw-bold fs-5">
                            <span>Total</span>
                            <span class="text-success">$@total.ToString("0.00")</span>
                        </div>
                        <a asp-controller="Order" asp-action="Checkout"
                           class="btn btn-success w-100 mt-3 btn-lg">
                            <i class="bi bi-credit-card"></i> Proceed to Checkout
                        </a>
                        <a asp-controller="Product" asp-action="Index"
                           class="btn btn-outline-dark w-100 mt-2">
                            <i class="bi bi-arrow-left"></i> Continue Shopping
                        </a>
                    </div>
                </div>
            </div>
        </div>
}