@model ShoppingCartApp.ViewModels.SearchViewModel
@{
    ViewData["Title"] = string.IsNullOrEmpty(Model.Query)
        ? "Search Products" : $"Results for '{Model.Query}'";
}

<div class="row mb-4">
    <div class="col-12">
        <h2 class="mb-1"><i class="bi bi-search"></i> Search Products</h2>
        @if (!string.IsNullOrEmpty(Model.Query))
        {
                <p class="text-muted">
                    Found <strong>@Model.TotalResults</strong>
                    result(s) for "<strong>@Model.Query</strong>"
                </p>
        }
    </div>
</div>

<div class="row">

    <!-- Filters Sidebar -->
    <div class="col-md-3">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-dark text-white">
                <h6 class="mb-0"><i class="bi bi-funnel"></i> Filter Results</h6>
            </div>
            <div class="card-body">
                <form asp-action="Index" method="get" id="filter-form">

                    <!-- Search query (hidden, carried over) -->
                    <input type="hidden" name="query" value="@Model.Query" />

                    <!-- Category Filter -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Category</label>
                        <select name="category" class="form-select"
                                onchange="document.getElementById('filter-form').submit()">
                            <option value="">All Categories</option>
                            @foreach (var cat in Model.Categories)
                            {
                                    <option value="@cat.Name"
                                            selected="@(Model.Category == cat.Name)">
                                    @cat.Name
                                    </option>
                            }
                        </select>
                    </div>

                    <!-- Price Range -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Price Range</label>
                        <div class="d-flex gap-2 align-items-center">
                            <input type="number" name="minPrice"
                                   value="@Model.MinPrice"
                                   class="form-control form-control-sm"
                                   placeholder="Min" min="0" />
                            <span>—</span>
                            <input type="number" name="maxPrice"
                                   value="@Model.MaxPrice"
                                   class="form-control form-control-sm"
                                   placeholder="Max" min="0" />
                        </div>
                    </div>

                    <!-- Sort By -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Sort By</label>
                        <select name="sortBy" class="form-select"
                                onchange="document.getElementById('filter-form').submit()">
                            <option value="">Default</option>
                            <option value="price_asc"
                                    selected="@(Model.SortBy == "price_asc")">
                                Price: Low to High
                            </option>
                            <option value="price_desc"
                                    selected="@(Model.SortBy == "price_desc")">
                                Price: High to Low
                            </option>
                            <option value="name_asc"
                                    selected="@(Model.SortBy == "name_asc")">
                                Name: A to Z
                            </option>
                            <option value="name_desc"
                                    selected="@(Model.SortBy == "name_desc")">
                                Name: Z to A
                            </option>
                            <option value="newest"
                                    selected="@(Model.SortBy == "newest")">
                                Newest First
                            </option>
                        </select>
                    </div>

                    <button type="submit" class="btn btn-dark w-100">
                        <i class="bi bi-funnel"></i> Apply Filters
                    </button>

                    @if (!string.IsNullOrEmpty(Model.Category) ||
                        Model.MinPrice.HasValue ||
                        Model.MaxPrice.HasValue ||
                        !string.IsNullOrEmpty(Model.SortBy))
                    {
                            <a asp-action="Index" asp-route-query="@Model.Query"
                               class="btn btn-outline-secondary w-100 mt-2">
                                <i class="bi bi-x-circle"></i> Clear Filters
                            </a>
                    }

                </form>
            </div>
        </div>
    </div>

    <!-- Results -->
    <div class="col-md-9">

        @if (!Model.Results.Any())
        {
                <div class="text-center py-5">
                    <i class="bi bi-search" style="font-size:4rem; color:#ccc;"></i>
                    <h4 class="mt-3 text-muted">No products found</h4>
                    <p class="text-muted">Try a different search term or clear the filters.</p>
                    <a asp-action="Index" class="btn btn-dark mt-2">
                        <i class="bi bi-x-circle"></i> Clear Search
                    </a>
                </div>
        }
        else
        {
                <div class="row row-cols-1 row-cols-md-3 g-4">
                @foreach (var product in Model.Results)
                {
                    var avgRating = product.Reviews != null && product.Reviews.Any()
                        ? product.Reviews.Average(r => r.Rating) : 0;

                            <div class="col">
                                <div class="card h-100 shadow-sm">
                                    <img src="@product.ImageUrl"
                                         class="card-img-top"
                                         alt="@product.Name"
                                         style="height:200px; object-fit:cover;" />
                                    <div class="card-body">
                                        <span class="badge bg-secondary mb-2">
                                    @product.Category?.Name
                                        </span>
                                        <h5 class="card-title">@product.Name</h5>
                                        <p class="card-text text-muted small">
                                    @product.Description
                                        </p>
                                        <p class="fw-bold text-success fs-5">
                                            $@product.Price.ToString("0.00")
                                        </p>

                                        <!-- Star Rating -->
                                        <div class="d-flex gap-1 mb-1">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                                    <i class="bi @(i <= Math.Round(avgRating)
                                            ? "bi-star-fill" : "bi-star") text-warning"
                                                       style="font-size:12px;"></i>
                                    }
                                            <small class="text-muted">
                                                (@(product.Reviews?.Count ?? 0))
                                            </small>
                                        </div>

                                        <p class="text-muted small">
                                            <i class="bi bi-box"></i> @product.Stock in stock
                                        </p>
                                    </div>
                                    <div class="card-footer d-flex flex-column gap-2">
                                        <div class="d-flex gap-2">
                                            <a asp-controller="Product"
                                               asp-action="Details"
                                               asp-route-id="@product.Id"
                                               class="btn btn-outline-dark btn-sm flex-fill">
                                                <i class="bi bi-eye"></i> Details
                                            </a>
                                            <form asp-controller="Cart"
                                                  asp-action="AddToCart"
                                                  method="post"
                                                  class="flex-fill add-to-cart-form">
                                                <input type="hidden" name="productId" value="@product.Id" />
                                                <input type="hidden" name="quantity" value="1" />
                                                <button type="submit" class="btn btn-dark btn-sm w-100">
                                                    <i class="bi bi-cart-plus"></i> Add to Cart
                                                </button>
                                            </form>
                                        </div>
                                        <form asp-controller="Wishlist" asp-action="Add" method="post">
                                            <input type="hidden" name="productId" value="@product.Id" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                                                <i class="bi bi-heart"></i> Add to Wishlist
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                }
                </div>
        }
    </div>
</div>