<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ShoppingCart</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                <i class="bi bi-shop"></i> Shopiee
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Product" asp-action="Index">Products</a>
                    </li>
                </ul>
        
<form asp-controller="Search" asp-action="Index" method="get"
      class="d-flex mx-3 position-relative" style="flex:1; max-width:400px;">
    <div class="input-group">
        <input type="text"
               name="query"
               id="search-input"
               class="form-control"
               placeholder="Search products..."
               autocomplete="off" />
        <button type="submit" class="btn btn-warning">
            <i class="bi bi-search"></i>
        </button>
    </div>
    <div id="search-suggestions"
         class="position-absolute bg-white border rounded shadow w-100"
         style="top:100%; z-index:9999; display:none;">
    </div>
</form>

                <ul class="navbar-nav align-items-center gap-2">
                    @if (User.Identity.IsAuthenticated)
                    {
                        @if (User.IsInRole("Admin"))
                        {
            <li class="nav-item">
                <a class="btn btn-danger btn-sm ms-2"
                   asp-controller="Admin" asp-action="Index">
                    <i class="bi bi-shield-lock"></i> Admin Panel
                </a>
            </li>
                        }
        <li class="nav-item">
            <span class="nav-link text-warning">
                <i class="bi bi-person-circle"></i> @User.Identity.Name
            </span>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="Wishlist" asp-action="Index">
                <i class="bi bi-heart"></i> Wishlist
                <span class="badge bg-danger" id="wishlist-count">0</span>
            </a>
        </li>




        <li class="nav-item">
            <a class="nav-link" asp-controller="Cart" asp-action="Index">
                <i class="bi bi-cart3"></i> Cart
                <span class="badge bg-danger" id="cart-count">0</span>
            </a>
        </li>
        <li class="nav-item">
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="btn btn-outline-warning btn-sm">
                    <i class="bi bi-box-arrow-right"></i> Logout
                </button>
            </form>
        </li>
                    }
                    else
                    {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right"></i> Login
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-warning btn-sm" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus"></i> Register
                                </a>
                            </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="container my-4">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-dark text-white text-center py-3 mt-5">
        <p class="mb-0">&copy; 2026 Shopiee. All rights reserved.</p>
    </footer>

    <!-- Toast Container -->
    <div id="toast-container" class="toast-container"></div>

    <!-- Loading Spinner
<div class="spinner-overlay">
        <div class="spinner-border text-dark" style="width:3rem; height:3rem;"></div>
    </div>

    -->
    
    <!-- Scripts — only ONE RenderSectionAsync here -->
    <!-- Scripts -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.12/dist/jquery.validate.unobtrusive.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>