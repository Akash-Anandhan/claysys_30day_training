@model ShoppingCartApp.Models.Product
@using Microsoft.AspNetCore.Identity
@inject UserManager<ShoppingCartApp.Models.ApplicationUser> UserManager
@{
    ViewData["Title"] = Model.Name;
    var userId = UserManager.GetUserId(User);
    var avgRating = Model.Reviews != null && Model.Reviews.Any()
        ? Model.Reviews.Average(r => r.Rating) : 0;
    var userReview = Model.Reviews?.FirstOrDefault(r => r.UserId == userId);
}

<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
        <li class="breadcrumb-item"><a asp-controller="Product" asp-action="Index">Products</a></li>
        <li class="breadcrumb-item active">@Model.Name</li>
    </ol>
</nav>

<div class="row">
    <div class="col-md-5">
        <img src="@Model.ImageUrl" class="img-fluid rounded shadow" alt="@Model.Name" />
    </div>
    <div class="col-md-7">
        <span class="badge bg-secondary mb-2">@Model.Category?.Name</span>
        <h1 class="mb-2">@Model.Name</h1>
        <p class="text-muted">@Model.Description</p>
        <h3 class="text-success mb-1">$@Model.Price.ToString("0.00")</h3>

        <!-- Average Rating Display -->
        <div class="d-flex align-items-center gap-2 mb-3">
            @for (int i = 1; i <= 5; i++)
            {
                if (i <= Math.Round(avgRating))
                {
                            <i class="bi bi-star-fill text-warning"></i>
                }
                else
                {
                            <i class="bi bi-star text-warning"></i>
                }
            }
            <span class="text-muted small">
                @if (Model.Reviews != null && Model.Reviews.Any())
                {
                        <span>@avgRating.ToString("0.0") out of 5 (@Model.Reviews.Count reviews)</span>
                }
                else
                {
                        <span>No reviews yet</span>
                }
            </span>
        </div>

        <p class="text-muted">
            <i class="bi bi-box"></i> @Model.Stock items in stock
        </p>

        <form asp-controller="Cart" asp-action="AddToCart" method="post"
              class="d-flex gap-3 align-items-center mt-4">
            <input type="hidden" name="productId" value="@Model.Id" />
            <div class="d-flex align-items-center gap-2">
                <label class="fw-bold">Qty:</label>
                <input type="number" name="quantity" value="1" min="1" max="@Model.Stock"
                       class="form-control" style="width:80px;" />
            </div>
            <button type="submit" class="btn btn-dark btn-lg">
                <i class="bi bi-cart-plus"></i> Add to Cart
            </button>
        </form>

        <form asp-controller="Wishlist" asp-action="Add" method="post" class="mt-3">
            <input type="hidden" name="productId" value="@Model.Id" />
            <button type="submit" class="btn btn-outline-danger">
                <i class="bi bi-heart"></i> Add to Wishlist
            </button>
        </form>

        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary mt-3">
            <i class="bi bi-arrow-left"></i> Back to Products
        </a>
    </div>
</div>

<hr class="my-5" />

<!-- Reviews Section -->
<div class="row">
    <div class="col-md-8">
        <h3 class="mb-4"><i class="bi bi-chat-left-text"></i> Customer Reviews</h3>

        <!-- Success / Error Messages -->
        @if (TempData["ReviewSuccess"] != null)
        {
                <div class="alert alert-success alert-dismissible fade show">
                    <i class="bi bi-check-circle"></i> @TempData["ReviewSuccess"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
        }
        @if (TempData["ReviewError"] != null)
        {
                <div class="alert alert-danger alert-dismissible fade show">
                    <i class="bi bi-exclamation-circle"></i> @TempData["ReviewError"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
        }

        <!-- Existing Reviews -->
        @if (Model.Reviews != null && Model.Reviews.Any())
        {
            @foreach (var review in Model.Reviews.OrderByDescending(r => r.CreatedAt))
            {
                        <div class="card mb-3 shadow-sm">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h6 class="fw-bold mb-1">
                                            <i class="bi bi-person-circle"></i>
                                    @review.User?.FullName ?? "User"
                                        </h6>
                                        <div class="d-flex gap-1 mb-2">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= review.Rating)
                                        {
                                                            <i class="bi bi-star-fill text-warning"></i>
                                        }
                                        else
                                        {
                                                            <i class="bi bi-star text-warning"></i>
                                        }
                                    }
                                        </div>
                                        <p class="mb-1">@review.Comment</p>
                                        <small class="text-muted">
                                    @review.CreatedAt.ToString("MMM dd, yyyy")
                                        </small>
                                    </div>

                                    <!-- Delete button (only for review owner) -->
                            @if (review.UserId == userId)
                            {
                                            <form asp-controller="Review" asp-action="Delete" method="post">
                                                <input type="hidden" name="id" value="@review.Id" />
                                                <input type="hidden" name="productId" value="@Model.Id" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm"
                                                        onclick="return confirm('Delete your review?')">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                            }
                                </div>
                            </div>
                        </div>
            }
        }
        else
        {
                <p class="text-muted">No reviews yet. Be the first to review!</p>
        }
    </div>

    <!-- Add Review Form -->
    <div class="col-md-4">
        @if (User.Identity.IsAuthenticated)
        {
            if (userReview == null)
            {
                        <div class="card shadow-sm">
                            <div class="card-header bg-dark text-white">
                                <h5 class="mb-0"><i class="bi bi-pencil"></i> Write a Review</h5>
                            </div>
                            <div class="card-body">
                                <form asp-controller="Review" asp-action="Add" method="post">
                                    <input type="hidden" name="ProductId" value="@Model.Id" />

                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Rating</label>
                                        <div class="d-flex gap-2">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                                    <div class="form-check form-check-inline">
                                                        <input class="form-check-input" type="radio"
                                                               name="Rating" value="@i" id="star@i"
                                                               required />
                                                        <label class="form-check-label" for="star@i">
                                                @i <i class="bi bi-star-fill text-warning"></i>
                                                        </label>
                                                    </div>
                                    }
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Your Review</label>
                                        <textarea name="Comment" class="form-control" rows="4"
                                                  placeholder="Share your thoughts about this product..."
                                                  maxlength="500" required></textarea>
                                    </div>

                                    <button type="submit" class="btn btn-dark w-100">
                                        <i class="bi bi-send"></i> Submit Review
                                    </button>
                                </form>
                            </div>
                        </div>
            }
            else
            {
                        <div class="card shadow-sm">
                            <div class="card-body text-center py-4">
                                <i class="bi bi-check-circle-fill text-success" style="font-size:2rem;"></i>
                                <p class="mt-2 mb-0">You have already reviewed this product.</p>
                            </div>
                        </div>
            }
        }
        else
        {
                <div class="card shadow-sm">
                    <div class="card-body text-center py-4">
                        <i class="bi bi-lock" style="font-size:2rem; color:#ccc;"></i>
                        <p class="mt-2">Please login to write a review.</p>
                        <a asp-controller="Account" asp-action="Login"
                           class="btn btn-dark btn-sm">
                            <i class="bi bi-box-arrow-in-right"></i> Login
                        </a>
                    </div>
                </div>
        }
    </div>
</div>