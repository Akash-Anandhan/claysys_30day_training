@model IEnumerable<ShoppingCartApp.Models.Product>
@{
    ViewData["Title"] = "Manage Products";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-box-seam"></i> Manage Products</h2>
    <a asp-action="CreateProduct" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Add New Product
    </a>
</div>

@if (TempData["Success"] != null)
{
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Image</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Reviews</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                        <tr>
                            <td>
                                <img src="@product.ImageUrl" width="55" height="55"
                                     class="rounded" style="object-fit:cover;" />
                            </td>
                            <td class="align-middle fw-semibold">@product.Name</td>
                            <td class="align-middle">
                                <span class="badge bg-secondary">@product.Category?.Name</span>
                            </td>
                            <td class="align-middle text-success fw-bold">
                                $@product.Price.ToString("0.00")
                            </td>
                            <td class="align-middle">
                            @if (product.Stock < 5)
                            {
                                        <span class="badge bg-danger">@product.Stock</span>
                            }
                            else
                            {
                                        <span class="badge bg-success">@product.Stock</span>
                            }
                            </td>
                            <td class="align-middle">
                                <span class="badge bg-warning text-dark">
                                @(product.Reviews?.Count ?? 0)
                                </span>
                            </td>
                            <td class="align-middle">
                                <div class="d-flex gap-2">
                                    <a asp-action="EditProduct" asp-route-id="@product.Id"
                                       class="btn btn-outline-primary btn-sm">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <form asp-action="DeleteProduct" method="post"
                                          onsubmit="return confirm('Delete @product.Name? This cannot be undone.')">
                                        <input type="hidden" name="id" value="@product.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm">
                                            <i class="bi bi-trash"></i> Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                }
            </tbody>
        </table>
    </div>
</div>