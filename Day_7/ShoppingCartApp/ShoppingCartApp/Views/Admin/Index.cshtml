@{
    ViewData["Title"] = "Admin Dashboard";
    var stats = Model as dynamic;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-speedometer2"></i> Admin Dashboard</h2>
    <span class="badge bg-danger fs-6">Admin Panel</span>
</div>

@if (TempData["Success"] != null)
{
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
}

<!-- Stats Cards -->
<div class="row row-cols-1 row-cols-md-4 g-4 mb-5">
    <div class="col">
        <div class="card text-white bg-dark shadow-sm">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="card-title mb-1">Total Products</h6>
                    <h2 class="mb-0">@stats.TotalProducts</h2>
                </div>
                <i class="bi bi-box-seam" style="font-size:2.5rem; opacity:0.4;"></i>
            </div>
            <div class="card-footer">
                <a asp-action="Products" class="text-white small">
                    Manage Products <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card text-white bg-success shadow-sm">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="card-title mb-1">Total Orders</h6>
                    <h2 class="mb-0">@stats.TotalOrders</h2>
                </div>
                <i class="bi bi-bag-check" style="font-size:2.5rem; opacity:0.4;"></i>
            </div>
            <div class="card-footer">
                <span class="text-white small">All time orders</span>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card text-white bg-primary shadow-sm">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="card-title mb-1">Total Users</h6>
                    <h2 class="mb-0">@stats.TotalUsers</h2>
                </div>
                <i class="bi bi-people" style="font-size:2.5rem; opacity:0.4;"></i>
            </div>
            <div class="card-footer">
                <span class="text-white small">Registered users</span>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card text-white bg-warning shadow-sm">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="card-title mb-1">Total Reviews</h6>
                    <h2 class="mb-0">@stats.TotalReviews</h2>
                </div>
                <i class="bi bi-star" style="font-size:2.5rem; opacity:0.4;"></i>
            </div>
            <div class="card-footer">
                <a asp-action="Reviews" class="text-white small">
                    Manage Reviews <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Recent Orders -->
    <div class="col-md-7">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0"><i class="bi bi-clock-history"></i> Recent Orders</h5>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Order #</th>
                            <th>Date</th>
                            <th>Items</th>
                            <th>Total</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in stats.RecentOrders)
                        {
                                <tr>
                                    <td>#@order.Id</td>
                                    <td>@order.OrderDate.ToString("MMM dd")</td>
                                    <td>@order.OrderItems.Count items</td>
                                    <td class="text-success fw-bold">
                                        $@order.TotalAmount.ToString("0.00")
                                    </td>
                                    <td>
                                        <span class="badge bg-warning text-dark">
                                        @order.Status
                                        </span>
                                    </td>
                                </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Low Stock Warning -->
    <div class="col-md-5">
        <div class="card shadow-sm mb-4 border-warning">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0">
                    <i class="bi bi-exclamation-triangle"></i> Low Stock Alert
                </h5>
            </div>
            @if (stats.LowStockProducts.Count == 0)
            {
                    <div class="card-body text-center text-muted py-4">
                        <i class="bi bi-check-circle text-success" style="font-size:2rem;"></i>
                        <p class="mt-2 mb-0">All products are well stocked!</p>
                    </div>
            }
            else
            {
                    <div class="card-body p-0">
                        <ul class="list-group list-group-flush">
                        @foreach (var product in stats.LowStockProducts)
                        {
                                    <li class="list-group-item d-flex justify-content-between">
                                        <span>@product.Name</span>
                                        <span class="badge bg-danger">@product.Stock left</span>
                                    </li>
                        }
                        </ul>
                    </div>
            }
        </div>
    </div>
</div>