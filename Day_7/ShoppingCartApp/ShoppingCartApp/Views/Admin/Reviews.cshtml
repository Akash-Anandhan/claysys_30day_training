@model IEnumerable<ShoppingCartApp.Models.Review>
@{
    ViewData["Title"] = "Manage Reviews";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-star"></i> Manage Reviews</h2>
    <a asp-action="Index" class="btn btn-outline-dark">
        <i class="bi bi-arrow-left"></i> Back to Dashboard
    </a>
</div>

@if (TempData["Success"] != null)
{
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Product</th>
                    <th>User</th>
                    <th>Rating</th>
                    <th>Comment</th>
                    <th>Date</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var review in Model)
                {
                        <tr>
                            <td class="align-middle fw-semibold">
                            @review.Product?.Name
                            </td>
                            <td class="align-middle">
                            @review.User?.FullName
                                <br />
                                <small class="text-muted">@review.User?.Email</small>
                            </td>
                            <td class="align-middle">
                            @for (int i = 1; i <= 5; i++)
                            {
                                        <i class="bi @(i <= review.Rating
                                    ? "bi-star-fill" : "bi-star") text-warning"
                                           style="font-size:12px;"></i>
                            }
                            </td>
                            <td class="align-middle" style="max-width:250px;">
                                <span class="text-truncate d-block">@review.Comment</span>
                            </td>
                            <td class="align-middle text-muted small">
                            @review.CreatedAt.ToString("MMM dd, yyyy")
                            </td>
                            <td class="align-middle">
                                <form asp-action="DeleteReview" method="post"
                                      onsubmit="return confirm('Delete this review?')">
                                    <input type="hidden" name="id" value="@review.Id" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                }
            </tbody>
        </table>
    </div>
</div>