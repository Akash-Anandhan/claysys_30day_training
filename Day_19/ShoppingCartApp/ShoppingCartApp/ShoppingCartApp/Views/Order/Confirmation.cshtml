@model ShoppingCartApp.Models.Order
@{
    ViewData["Title"] = "Order Confirmed";
}

<div class="text-center py-5 mt-4">
    <div class="d-inline-flex justify-content-center align-items-center rounded-circle mb-4 shadow" style="width: 120px; height: 120px; background: linear-gradient(135deg, #10b981, #059669); color: white;">
        <i class="bi bi-check-circle-fill" style="font-size: 4rem;"></i>
    </div>
    <h1 class="display-5 fw-bold mb-3" style="font-family: 'Space Grotesk', sans-serif; letter-spacing: -0.02em; color: #111827;">Order Confirmed!</h1>
    <p class="text-muted fs-5 mx-auto" style="max-width: 600px;">
        Thank you for your purchase. Your order <span class="fw-bold text-dark">#@Model.Id</span> has been placed successfully and is being processed.
    </p>

    <!-- Uses OrderAgeLabel from Order.Calculations.cs -->
    <p class="text-muted small fw-medium mt-2">
        <i class="bi bi-clock me-1"></i> Placed @Model.OrderAgeLabel
    </p>
</div>

<div class="row justify-content-center pb-5 mb-5">
    <div class="col-md-8 col-lg-7">

        <!-- Uses GetOrderSummary() from Order.Calculations.cs -->
        <div class="alert shadow-sm border-0 mb-4 d-flex align-items-center p-4" style="background: rgba(59,130,246,0.05); color: #1e40af; border-radius: 16px;">
            <i class="bi bi-info-circle-fill fs-3 me-3" style="color: #3b82f6;"></i>
            <span class="fw-medium text-dark" style="font-size: 1.05rem;">@Model.GetOrderSummary()</span>
        </div>

        <div class="card shadow-sm border-0" style="border-radius: 20px; overflow: hidden;">
            <div class="card-header bg-white border-bottom py-4 px-4 d-flex justify-content-between align-items-center">
                <span class="fs-5 fw-bold" style="font-family: 'Space Grotesk', sans-serif; color: #111827;">Order Details</span>
                <!-- Uses StatusBadgeColor from Order.Calculations.cs -->
                <span class="badge rounded-pill fw-bold shadow-sm px-3 py-2 bg-@Model.StatusBadgeColor" style="font-size: 0.85rem;">
                    @Model.Status
                </span>
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush border-bottom">
                    @foreach (var item in Model.OrderItems)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center py-4 px-4 border-0 border-bottom">
                            <div class="d-flex align-items-center gap-3">
                                <img src="@item.Product.ImageUrl" width="60" height="60" class="rounded-3 shadow-sm border" style="object-fit:cover;" />
                                <div>
                                    <div class="fw-bold" style="color: #111827; font-size: 1.05rem;">
                                        @item.Product.Name
                                    </div>
                                    <small class="text-muted fw-medium">
                                        Qty: @item.Quantity &times; $@item.UnitPrice.ToString("0.00")
                                    </small>
                                </div>
                            </div>
                            <span class="fw-bold fs-5 text-dark">
                                $@((item.UnitPrice * item.Quantity).ToString("0.00"))
                            </span>
                        </li>
                    }
                </ul>
            </div>
            <div class="card-footer bg-light px-4 py-4 border-0">
                <div class="d-flex justify-content-between mb-2 text-muted fw-medium">
                    <span>Shipping Address</span>
                    <span class="text-end" style="max-width: 60%; color: #374151;">@Model.ShippingAddress</span>
                </div>

                <!-- Uses TotalItemCount from Order.Calculations.cs -->
                <div class="d-flex justify-content-between mb-3 text-muted fw-medium">
                    <span>Total items</span>
                    <span style="color: #374151;">@Model.TotalItemCount items</span>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-3 border-top border-dark-subtle mt-2">
                    <span class="fs-5 fw-bold" style="color: #111827;">Total Paid</span>
                    <span class="fw-bold" style="color: #10b981; font-size: 2rem; font-family: 'Space Grotesk', sans-serif;">
                        $@Model.TotalAmount.ToString("0.00")
                    </span>
                </div>
            </div>
        </div>

        <div class="d-flex gap-3 mt-5 pb-5 justify-content-center">
            <a asp-controller="Home" asp-action="Index" class="btn rounded-pill fw-bold px-4 py-3 shadow-sm" style="background: #f1f5f9; color: #4b5563; border: none; transition: background 0.2s ease;" onmouseover="this.style.background='#e2e8f0'" onmouseout="this.style.background='#f1f5f9'">
                <i class="bi bi-house me-2"></i> Back to Home
            </a>
            <a asp-controller="Product" asp-action="Index" class="btn rounded-pill text-white fw-bold px-4 py-3 shadow-sm" style="background: #e85d2a; border: none; transition: transform 0.2s ease;" onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='translateY(0)'">
                <i class="bi bi-bag me-2"></i> Continue Shopping
            </a>
        </div>
    </div>
</div>