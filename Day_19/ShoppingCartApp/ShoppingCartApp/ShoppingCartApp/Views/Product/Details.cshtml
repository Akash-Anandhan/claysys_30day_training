@model ShoppingCartApp.Models.Product
@using Microsoft.AspNetCore.Identity
@inject UserManager<ShoppingCartApp.Models.ApplicationUser> UserManager
@{
    ViewData["Title"] = Model.Name;
    var userId = UserManager.GetUserId(User);
    var avgRating = Model.Reviews != null && Model.Reviews.Any() ? Model.Reviews.Average(r => r.Rating) : 0;
    var userReview = Model.Reviews?.FirstOrDefault(r => r.UserId == userId);
}

<nav aria-label="breadcrumb" class="mb-4 mt-2">
    <ol class="breadcrumb" style="font-weight: 500; font-size: 0.95rem;">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none" style="color: #6b7280;">Home</a></li>
        <li class="breadcrumb-item"><a asp-controller="Product" asp-action="Index" class="text-decoration-none" style="color: #6b7280;">Products</a></li>
        <li class="breadcrumb-item active fw-bold" style="color: #111827;">@Model.Name</li>
    </ol>
</nav>

<div class="row g-5 mb-5 align-items-center">
    <!-- Image Column -->
    <div class="col-md-6">
        <div class="position-relative" style="border-radius: 24px; overflow: hidden; background: #f8fafc; padding: 2rem;">
            <img src="@Model.ImageUrl" class="img-fluid w-100 shadow-sm p-4" alt="@Model.Name" style="border-radius: 16px; object-fit: contain; background-color: #ffffff; max-height: 500px;" />
            <div class="position-absolute top-0 start-0 m-4">
                <span class="badge rounded-pill shadow-sm py-2 px-3 fw-bold" style="background: rgba(255,255,255,0.9); color: #e85d2a; font-family: 'Space Grotesk', sans-serif;">@Model.Category?.Name</span>
            </div>
        </div>
    </div>

    <!-- Product Info Column -->
    <div class="col-md-6">
        <h1 class="display-5 fw-bold mb-3" style="font-family: 'Space Grotesk', sans-serif; letter-spacing: -0.03em; color: #111827;">@Model.Name</h1>

        <!-- Rating -->
        <div class="d-flex align-items-center gap-2 mb-4">
            <div class="d-flex gap-1" style="color: #f59e0b;">
                @for (int i = 1; i <= 5; i++)
                {
                    <i class="bi @(i <= Math.Round(avgRating) ? "bi-star-fill" : "bi-star")" style="font-size: 1.1rem; opacity: @(i <= Math.Round(avgRating) ? "1" : "0.3");"></i>
                }
            </div>
            <span class="badge rounded-pill" style="background: #f3f4f6; color: #4b5563;">
                @if (Model.Reviews != null && Model.Reviews.Any())
                {
                    <span class="fw-semibold">@avgRating.ToString("0.0")</span> <span>(@Model.Reviews.Count reviews)</span>
                }
                else
                {
                    <span>No reviews yet</span>
                }
            </span>
        </div>

        <!-- Price -->
        <h2 class="mb-4 fw-bold" style="font-family: 'Space Grotesk', sans-serif; color: #10b981; font-size: 2.5rem;">
            $@Model.Price.ToString("0.00")
        </h2>

        <!-- Description text -->
        <p class="fs-5 mb-4 text-muted" style="line-height: 1.7;">@Model.Description</p>

        <!-- Stock Status -->
        <div class="alert mb-4 border-0 shadow-sm d-inline-flex align-items-center" style="background: @(Model.Stock > 0 ? "rgba(16,185,129,0.1)" : "rgba(239,68,68,0.1)"); color: @(Model.Stock > 0 ? "#10b981" : "#ef4444"); border-radius: 12px; font-weight: 600;">
            <i class="bi @(Model.Stock > 0 ? "bi-check-circle-fill" : "bi-x-circle-fill") me-2" style="font-size: 1.25rem;"></i>
            @(Model.Stock > 0 ? $"{Model.Stock} items in stock. Order soon!" : "Out of stock")
        </div>

        @if (Model.Stock > 0)
        {
            <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-flex flex-column gap-3 mt-2 mb-4">
                <input type="hidden" name="productId" value="@Model.Id" />
                <div class="row g-3">
                    <div class="col-auto">
                        <div class="input-group" style="height: 56px;">
                            <span class="input-group-text fw-bold border-0 text-muted" style="background: #f8fafc; border-radius: 16px 0 0 16px;">Qty</span>
                            <input type="number" name="quantity" value="1" min="1" max="@Model.Stock" class="form-control fw-bold border-0 bg-light text-center" style="width: 80px; box-shadow: none;" />
                        </div>
                    </div>
                    <div class="col">
                        <button type="submit" class="btn w-100 h-100 rounded-4 text-white fw-bold shadow-sm d-flex justify-content-center align-items-center gap-2" style="background: #e85d2a; border: none; font-size: 1.1rem; transition: transform 0.2s ease;" onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='translateY(0)'">
                            <i class="bi bi-cart-plus"></i> Add to Cart
                        </button>
                    </div>
                </div>
            </form>
        }

        <div class="d-flex gap-3">
            <form asp-controller="Wishlist" asp-action="Add" method="post" class="flex-fill">
                <input type="hidden" name="productId" value="@Model.Id" />
                <button type="submit" class="btn w-100 rounded-pill fw-semibold py-2 d-flex justify-content-center align-items-center gap-2" style="background: rgba(124,88,204,0.05); color: #7c58cc; border: 1px solid rgba(124,88,204,0.2); transition: all 0.2s ease;" onmouseover="this.style.background='#7c58cc'; this.style.color='#fff';" onmouseout="this.style.background='rgba(124,88,204,0.05)'; this.style.color='#7c58cc';">
                    <i class="bi bi-heart"></i> Add to Wishlist
                </button>
            </form>
            <a asp-controller="Product" asp-action="Index" class="btn flex-fill rounded-pill fw-semibold py-2 d-flex justify-content-center align-items-center gap-2" style="background: #f3f4f6; color: #4b5563; border: none; transition: background 0.2s ease;" onmouseover="this.style.background='#e5e7eb'" onmouseout="this.style.background='#f3f4f6'">
                <i class="bi bi-arrow-left"></i> Back to Products
            </a>
        </div>
    </div>
</div>

<div class="mb-5 border-top pt-5">
    <div class="row">
        <!-- Reviews List Section -->
        <div class="col-lg-8 pe-lg-5 mb-5 mb-lg-0">
            <h3 class="fw-bold mb-4" style="font-family: 'Space Grotesk', sans-serif; letter-spacing: -0.02em;">
                <i class="bi bi-chat-left-text text-muted me-2"></i> Customer Reviews
            </h3>

            @if (TempData["ReviewSuccess"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm" style="border-radius: 12px; border: none; border-left: 4px solid #10b981; font-size: 0.95rem;">
                    <i class="bi bi-check-circle-fill me-2" style="color: #10b981;"></i> @TempData["ReviewSuccess"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["ReviewError"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm" style="border-radius: 12px; border: none; border-left: 4px solid #ef4444; font-size: 0.95rem;">
                    <i class="bi bi-exclamation-circle-fill me-2" style="color: #ef4444;"></i> @TempData["ReviewError"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (Model.Reviews != null && Model.Reviews.Any())
            {
                <div class="d-flex flex-column gap-4 mt-4">
                    @foreach (var review in Model.Reviews.OrderByDescending(r => r.CreatedAt))
                    {
                        <div class="card border-0 shadow-sm" style="border-radius: 16px;">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold shadow-sm" style="width: 48px; height: 48px; background: linear-gradient(135deg, #7c58cc, #3b82f6); font-size: 1.2rem;">
                                            @((review.User?.FullName ?? "U")[0])
                                        </div>
                                        <div>
                                            <h6 class="fw-bold mb-1" style="color: #111827;">@review.User?.FullName</h6>
                                            <div class="d-flex gap-1" style="color: #f59e0b;">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    <i class="bi @(i <= review.Rating ? "bi-star-fill" : "bi-star")" style="font-size: 0.85rem; opacity: @(i <= review.Rating ? "1" : "0.3");"></i>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <small class="text-muted fw-medium badge rounded-pill bg-light border">@review.CreatedAt.ToString("MMM dd, yyyy")</small>
                                </div>
                                <p class="text-muted mb-0" style="line-height: 1.6;">@review.Comment</p>

                                @if (review.UserId == userId)
                                {
                                    <div class="mt-3 pt-3 border-top text-end">
                                        <form asp-controller="Review" asp-action="Delete" method="post">
                                            <input type="hidden" name="id" value="@review.Id" />
                                            <input type="hidden" name="productId" value="@Model.Id" />
                                            <button type="submit" class="btn btn-sm rounded-pill fw-semibold" style="background: rgba(239,68,68,0.1); color: #ef4444; border: none; transition: all 0.2s ease;" onmouseover="this.style.background='#ef4444'; this.style.color='#fff';" onmouseout="this.style.background='rgba(239,68,68,0.1)'; this.style.color='#ef4444';" onclick="return confirm('Delete your review?')">
                                                <i class="bi bi-trash me-1"></i> Delete
                                            </button>
                                        </form>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5 rounded-4" style="background: rgba(243,244,246,0.5);">
                    <div class="d-inline-flex justify-content-center align-items-center rounded-circle mb-3 shadow-sm text-muted" style="width: 80px; height: 80px; background: #fff; font-size: 2rem;">
                        <i class="bi bi-chat-square-heart"></i>
                    </div>
                    <h5 class="fw-bold mb-2">No reviews yet</h5>
                    <p class="text-muted mb-0">Be the first to share your thoughts on this product!</p>
                </div>
            }
        </div>

        <!-- Add Review Section -->
        <div class="col-lg-4">
            <div class="position-sticky" style="top: 100px;">
                @if (User.Identity.IsAuthenticated)
                {
                    if (userReview == null)
                    {
                        <div class="card border-0 shadow-sm" style="border-radius: 20px; background: linear-gradient(135deg, rgba(124,88,204,0.03), rgba(232,93,42,0.03));">
                            <div class="card-body p-4 p-md-5">
                                <h4 class="fw-bold mb-4 text-center" style="font-family: 'Space Grotesk', sans-serif;">Write a Review</h4>
                                <form asp-controller="Review" asp-action="Add" method="post">
                                    <input type="hidden" name="ProductId" value="@Model.Id" />
                                    
                                    <div class="mb-4 text-center">
                                        <label class="form-label fw-bold small text-uppercase text-muted" style="letter-spacing: 0.5px;">Your Rating</label>
                                        <div class="d-flex justify-content-center gap-3 star-rating">
                                            @for (int i = 5; i >= 1; i--)
                                            {
                                                <!-- Using backwards logic for CSS sibling selector hover -->
                                                <input class="btn-check" type="radio" name="Rating" value="@i" id="star@i" required />
                                                <label class="btn btn-outline-warning rounded-circle d-flex justify-content-center align-items-center" for="star@i" style="width: 44px; height: 44px; font-size: 1.2rem; border-color: transparent;">
                                                    <i class="bi bi-star-fill"></i>
                                                </label>
                                            }
                                        </div>
                                    </div>

                                    <div class="mb-4">
                                        <label class="form-label fw-bold small text-uppercase text-muted" style="letter-spacing: 0.5px;">Your feedback</label>
                                        <textarea name="Comment" class="form-control" rows="4" placeholder="What did you like or dislike?" maxlength="500" style="border-radius: 12px; padding: 1rem; border: 1px solid #e5e7eb;" required></textarea>
                                    </div>

                                    <button type="submit" class="btn w-100 rounded-pill text-white fw-bold py-3 shadow-sm" style="background: #e85d2a; border: none; transition: transform 0.2s ease;" onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='translateY(0)'">
                                        <i class="bi bi-send me-2"></i> Submit Review
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="card border-0 shadow-sm" style="border-radius: 20px;">
                            <div class="card-body text-center p-5">
                                <div class="d-inline-flex border justify-content-center align-items-center rounded-circle mb-4" style="width: 80px; height: 80px; border-color: #10b981 !important;">
                                    <i class="bi bi-check2 text-success" style="font-size:3rem;"></i>
                                </div>
                                <h4 class="fw-bold">Review Submitted!</h4>
                                <p class="text-muted mt-2 mb-0">Thanks for sharing your feedback on this product.</p>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="card border-0 shadow-sm" style="border-radius: 20px;">
                        <div class="card-body text-center p-5">
                            <div class="d-inline-flex justify-content-center align-items-center rounded-circle mb-4 shadow-sm" style="width: 80px; height: 80px; background: rgba(59,130,246,0.1); color: #3b82f6; font-size: 2.5rem;">
                                <i class="bi bi-lock-fill"></i>
                            </div>
                            <h5 class="fw-bold">Login to Review</h5>
                            <p class="text-muted mt-2 mb-4">Please log in to your account to write a review.</p>
                            <a asp-controller="Account" asp-action="Login" class="btn w-100 rounded-pill text-white fw-bold py-3 shadow-sm" style="background: #3b82f6; border: none; transition: transform 0.2s ease;" onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='translateY(0)'">
                                <i class="bi bi-box-arrow-in-right me-2"></i> Login Now
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    /* Reverse logic to make hover fill previous stars work with sibling selectors */
    .star-rating {
        flex-direction: row-reverse;
    }
    .star-rating input {
        display: none;
    }
    .star-rating label {
        color: #d1d5db;
        transition: all 0.2s;
        cursor: pointer;
    }
    .star-rating label i {
        color: inherit;
    }
    .star-rating input:checked ~ label,
    .star-rating label:hover,
    .star-rating label:hover ~ label {
        color: #f59e0b;
        background: rgba(245,158,11,0.1);
    }
    .form-control:focus {
        border-color: #e85d2a !important;
        box-shadow: 0 0 0 4px rgba(232,93,42,0.1) !important;
    }
</style>