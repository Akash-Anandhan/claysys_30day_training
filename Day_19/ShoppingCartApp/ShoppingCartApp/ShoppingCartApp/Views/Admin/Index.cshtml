@{
    ViewData["Title"] = "Admin Dashboard";
    var stats = Model as dynamic;
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-2">
    <h2 class="fw-bold mb-0" style="font-family: 'Space Grotesk', sans-serif; letter-spacing: -0.02em;">
        <i class="bi bi-speedometer2" style="color: #e85d2a;"></i> Admin Dashboard
    </h2>
    <span class="badge rounded-pill" style="background: rgba(232,93,42,0.1); color: #e85d2a; padding: 8px 16px; font-weight: 600;">Admin Panel</span>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" style="border-radius: 12px; border: none; border-left: 4px solid #10b981; font-size: 0.95rem;">
        <i class="bi bi-check-circle-fill me-2" style="color: #10b981;"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Stats Cards -->
<div class="row row-cols-1 row-cols-md-4 g-4 mb-5">
    <div class="col">
        <div class="card h-100 border-0 shadow-sm admin-stat-card" style="border-radius: 16px; transition: transform 0.2s ease, box-shadow 0.2s ease;">
            <div class="card-body d-flex justify-content-between align-items-center p-4">
                <div>
                    <h6 class="card-title mb-1 text-muted fw-semibold" style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px;">Total Products</h6>
                    <h2 class="mb-0 fw-bold" style="font-family: 'Space Grotesk', sans-serif; color: #111827;">@stats.TotalProducts</h2>
                </div>
                <div class="d-flex align-items-center justify-content-center rounded-circle" style="width: 56px; height: 56px; background: rgba(59,130,246,0.1);">
                    <i class="bi bi-box-seam" style="font-size:1.8rem; color: #3b82f6;"></i>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0 px-4 pb-4 pt-0">
                <a asp-action="Products" class="text-decoration-none fw-semibold" style="font-size: 0.85rem; color: #3b82f6;">
                    Manage Products <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100 border-0 shadow-sm admin-stat-card" style="border-radius: 16px; transition: transform 0.2s ease, box-shadow 0.2s ease;">
            <div class="card-body d-flex justify-content-between align-items-center p-4">
                <div>
                    <h6 class="card-title mb-1 text-muted fw-semibold" style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px;">Total Orders</h6>
                    <h2 class="mb-0 fw-bold" style="font-family: 'Space Grotesk', sans-serif; color: #111827;">@stats.TotalOrders</h2>
                </div>
                <div class="d-flex align-items-center justify-content-center rounded-circle" style="width: 56px; height: 56px; background: rgba(16,185,129,0.1);">
                    <i class="bi bi-bag-check" style="font-size:1.8rem; color: #10b981;"></i>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0 px-4 pb-4 pt-0">
                <a asp-action="Orders" class="text-decoration-none fw-semibold" style="font-size: 0.85rem; color: #10b981;">
                    Manage Orders <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100 border-0 shadow-sm admin-stat-card" style="border-radius: 16px; transition: transform 0.2s ease, box-shadow 0.2s ease;">
            <div class="card-body d-flex justify-content-between align-items-center p-4">
                <div>
                    <h6 class="card-title mb-1 text-muted fw-semibold" style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px;">Total Users</h6>
                    <h2 class="mb-0 fw-bold" style="font-family: 'Space Grotesk', sans-serif; color: #111827;">@stats.TotalUsers</h2>
                </div>
                <div class="d-flex align-items-center justify-content-center rounded-circle" style="width: 56px; height: 56px; background: rgba(124,88,204,0.1);">
                    <i class="bi bi-people" style="font-size:1.8rem; color: #7c58cc;"></i>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0 px-4 pb-4 pt-0">
                <a asp-action="Users" class="text-decoration-none fw-semibold" style="font-size: 0.85rem; color: #7c58cc;">
                    Manage Users <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100 border-0 shadow-sm admin-stat-card" style="border-radius: 16px; transition: transform 0.2s ease, box-shadow 0.2s ease;">
            <div class="card-body d-flex justify-content-between align-items-center p-4">
                <div>
                    <h6 class="card-title mb-1 text-muted fw-semibold" style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px;">Total Reviews</h6>
                    <h2 class="mb-0 fw-bold" style="font-family: 'Space Grotesk', sans-serif; color: #111827;">@stats.TotalReviews</h2>
                </div>
                <div class="d-flex align-items-center justify-content-center rounded-circle" style="width: 56px; height: 56px; background: rgba(245,158,11,0.1);">
                    <i class="bi bi-star" style="font-size:1.8rem; color: #f59e0b;"></i>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0 px-4 pb-4 pt-0">
                <a asp-action="Reviews" class="text-decoration-none fw-semibold" style="font-size: 0.85rem; color: #f59e0b;">
                    Manage Reviews <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Recent Orders -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm h-100" style="border-radius: 16px; overflow: hidden;">
            <div class="card-header bg-white border-bottom-0 py-3 px-4">
                <h5 class="mb-0 fw-bold" style="font-family: 'Space Grotesk', sans-serif;"><i class="bi bi-clock-history text-muted me-2"></i> Recent Orders</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="font-size: 0.95rem;">
                        <thead style="background: #f8fafc;">
                            <tr>
                                <th class="text-muted fw-semibold ps-4 border-0 py-3">Order #</th>
                                <th class="text-muted fw-semibold border-0 py-3">Date</th>
                                <th class="text-muted fw-semibold border-0 py-3">Items</th>
                                <th class="text-muted fw-semibold border-0 py-3">Total</th>
                                <th class="text-muted fw-semibold pe-4 border-0 py-3 text-end">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in stats.RecentOrders)
                            {
                                <tr>
                                    <td class="ps-4 fw-medium py-3">#@order.Id</td>
                                    <td class="text-muted py-3">@order.OrderDate.ToString("MMM dd")</td>
                                    <td class="py-3">@order.OrderItems.Count items</td>
                                    <td class="fw-bold py-3" style="color: #10b981;">
                                        $@order.TotalAmount.ToString("0.00")
                                    </td>
                                    <td class="pe-4 text-end py-3">
                                        <span class="badge rounded-pill" style="background: rgba(245,158,11,0.1); color: #d97706; padding: 6px 12px;">
                                            @order.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Low Stock Warning -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100" style="border-radius: 16px; overflow: hidden;">
            <div class="card-header border-bottom-0 py-3 px-4" style="background: rgba(239,68,68,0.05);">
                <h5 class="mb-0 fw-bold" style="font-family: 'Space Grotesk', sans-serif; color: #ef4444;">
                    <i class="bi bi-exclamation-triangle me-2"></i> Low Stock Alert
                </h5>
            </div>
            @if (stats.LowStockProducts.Count == 0)
            {
                <div class="card-body text-center py-5 d-flex flex-column justify-content-center">
                    <div class="d-inline-flex justify-content-center align-items-center rounded-circle mx-auto mb-3" style="width: 64px; height: 64px; background: rgba(16,185,129,0.1);">
                        <i class="bi bi-check-circle-fill" style="font-size: 2rem; color: #10b981;"></i>
                    </div>
                    <p class="fw-medium text-muted mb-0">All products are well stocked!</p>
                </div>
            }
            else
            {
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @foreach (var product in stats.LowStockProducts)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center px-4 py-3 border-0 border-bottom">
                                <span class="fw-medium text-dark">@product.Name</span>
                                <span class="badge rounded-pill" style="background: rgba(239,68,68,0.1); color: #ef4444; padding: 6px 12px;">@product.Stock left</span>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .admin-stat-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 32px rgba(0,0,0,0.05) !important;
    }
</style>