@model ShoppingCartApp.Models.Order
@{
    ViewData["Title"] = "Order Details";
}

<div class="mb-4 mt-2">
    <a asp-action="Orders" class="text-decoration-none fw-medium text-muted mb-2 d-inline-block">
        <i class="bi bi-arrow-left"></i> Back to Orders
    </a>
    <div class="d-flex justify-content-between align-items-center">
        <h2 class="fw-bold mb-0" style="font-family: 'Space Grotesk', sans-serif; letter-spacing: -0.02em;">
            <i class="bi bi-receipt" style="color: #6366f1;"></i> Order #@Model.Id
        </h2>
        @{
            var bgStatus = Model.Status == "Pending" ? "rgba(245,158,11,0.1)" :
                           Model.Status == "Delivered" ? "rgba(16,185,129,0.1)" :
                           Model.Status == "Cancelled" ? "rgba(239,68,68,0.1)" : "rgba(59,130,246,0.1)";
            var textStatus = Model.Status == "Pending" ? "#d97706" :
                             Model.Status == "Delivered" ? "#10b981" :
                             Model.Status == "Cancelled" ? "#ef4444" : "#3b82f6";
        }
        <span class="badge rounded-pill px-3 py-2 fs-6" style="background: @bgStatus; color: @textStatus;">@Model.Status</span>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" style="border-radius: 12px; border: none; border-left: 4px solid #10b981; font-size: 0.95rem;">
        <i class="bi bi-check-circle-fill me-2" style="color: #10b981;"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    <!-- Main Order Details -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-4" style="border-radius: 16px;">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                <h5 class="fw-bold mb-0">Order Items</h5>
            </div>
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table align-middle">
                        <tbody>
                            @foreach (var item in Model.OrderItems)
                            {
                                <tr>
                                    <td style="width: 80px;">
                                        <div class="bg-light rounded-3 p-1">
                                            <img src="@item.Product.ImageUrl" width="60" height="60" class="rounded-2" style="object-fit:cover;" />
                                        </div>
                                    </td>
                                    <td>
                                        <h6 class="fw-bold mb-1">@item.Product.Name</h6>
                                        <span class="text-muted small">Qty: @item.Quantity</span>
                                    </td>
                                    <td class="text-end fw-bold">
                                        $@((item.UnitPrice * item.Quantity).ToString("0.00"))
                                        <br/>
                                        <small class="text-muted fw-normal">$@item.UnitPrice each</small>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="border-top-0">
                            <tr>
                                <td colspan="2" class="text-end fw-bold pt-4 fs-5">Total Amount:</td>
                                <td class="text-end fw-bold text-success pt-4 fs-5">$@Model.TotalAmount.ToString("0.00")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Sidebar Info -->
    <div class="col-lg-4">
        <!-- Customer Info -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius: 16px;">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                <h6 class="fw-bold mb-0 text-muted text-uppercase" style="font-size:0.85rem; letter-spacing:0.5px;">Customer Details</h6>
            </div>
            <div class="card-body p-4">
                <div class="d-flex align-items-center mb-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width:40px; height:40px; background:rgba(99,102,241,0.1); color:#6366f1;">
                        <i class="bi bi-person-fill"></i>
                    </div>
                    <div>
                        <h6 class="mb-0 fw-bold">User Account</h6>
                        <span class="text-muted small">@ViewBag.UserEmail</span>
                    </div>
                </div>
                <hr class="text-muted opacity-25" />
                <h6 class="fw-bold mb-2 fs-6">Shipping Address</h6>
                <p class="text-muted mb-0 small" style="line-height: 1.6;">@Model.ShippingAddress</p>
                
                <hr class="text-muted opacity-25" />
                <h6 class="fw-bold mb-2 fs-6">Order Date</h6>
                <p class="text-muted mb-0 small">@Model.OrderDate.ToString("MMMM dd, yyyy 'at' hh:mm tt")</p>
            </div>
        </div>

        <!-- Update Status -->
        <div class="card border-0 shadow-sm" style="border-radius: 16px;">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                <h6 class="fw-bold mb-0 text-muted text-uppercase" style="font-size:0.85rem; letter-spacing:0.5px;">Update Status</h6>
            </div>
            <div class="card-body p-4">
                <form asp-action="UpdateOrderStatus" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="mb-3">
                        <select name="status" class="form-select form-select-sm border-0 bg-light rounded-3" style="padding: 10px 14px; font-weight: 500;">
                            <option value="Pending" selected="@(Model.Status == "Pending")">Pending</option>
                            <option value="Processing" selected="@(Model.Status == "Processing")">Processing</option>
                            <option value="Shipped" selected="@(Model.Status == "Shipped")">Shipped</option>
                            <option value="Delivered" selected="@(Model.Status == "Delivered")">Delivered</option>
                            <option value="Cancelled" selected="@(Model.Status == "Cancelled")">Cancelled</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 rounded-pill fw-medium shadow-sm" style="background:#6366f1; border-color:#6366f1;">
                        Update Order
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
