@model ShoppingCartApp.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <h2 class="fw-bold mb-4 text-center" style="font-family: 'Space Grotesk', sans-serif;">Reset Password</h2>

        <div class="card border-0 shadow-sm" style="border-radius: 20px;">
            <div class="card-body p-4">
                <form asp-action="ResetPassword" method="post">
                    <input asp-for="Token" type="hidden" />
                    <input asp-for="Email" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label text-muted small fw-semibold text-uppercase"></label>
                        <input asp-for="Password" class="form-control" style="border-radius: 12px; padding: 0.75rem 1rem;" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label text-muted small fw-semibold text-uppercase"></label>
                        <input asp-for="ConfirmPassword" class="form-control" style="border-radius: 12px; padding: 0.75rem 1rem;" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn w-100 rounded-pill text-white fw-bold py-2 shadow-sm" style="background: #10b981;">
                        Reset Password
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
