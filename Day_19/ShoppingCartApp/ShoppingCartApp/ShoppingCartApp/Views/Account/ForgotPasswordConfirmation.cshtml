@{
    ViewData["Title"] = "Forgot password confirmation";
}

<div class="row justify-content-center mt-5 text-center">
    <div class="col-md-6 col-lg-5">
        <div class="d-inline-flex justify-content-center align-items-center rounded-circle mb-4" style="width: 80px; height: 80px; background: rgba(16,185,129,0.1);">
            <i class="bi bi-envelope-check-fill" style="font-size: 2.5rem; color: #10b981;"></i>
        </div>
        <h2 class="fw-bold mb-3" style="font-family: 'Space Grotesk', sans-serif;">Check your email</h2>
        <p class="text-muted mb-4">
            Please check your email to reset your password.
        </p>

        @if (TempData["ResetLink"] != null)
        {
            <div class="alert alert-info py-3 text-start" style="border-radius: 12px; font-size: 0.95rem;">
                <i class="bi bi-info-circle-fill me-2"></i> <strong>Dev Mode Alert:</strong> Email sending is bypassed. 
                <br /><br />
                <a href="@TempData["ResetLink"]" class="btn btn-sm btn-dark rounded-pill">Click here to reset password</a>
            </div>
        }

        <a asp-action="Login" class="btn btn-outline-primary rounded-pill px-4 mt-3">Return to Login</a>
    </div>
</div>
