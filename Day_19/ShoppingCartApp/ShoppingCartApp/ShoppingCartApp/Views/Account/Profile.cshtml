@model ShoppingCartApp.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <h2 class="fw-bold mb-4" style="font-family: 'Space Grotesk', sans-serif;">
            <i class="bi bi-person-badge" style="color: #6366f1;"></i> My Profile
        </h2>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert" style="border-radius: 12px; border-left: 4px solid #10b981;">
                <i class="bi bi-check-circle-fill me-2" style="color: #10b981;"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="card border-0 shadow-sm" style="border-radius: 20px;">
            <div class="card-body p-4">
                <form asp-action="Profile" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label text-muted small fw-semibold text-uppercase"></label>
                        <input asp-for="Email" class="form-control" style="border-radius: 12px; background: #f3f4f6;" readonly />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label text-muted small fw-semibold text-uppercase"></label>
                        <input asp-for="FullName" class="form-control" style="border-radius: 12px;" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Address" class="form-label text-muted small fw-semibold text-uppercase">Default Shipping Address</label>
                        <textarea asp-for="Address" class="form-control" rows="3" style="border-radius: 12px;"></textarea>
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn w-100 rounded-pill text-white fw-bold py-2 shadow-sm" style="background: #6366f1;">
                        Save Changes
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
