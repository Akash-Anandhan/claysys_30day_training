@model ShoppingCartApp.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot your password?";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <h2 class="fw-bold mb-3 text-center" style="font-family: 'Space Grotesk', sans-serif;">Forgot Password?</h2>
        <p class="text-muted text-center mb-4">Enter your email address and we'll send you a link to reset your password.</p>

        <div class="card border-0 shadow-sm" style="border-radius: 20px;">
            <div class="card-body p-4">
                <form asp-action="ForgotPassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label text-muted small fw-semibold text-uppercase"></label>
                        <input asp-for="Email" class="form-control" style="border-radius: 12px; padding: 0.75rem 1rem;" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn w-100 rounded-pill text-white fw-bold py-2 shadow-sm" style="background: #3b82f6;">
                        Send Reset Link
                    </button>
                    <div class="text-center mt-3">
                        <a asp-action="Login" class="text-decoration-none small text-muted">Back to Login</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
