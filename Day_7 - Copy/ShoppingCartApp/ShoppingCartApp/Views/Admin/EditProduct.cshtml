@model ShoppingCartApp.ViewModels.ProductViewModel
@{
    ViewData["Title"] = "Edit Product";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-2">
    <h2 class="fw-bold mb-0" style="font-family: 'Space Grotesk', sans-serif; letter-spacing: -0.02em;">
        <i class="bi bi-pencil" style="color: #3b82f6;"></i> Edit Product
    </h2>
    <a asp-action="Products" class="btn rounded-pill px-4 fw-semibold" style="background: #f3f4f6; color: #4b5563; border: 1px solid #e5e7eb; transition: background 0.2s ease;" onmouseover="this.style.background='#e5e7eb'" onmouseout="this.style.background='#f3f4f6'">
        <i class="bi bi-arrow-left me-1"></i> Products
    </a>
</div>

<div class="row pb-5">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm" style="border-radius: 20px; overflow: hidden;">
            <div class="card-body p-4 p-md-5">
                <form asp-action="EditProduct" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="border-radius: 12px; display: none;"></div>

                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label fw-semibold" style="font-size: 0.9rem; color: #374151;"></label>
                            <input asp-for="Name" class="form-control" style="border-radius: 12px; padding: 0.75rem 1rem; border: 1px solid #e5e7eb;" />
                            <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CategoryId" class="form-label fw-semibold" style="font-size: 0.9rem; color: #374151;"></label>
                            <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select" style="border-radius: 12px; padding: 0.75rem 1rem; border: 1px solid #e5e7eb;">
                                <option value="">-- Select Category --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-semibold" style="font-size: 0.9rem; color: #374151;"></label>
                        <textarea asp-for="Description" class="form-control" rows="4" style="border-radius: 12px; padding: 0.75rem 1rem; border: 1px solid #e5e7eb;"></textarea>
                        <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="row g-4 mb-5">
                        <div class="col-md-4">
                            <label asp-for="BasePrice" class="form-label fw-semibold" style="font-size: 0.9rem; color: #374151;"></label>
                            <div class="input-group">
                                <span class="input-group-text" style="border-radius: 12px 0 0 12px; background: #f8fafc; border: 1px solid #e5e7eb; font-weight: 600; color: #6b7280;">₹</span>
                                <input asp-for="BasePrice" class="form-control" style="border-radius: 0 12px 12px 0; padding: 0.75rem 1rem; border: 1px solid #e5e7eb; border-left: none;" />
                            </div>
                            <span asp-validation-for="BasePrice" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="SellingPrice" class="form-label fw-semibold" style="font-size: 0.9rem; color: #374151;"></label>
                            <div class="input-group">
                                <span class="input-group-text" style="border-radius: 12px 0 0 12px; background: #f8fafc; border: 1px solid #e5e7eb; font-weight: 600; color: #6b7280;">₹</span>
                                <input asp-for="SellingPrice" class="form-control" style="border-radius: 0 12px 12px 0; padding: 0.75rem 1rem; border: 1px solid #e5e7eb; border-left: none;" />
                            </div>
                            <span asp-validation-for="SellingPrice" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Stock" class="form-label fw-semibold" style="font-size: 0.9rem; color: #374151;"></label>
                            <input asp-for="Stock" class="form-control" style="border-radius: 12px; padding: 0.75rem 1rem; border: 1px solid #e5e7eb;" />
                            <span asp-validation-for="Stock" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <!-- Image Section -->
                    <div class="card bg-light border-0 mb-4" style="border-radius: 16px;">
                        <div class="card-body p-4">
                            <h6 class="fw-bold mb-4" style="font-family: 'Space Grotesk', sans-serif; color: #111827;">
                                <i class="bi bi-image" style="color: #3b82f6;"></i> Product Image
                            </h6>

                            <!-- Current Image -->
                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <div class="mb-4 text-center">
                                    <label class="form-label fw-semibold text-muted small text-uppercase d-block" style="letter-spacing: 0.5px;">Current Image</label>
                                    <img src="@Model.ImageUrl" alt="Current" class="img-fluid rounded-3 shadow-sm border" style="max-height:160px; object-fit:cover;" />
                                </div>
                            }

                            <div class="mb-4">
                                <label asp-for="ImageFile" class="form-label fw-semibold text-muted small text-uppercase" style="letter-spacing: 0.5px;">Option 1 — Upload New File</label>
                                <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" onchange="previewImage(this)" style="border-radius: 12px; padding: 0.75rem 1rem; border: 1px dashed #cbd5e1; background: #fff;" />
                                <small class="text-muted mt-2 d-block">Leave empty to keep the current image.</small>
                            </div>

                            <div class="d-flex align-items-center mb-4">
                                <div class="flex-grow-1 border-top" style="border-color: #cbd5e1 !important;"></div>
                                <span class="mx-3 text-muted small fw-bold">OR</span>
                                <div class="flex-grow-1 border-top" style="border-color: #cbd5e1 !important;"></div>
                            </div>

                            <div class="mb-4">
                                <label asp-for="ImageUrl" class="form-label fw-semibold text-muted small text-uppercase" style="letter-spacing: 0.5px;">Option 2 — Image URL</label>
                                <input asp-for="ImageUrl" class="form-control" placeholder="https://example.com/image.jpg" oninput="previewUrl(this.value)" style="border-radius: 12px; padding: 0.75rem 1rem; border: 1px solid #cbd5e1; background: #fff;" />
                            </div>

                            <!-- Preview -->
                            <div id="image-preview-container" class="mt-4" style="display:none;">
                                <label class="form-label fw-semibold text-muted small text-uppercase" style="letter-spacing: 0.5px;">New Image Preview</label>
                                <div>
                                    <img id="image-preview" src="" alt="Preview" class="img-fluid rounded-3 shadow-sm border" style="max-height:220px; object-fit:cover;" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn w-100 text-white rounded-3 py-3 mt-2" style="background:#3b82f6; font-weight:600; box-shadow:0 8px 24px rgba(59,130,246,0.25); border:none; transition: all 0.2s ease;" onmouseover="this.style.transform='translateY(-2px)';" onmouseout="this.style.transform='translateY(0)';">
                        Save Changes <i class="bi bi-save ms-1"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .form-control:focus, .form-select:focus {
        border-color: #3b82f6 !important;
        box-shadow: 0 0 0 4px rgba(59,130,246,0.1) !important;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => {
                    document.getElementById('image-preview').src = e.target.result;
                    document.getElementById('image-preview-container').style.display = 'block';
                    document.querySelector('[name="ImageUrl"]').value = '';
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function previewUrl(url) {
            if (url.length > 5) {
                document.getElementById('image-preview').src = url;
                document.getElementById('image-preview-container').style.display = 'block';
                document.querySelector('[name="ImageFile"]').value = '';
            } else {
                document.getElementById('image-preview-container').style.display = 'none';
            }
        }
    </script>
}