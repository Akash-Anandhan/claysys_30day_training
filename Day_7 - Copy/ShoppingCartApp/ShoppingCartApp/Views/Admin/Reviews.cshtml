@model ShoppingCartApp.DTOs.Admin.AdminReviewsResultDto
@{
    ViewData["Title"] = "Manage Reviews";
    var searchQuery = ViewBag.SearchQuery as string;
    var minRating = ViewBag.MinRating as int?;
    var sortBy = ViewBag.SortBy as string;
    var currentPage = Model?.CurrentPage ?? 1;
    var totalPages = Model?.TotalPages ?? 1;
    var totalCount = Model?.TotalCount ?? 0;
    var hasFilters = !string.IsNullOrEmpty(searchQuery) || minRating.HasValue || !string.IsNullOrEmpty(sortBy);
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-2">
    <h2 class="fw-bold mb-0" style="font-family: 'Space Grotesk', sans-serif; letter-spacing: -0.02em;">
        <i class="bi bi-star" style="color: #f59e0b;"></i> Manage Reviews
    </h2>
    <a asp-action="Index" class="btn rounded-pill px-4 fw-semibold" style="background: #f3f4f6; color: #4b5563; border: 1px solid #e5e7eb; transition: background 0.2s ease;" onmouseover="this.style.background='#e5e7eb'" onmouseout="this.style.background='#f3f4f6'">
        <i class="bi bi-arrow-left me-1"></i> Dashboard
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" style="border-radius: 12px; border: none; border-left: 4px solid #10b981; font-size: 0.95rem;">
        <i class="bi bi-check-circle-fill me-2" style="color: #10b981;"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Search and Filter Section -->
<div class="card border-0 shadow-sm mb-4" style="border-radius: 16px;">
    <div class="card-body">
        <form asp-action="Reviews" method="get" id="search-filter-form">
            <div class="row g-3 align-items-end">
                <div class="col-lg-5">
                    <label class="form-label fw-semibold text-muted small" style="letter-spacing: 0.5px;">Search</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0" style="border-radius: 12px 0 0 12px;">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" name="searchQuery" value="@searchQuery" class="form-control border-start-0 ps-0" style="border-radius: 0 12px 12px 0;" placeholder="Search by product, user, or comment..." />
                    </div>
                </div>
                <div class="col-lg-3">
                    <label class="form-label fw-semibold text-muted small" style="letter-spacing: 0.5px;">Min Rating</label>
                    <select name="minRating" class="form-select" style="border-radius: 12px;">
                        <option value="" selected="@(minRating == null)">All Ratings</option>
                        <option value="1" selected="@(minRating == 1)">1+ Stars</option>
                        <option value="2" selected="@(minRating == 2)">2+ Stars</option>
                        <option value="3" selected="@(minRating == 3)">3+ Stars</option>
                        <option value="4" selected="@(minRating == 4)">4+ Stars</option>
                        <option value="5" selected="@(minRating == 5)">5 Stars Only</option>
                    </select>
                </div>
                <div class="col-lg-2">
                    <label class="form-label fw-semibold text-muted small" style="letter-spacing: 0.5px;">Sort By</label>
                    <select name="sortBy" class="form-select" style="border-radius: 12px;">
                        <option value="newest" selected="@(string.IsNullOrEmpty(sortBy) || sortBy == "newest")">Newest First</option>
                        <option value="oldest" selected="@(sortBy == "oldest")">Oldest First</option>
                        <option value="rating_high" selected="@(sortBy == "rating_high")">Rating: High to Low</option>
                        <option value="rating_low" selected="@(sortBy == "rating_low")">Rating: Low to High</option>
                    </select>
                </div>
                <div class="col-lg-2">
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn text-white fw-semibold flex-fill" style="background: #e85d2a; border: none; border-radius: 12px;">
                            <i class="bi bi-funnel-fill me-1"></i> Filter
                        </button>
                        @if (hasFilters)
                        {
                            <a asp-action="Reviews" class="btn btn-outline-secondary fw-semibold" style="border-radius: 12px;" title="Clear all filters">
                                <i class="bi bi-x-lg"></i>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Results Summary -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        @if (hasFilters)
        {
            <span class="text-muted">
                Showing <strong class="text-dark">@Model?.Reviews.Count()</strong> of <strong class="text-dark">@totalCount</strong> reviews
            </span>
        }
        else
        {
            <span class="text-muted">Total <strong class="text-dark">@totalCount</strong> reviews</span>
        }
    </div>
</div>

@if (Model?.Reviews == null || !Model.Reviews.Any())
{
    <div class="text-center py-5 my-5 rounded-4 shadow-sm" style="background: rgba(248, 250, 252, 0.8); border: 1px dashed #cbd5e1;">
        <div class="d-inline-flex justify-content-center align-items-center rounded-circle mb-3 bg-white shadow-sm text-muted" style="width: 100px; height: 100px; font-size: 3rem;">
            <i class="bi bi-inbox"></i>
        </div>
        <h3 class="fw-bold text-dark mt-2" style="font-family: 'Space Grotesk', sans-serif;">No reviews found</h3>
        <p class="text-muted mb-4 fs-5">
            @if (hasFilters)
            {
                <text>Try adjusting your search or filter criteria.</text>
            }
            else
            {
                <text>No reviews have been submitted yet.</text>
            }
        </p>
        @if (hasFilters)
        {
            <a asp-action="Reviews" class="btn btn-dark btn-lg rounded-pill px-5 fw-bold shadow-sm">
                Clear Filters
            </a>
        }
    </div>
}
else
{
<div class="card border-0 shadow-sm mb-4" style="border-radius: 16px; overflow: hidden;">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.95rem;">
                <thead style="background: #f8fafc;">
                    <tr>
                        <th class="border-0 text-muted fw-semibold ps-4 py-3">Product</th>
                        <th class="border-0 text-muted fw-semibold py-3">User</th>
                        <th class="border-0 text-muted fw-semibold py-3">Rating</th>
                        <th class="border-0 text-muted fw-semibold py-3">Comment</th>
                        <th class="border-0 text-muted fw-semibold py-3">Date</th>
                        <th class="border-0 text-muted fw-semibold pe-4 py-3 text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var review in Model.Reviews)
                    {
                        <tr>
                            <td class="ps-4 fw-bold py-3" style="color: #111827;">
                                @review.Product?.Name
                            </td>
                            <td class="py-3">
                                <span class="fw-semibold" style="color: #374151;">@review.User?.FullName</span>
                                <br />
                                <small class="text-muted">@review.User?.Email</small>
                            </td>
                            <td class="py-3">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="bi @(i <= review.Rating ? "bi-star-fill text-warning" : "bi-star text-muted")" style="font-size:14px; opacity: @(i <= review.Rating ? "1" : "0.3");"></i>
                                }
                            </td>
                            <td class="py-3" style="max-width:280px;">
                                <span class="text-truncate d-block text-muted" title="@review.Comment">@review.Comment</span>
                            </td>
                            <td class="text-muted small fw-medium py-3">
                                @review.CreatedAt.ToString("MMM dd, yyyy")
                            </td>
                            <td class="pe-4 py-3 text-end">
                                <form asp-action="DeleteReview" method="post" onsubmit="return confirm('Delete this review?')">
                                    <input type="hidden" name="id" value="@review.Id" />
                                    <button type="submit" class="btn btn-sm rounded-circle d-flex align-items-center justify-content-center ms-auto" style="width: 34px; height: 34px; background: rgba(239,68,68,0.1); color: #ef4444; border: none; transition: all 0.2s ease;" onmouseover="this.style.background='#ef4444'; this.style.color='#fff';" onmouseout="this.style.background='rgba(239,68,68,0.1)'; this.style.color='#ef4444';">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Pagination -->
@if (totalPages > 1)
{
    <nav aria-label="Reviews pagination" class="d-flex justify-content-center">
        <ul class="pagination pagination-rounded mb-0">
            @{ var prevDisabled = currentPage == 1 ? "disabled" : ""; var nextDisabled = currentPage == totalPages ? "disabled" : ""; }
            <li class="page-item @prevDisabled">
                <a class="page-link" href="?page=@(currentPage - 1)&searchQuery=@searchQuery&minRating=@minRating&sortBy=@sortBy" aria-label="Previous">
                    <i class="bi bi-chevron-left"></i>
                </a>
            </li>
            @{ int startPage = Math.Max(1, currentPage - 2); int endPage = Math.Min(totalPages, currentPage + 2); }
            @if (startPage > 1) { <li class="page-item"><a class="page-link" href="?page=1&searchQuery=@searchQuery&minRating=@minRating&sortBy=@sortBy">1</a></li> }
            @if (startPage > 2) { <li class="page-item disabled"><span class="page-link">...</span></li> }
            @for (int i = startPage; i <= endPage; i++)
            {
                var active = i == currentPage ? "active" : "";
                <li class="page-item @active"><a class="page-link" href="?page=@i&searchQuery=@searchQuery&minRating=@minRating&sortBy=@sortBy">@i</a></li>
            }
            @if (endPage < totalPages) { if (endPage < totalPages - 1) { <li class="page-item disabled"><span class="page-link">...</span></li> } <li class="page-item"><a class="page-link" href="?page=@totalPages&searchQuery=@searchQuery&minRating=@minRating&sortBy=@sortBy">@totalPages</a></li> }
            <li class="page-item @nextDisabled">
                <a class="page-link" href="?page=@(currentPage + 1)&searchQuery=@searchQuery&minRating=@minRating&sortBy=@sortBy" aria-label="Next">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
}
}

<style>
    .form-control:focus, .form-select:focus { border-color: #e85d2a !important; box-shadow: 0 0 0 4px rgba(232,93,42,0.1) !important; }
    .pagination-rounded .page-link { border-radius: 50%; margin: 0 3px; }
    .pagination-rounded .page-item.active .page-link { background-color: #e85d2a; border-color: #e85d2a; }
    .pagination-rounded .page-item.disabled .page-link { opacity: 0.5; }
</style>