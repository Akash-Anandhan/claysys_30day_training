@model ShoppingCartApp.DTOs.Order.CheckoutPageDto
@{
    ViewData["Title"] = "Checkout";
    var total = Model.Items.Sum(c => c.Subtotal);
}

<div class="d-flex align-items-center mb-5 mt-2">
    <h2 class="fw-bold mb-0" style="font-family: 'Space Grotesk', sans-serif; letter-spacing: -0.02em;">
        <i class="bi bi-credit-card text-primary me-2"></i> Checkout
    </h2>
</div>

<div class="row g-5 pb-5">
    <!-- Form Side -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm" style="border-radius: 20px; overflow: hidden; background: #fff;">
            <div class="card-header border-bottom-0 py-4 px-5" style="background: rgba(59,130,246,0.05);">
                <h5 class="mb-0 fw-bold d-flex align-items-center" style="font-family: 'Space Grotesk', sans-serif; color: #3b82f6;">
                    <div class="rounded-circle d-flex align-items-center justify-content-center text-white me-3" style="width: 28px; height: 28px; background: #3b82f6; font-size: 0.9rem;">1</div>
                    Shipping Information
                </h5>
            </div>
            <div class="card-body p-5">
                <form asp-action="PlaceOrder" method="post">
                    <div class="row g-4 mb-4">
                        <div class="col-12">
                            <label class="form-label fw-semibold text-muted small text-uppercase" style="letter-spacing: 0.5px;">Full Name</label>
                            <input type="text" class="form-control" value="@Model.UserFullName" placeholder="Jane Doe" style="border-radius: 12px; padding: 0.75rem 1rem; border: 1px solid #e5e7eb;" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold text-muted small text-uppercase" style="letter-spacing: 0.5px;">Shipping Address</label>
                            <textarea name="shippingAddress" class="form-control" rows="3" placeholder="123 Main St, City, Country" style="border-radius: 12px; padding: 0.75rem 1rem; border: 1px solid #e5e7eb;" required>@Model.UserAddress</textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold text-muted small text-uppercase" style="letter-spacing: 0.5px;">Phone Number (Optional)</label>
                            <input type="tel" class="form-control" placeholder="+1 234 567 8900" style="border-radius: 12px; padding: 0.75rem 1rem; border: 1px solid #e5e7eb;" />
                        </div>
                    </div>

                    <h5 class="mb-4 mt-5 fw-bold d-flex align-items-center" style="font-family: 'Space Grotesk', sans-serif; color: #10b981;">
                        <div class="rounded-circle d-flex align-items-center justify-content-center text-white me-3" style="width: 28px; height: 28px; background: #10b981; font-size: 0.9rem;">2</div>
                        Payment Details
                    </h5>
                    
                    <div class="col-12 mb-4">
                        <label class="form-label fw-semibold text-muted small text-uppercase" style="letter-spacing: 0.5px;">Select Payment Method</label>
                        <select name="paymentMethod" class="form-select" style="border-radius: 12px; padding: 0.75rem 1rem; border: 1px solid #e5e7eb;" required>
                            <option value="Credit Card" selected>Credit Card / Debit Card</option>
                            <option value="PayPal">PayPal</option>
                            <option value="Bank Transfer">Bank Transfer</option>
                            <option value="Cash on Delivery">Cash on Delivery (COD)</option>
                        </select>
                    </div>
                    
                    <div class="bg-light p-4 mb-5" style="border-radius: 16px;">
                        <div class="row g-4">
                            <div class="col-12">
                                <label class="form-label fw-semibold text-muted small text-uppercase" style="letter-spacing: 0.5px;">Card Number</label>
                                <div class="input-group">
                                    <span class="input-group-text border-0 text-muted" style="background: #fff; border-radius: 12px 0 0 12px;"><i class="bi bi-credit-card-2-front"></i></span>
                                    <input type="text" class="form-control border-0" placeholder="0000 0000 0000 0000" style="border-radius: 0 12px 12px 0; padding: 0.75rem 1rem;" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-muted small text-uppercase" style="letter-spacing: 0.5px;">Expiry Date</label>
                                <input type="text" class="form-control border-0" placeholder="MM/YY" style="border-radius: 12px; padding: 0.75rem 1rem;" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-muted small text-uppercase" style="letter-spacing: 0.5px;">CVV</label>
                                <input type="text" class="form-control border-0" placeholder="123" style="border-radius: 12px; padding: 0.75rem 1rem;" />
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn w-100 rounded-pill text-white fw-bold py-3 shadow-sm d-flex justify-content-center align-items-center gap-2" style="background: #10b981; border: none; font-size: 1.1rem; transition: transform 0.2s ease;" onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='translateY(0)'">
                        <i class="bi bi-lock-fill"></i> Pay ₹@total.ToString("0.00") Securely
                    </button>
                    <p class="text-center text-muted small mt-3 fw-medium">
                        <i class="bi bi-shield-check text-success me-1"></i> Your payment is secured by industry standard encryption.
                    </p>
                </form>
            </div>
        </div>
    </div>

    <!-- Order Summary Side -->
    <div class="col-lg-5">
        <div class="position-sticky" style="top: 100px;">
            <div class="card shadow-sm border-0" style="border-radius: 20px; overflow: hidden;">
                <div class="card-header bg-white border-bottom-0 py-4 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold" style="font-family: 'Space Grotesk', sans-serif;">Order Summary</h5>
                    <span class="badge rounded-pill bg-light text-dark border px-3">@Model.Items.Count() Items</span>
                </div>
                <div class="card-body p-0">
                    <div class="px-4 py-2" style="max-height: 350px; overflow-y: auto;">
                        <ul class="list-group list-group-flush border-top-0">
                            @foreach (var item in Model.Items)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-0 border-0 border-bottom">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="position-relative">
                                            <img src="@item.ImageUrl" width="56" height="56" class="rounded-3 shadow-sm border" style="object-fit:cover;" />
                                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-dark" style="font-size: 0.75rem;">
                                                @item.Quantity
                                                <span class="visually-hidden">quantity</span>
                                            </span>
                                        </div>
                                        <div>
                                            <div class="fw-bold" style="color: #111827;">@item.ProductName</div>
                                            <small class="text-muted">Unit: ₹@item.UnitPrice.ToString("0.00")</small>
                                        </div>
                                    </div>
                                    <span class="fw-bold fs-6" style="color: #111827;">₹@item.Subtotal.ToString("0.00")</span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
                <div class="card-footer px-4 py-4 border-0" style="background: linear-gradient(180deg, rgba(248,250,252,0), #f8fafc);">
                    <div class="d-flex justify-content-between mb-2 text-muted fw-medium">
                        <span>Subtotal</span>
                        <span>₹@total.ToString("0.00")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 text-muted fw-medium">
                        <span>Shipping</span>
                        <span class="badge rounded-pill" style="background: rgba(16,185,129,0.1); color: #10b981;">Free</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <span class="fs-5 fw-bold" style="color: #111827;">Total to Pay</span>
                        <span class="fw-bold" style="color: #10b981; font-size: 2rem; font-family: 'Space Grotesk', sans-serif;">₹@total.ToString("0.00")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .form-control:focus {
        border-color: #3b82f6 !important;
        box-shadow: 0 0 0 4px rgba(59,130,246,0.1) !important;
    }
</style>