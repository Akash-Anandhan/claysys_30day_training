@model IEnumerable<ShoppingCartApp.DTOs.Wishlist.WishlistItemDto>
@{
    ViewData["Title"] = "My Wishlist";
}

<h2 class="mb-4"><i class="bi bi-heart"></i> My Wishlist</h2>

@if (!Model.Any())
{
        <div class="text-center py-5">
            <i class="bi bi-heart" style="font-size:4rem; color:#ccc;"></i>
            <h4 class="mt-3 text-muted">Your wishlist is empty</h4>
            <a asp-controller="Product" asp-action="Index" class="btn btn-dark mt-3">
                <i class="bi bi-arrow-left"></i> Browse Products
            </a>
        </div>
}
else
{
        <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var item in Model)
        {
                    <div class="col">
                        <div class="card h-100 shadow-sm">
                            <img src="@item.ImageUrl"
                                 class="card-img-top"
                                 alt="@item.ProductName"
                                 style="height:200px; object-fit:cover;" />
                            <div class="card-body">
                                <span class="badge bg-secondary mb-2">
                            @item.CategoryName
                                </span>
                                <h5 class="card-title">@item.ProductName</h5>
                                <p class="card-text text-muted small"></p>
                                <p class="fw-bold text-success fs-5">
                                    ₹@item.Price.ToString("0.00")
                                </p>
                                <p class="text-muted small">
                                    <i class="bi bi-clock"></i>
                                    Added on @item.AddedOn.ToString("MMM dd, yyyy")
                                </p>
                            </div>
                            <div class="card-footer d-flex flex-column gap-2">

                                <!-- Move to Cart -->
                                <form asp-action="MoveToCart" method="post">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-dark w-100">
                                        <i class="bi bi-cart-plus"></i> Move to Cart
                                    </button>
                                </form>

                                <!-- View Product -->
                                <a asp-controller="Product"
                                   asp-action="Details"
                                   asp-route-id="@item.ProductId"
                                   class="btn btn-outline-dark w-100">
                                    <i class="bi bi-eye"></i> View Product
                                </a>

                                <!-- Remove from Wishlist -->
                                <form asp-action="Remove" method="post" class="remove-wishlist-form">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-outline-danger w-100">
                                        <i class="bi bi-trash"></i> Remove
                                    </button>
                                </form>

                            </div>
                        </div>
                    </div>
        }
        </div>

        <div class="mt-4">
            <a asp-controller="Product" asp-action="Index" class="btn btn-outline-dark">
                <i class="bi bi-arrow-left"></i> Continue Shopping
            </a>
        </div>
}