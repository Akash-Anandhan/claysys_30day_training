@model IEnumerable<ShoppingCartApp.Models.Order>

@{
    ViewData["Title"] = "My Orders";
}

<div class="d-flex align-items-center mb-4 mt-2 border-bottom pb-3">
    <h2 class="fw-bold mb-0" style="font-family: 'Space Grotesk', sans-serif; letter-spacing: -0.02em; color: #111827;">
        <i class="bi bi-box-seam text-brand me-2"></i> My Orders
    </h2>
</div>

<div class="row g-4 pb-5">
    @if (!Model.Any())
    {
        <div class="col-12 text-center py-5">
            <div class="p-5 bg-light rounded-4">
                <i class="bi bi-basket-fill text-muted" style="font-size: 3rem;"></i>
                <h4 class="mt-3 fw-bold text-gray-700">No orders yet</h4>
                <p class="text-muted mb-4">Looks like you haven't placed any orders yet.</p>
                <a asp-controller="Product" asp-action="Index" class="btn btn-brand text-white fw-bold px-4 py-2 rounded-pill">Start Shopping</a>
            </div>
        </div>
    }
    else
    {
        @foreach (var order in Model)
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-2">
                    <div class="card-header bg-light border-bottom-0 py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <span class="text-muted text-uppercase small fw-semibold d-block">Order #@order.Id</span>
                            <span class="fw-bold text-gray-800">Placed on @order.OrderDate.ToString("MMM dd, yyyy")</span>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <h5 class="mb-0 fw-bold text-brand">₹@order.TotalAmount.ToString("N0")</h5>
                            <span class="badge rounded-pill
                                @(order.Status == "Completed" ? "bg-success" : 
                                  order.Status == "Pending" ? "bg-warning text-dark" : 
                                  order.Status == "Cancelled" ? "bg-danger" : "bg-primary")" style="font-size: 0.85rem; padding: 0.5em 1em;">
                                @order.Status
                            </span>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <ul class="list-group list-group-flush">
                            @foreach (var item in order.OrderItems)
                            {
                                <li class="list-group-item d-flex align-items-center p-4">
                                    <img src="@item.Product.ImageUrl" width="60" height="60" class="rounded-3 shadow-sm border me-3" style="object-fit: cover;" alt="@item.Product.Name" loading="lazy" />
                                    <div class="flex-grow-1">
                                        <h6 class="fw-bold mb-1"><a asp-controller="Product" asp-action="Details" asp-route-id="@item.ProductId" class="text-dark text-decoration-none">@item.Product.Name</a></h6>
                                        <p class="mb-0 text-muted small">Qty: @item.Quantity &times; ₹@item.SellingPrice.ToString("N0")</p>
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                    @if (order.Status == "Pending")
                    {
                        <div class="card-footer bg-white border-top py-3 px-4 d-flex justify-content-end">
                            <form asp-action="CancelOrder" method="post" onsubmit="return confirm('Are you sure you want to cancel this order?');">
                                <input type="hidden" name="id" value="@order.Id" />
                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-bold">Cancel Order</button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>
