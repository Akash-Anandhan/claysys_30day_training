@model ShoppingCartApp.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Home";
}

<!-- Hero Carousel Section - Always light text regardless of theme -->
<section class="position-relative overflow-hidden mb-5" style="border-radius: 24px;">
    <div id="heroCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="5000">
        <div class="carousel-inner">
            <div class="carousel-item active">
                <div style="height: 450px; background: linear-gradient(135deg, rgba(232,93,42,0.85), rgba(124,88,204,0.9)), url('https://images.unsplash.com/photo-1607082348824-0a96f2a4b9da') center/cover;">
                    <div class="container h-100 d-flex align-items-center">
                        <div class="hero-content px-4 py-3" style="color: #ffffff !important; max-width: 550px;">
                            <span class="badge rounded-pill mb-3 px-3 py-2" style="background: rgba(255,255,255,0.2); color: #ffffff !important;">TRENDING NOW</span>
                            <h1 class="display-4 fw-bold mb-3" style="color: #ffffff !important;">Summer Collection 2026</h1>
                            <p class="fs-5 mb-4" style="color: rgba(255,255,255,0.85) !important;">Discover amazing products at unbeatable prices.</p>
                            <a class="btn btn-warning btn-lg rounded-pill px-5 py-3" style="background: #fbbf24 !important; color: #111827 !important; border: none;" asp-controller="Product" asp-action="Index" asp-route-sortBy="newest">Shop Now</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="carousel-item">
                <div style="height: 450px; background: linear-gradient(135deg, rgba(16,185,129,0.85), rgba(59,130,246,0.9)), url('https://images.unsplash.com/photo-1556742049-0cfed4f6a45d') center/cover;">
                    <div class="container h-100 d-flex align-items-center">
                        <div class="hero-content px-4 py-3" style="color: #ffffff !important; max-width: 550px;">
                            <span class="badge rounded-pill mb-3 px-3 py-2" style="background: rgba(255,255,255,0.2); color: #ffffff !important;">MEGA SALE</span>
                            <h1 class="display-4 fw-bold mb-3" style="color: #ffffff !important;">Up to 50% Off</h1>
                            <p class="fs-5 mb-4" style="color: rgba(255,255,255,0.85) !important;">Limited time offer!</p>
                            <a class="btn btn-light btn-lg rounded-pill px-5 py-3" style="background: #ffffff !important; color: #111827 !important; border: none;" asp-controller="Product" asp-action="Index" asp-route-sortBy="price_asc">Explore Deals</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="carousel-item">
                <div style="height: 450px; background: linear-gradient(135deg, rgba(239,68,68,0.85), rgba(245,158,11,0.9)), url('https://images.unsplash.com/photo-1483985988355-763728e1935b') center/cover;">
                    <div class="container h-100 d-flex align-items-center">
                        <div class="hero-content px-4 py-3" style="color: #ffffff !important; max-width: 550px;">
                            <span class="badge rounded-pill mb-3 px-3 py-2" style="background: rgba(255,255,255,0.2); color: #ffffff !important;">NEW ARRIVALS</span>
                            <h1 class="display-4 fw-bold mb-3" style="color: #ffffff !important;">Fashion Forward</h1>
                            <p class="fs-5 mb-4" style="color: rgba(255,255,255,0.85) !important;">Fresh styles for every occasion.</p>
                            <a class="btn btn-dark btn-lg rounded-pill px-5 py-3" style="background: #ffffff !important; color: #111827 !important; border: none;" asp-controller="Product" asp-action="Index" asp-route-sortBy="newest">View Collection</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Carousel Navigation Arrows - Outside content, positioned on sides -->
        <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev" style="width: 50px; height: 50px; top: 50%; transform: translateY(-50%); left: 16px; background: rgba(255,255,255,0.15); border: none; border-radius: 50%; backdrop-filter: blur(4px); z-index: 10;">
            <span class="carousel-control-prev-icon"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next" style="width: 50px; height: 50px; top: 50%; transform: translateY(-50%); right: 16px; background: rgba(255,255,255,0.15); border: none; border-radius: 50%; backdrop-filter: blur(4px); z-index: 10;">
            <span class="carousel-control-next-icon"></span>
        </button>
    </div>
</section>

<!-- Best Sellers Section -->
@if (Model.BestSellers != null && Model.BestSellers.Any())
{
    <section class="mb-5" id="bestSellersSection">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-bold mb-0"><i class="bi bi-award" style="color:#fbbf24;"></i> Best Sellers</h3>
            <a asp-controller="Product" asp-action="Index" class="btn btn-outline-dark rounded-pill btn-sm">View All <i class="bi bi-arrow-right ms-1"></i></a>
        </div>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
        @foreach (var p in Model.BestSellers)
        {
            var rating = p.Reviews?.Any() == true ? p.Reviews.Average(r => r.Rating) : 0;
            <div class="col product-card-wrapper" data-category-id="@p.CategoryId">
                <div class="card h-100 border-0 shadow-sm product-card" style="border-radius: 20px; transition: transform 0.3s, box-shadow 0.3s;">
                    <button class="btn btn-light rounded-circle position-absolute wishlist-btn" style="top: 16px; right: 16px; z-index: 10;" onclick="addToWishlist(event, @p.Id)" data-id="@p.Id">
                        <i class="bi bi-heart"></i>
                    </button>
                    <span class="position-absolute top-0 start-0 m-3 badge rounded-pill" style="background: #fbbf24; color: #111;">Bestseller</span>
                    <div class="position-relative" style="border-radius: 20px 20px 0 0;">
                        <img src="@p.ImageUrl" class="card-img-top p-3" style="height: 180px; object-fit: contain;" alt="@p.Name" onerror="this.src='https://commercial.bunn.com/img/image-not-available.png'" />
                    </div>
                    <div class="card-body">
                        <span class="badge" style="background: rgba(232,93,42,0.1); color: #e85d2a;">@p.Category?.Name</span>
                        <h5 class="fw-bold mt-2">@p.Name</h5>
                        <div class="d-flex align-items-center mb-2">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <i class="@(i <= rating ? "bi-star-fill" : "bi-star")" style="color: #fbbf24; font-size: 0.9rem;"></i>
                            }
                            <span class="text-muted small ms-1">(@rating.ToString("0.0"))</span>
                        </div>
                        <span class="fw-bold fs-5" style="color: #e85d2a;">Rs. @p.SellingPrice.ToString("0.00")</span>
                    </div>
                    <div class="card-footer bg-transparent border-0 px-4 pb-4 d-flex gap-2">
                        <a asp-controller="Product" asp-action="Details" asp-route-id="@p.Id" class="btn rounded-pill flex-fill" style="background: #f3f4f6;">
                            <i class="bi bi-eye"></i> View
                        </a>
                        <button type="button" class="btn w-100 rounded-pill text-white" style="background: #111827;" onclick="addToCartAjax(event, @p.Id, 1)">
                            <i class="bi bi-cart-plus"></i> Add
                        </button>
                    </div>
                </div>
            </div>
        }
        </div>
    </section>
}

<!-- Promotional Banner Section - Always light text regardless of theme -->
<section class="mb-5 promo-section" id="promoSection">
    <div class="row g-4">
        <div class="col-12 col-md-6">
            <div class="position-relative overflow-hidden h-100" style="border-radius: 24px; min-height: 200px;">
                <a href="/Product?category=Electronics&sortBy=price_asc" style="text-decoration: none; display: block; height: 100%;">
                    <div style="background: linear-gradient(135deg, rgba(124,88,204,0.9), rgba(16,185,129,0.8)), url('https://images.unsplash.com/photo-1441986300917-64674bd600d8') center/cover; height: 100%;">
                        <div class="p-4 d-flex flex-column justify-content-center h-100" style="color: #ffffff !important;">
                            <span class="badge rounded-pill mb-2 px-3 py-2" style="background: rgba(255,255,255,0.2); color: #ffffff !important; width: fit-content;">EXCLUSIVE OFFER</span>
                            <h3 class="fw-bold mb-2" style="color: #ffffff !important;">Electronics Sale</h3>
                            <p class="mb-3" style="color: rgba(255,255,255,0.85) !important;">Up to 40% off on latest gadgets</p>
                            <span class="btn rounded-pill px-4 fw-semibold" style="background: #ffffff !important; color: #111827 !important; border: none; width: fit-content;">Shop Now <i class="bi bi-arrow-right ms-2"></i></span>
                        </div>
                    </div>
                </a>
            </div>
        </div>
        <div class="col-12 col-md-6">
            <div class="position-relative overflow-hidden h-100" style="border-radius: 24px; min-height: 200px;">
                <a href="/Product?sortBy=newest" style="text-decoration: none; display: block; height: 100%;">
                    <div style="background: linear-gradient(135deg, rgba(239,68,68,0.85), rgba(245,158,11,0.9)), url('https://images.unsplash.com/photo-1483985988355-763728e1935b') center/cover; height: 100%;">
                        <div class="p-4 d-flex flex-column justify-content-center h-100" style="color: #ffffff !important;">
                            <span class="badge rounded-pill mb-2 px-3 py-2" style="background: rgba(255,255,255,0.2); color: #ffffff !important; width: fit-content;">LIMITED TIME</span>
                            <h3 class="fw-bold mb-2" style="color: #ffffff !important;">Fashion Trends</h3>
                            <p class="mb-3" style="color: rgba(255,255,255,0.85) !important;">Discover new season styles</p>
                            <span class="btn rounded-pill px-4 fw-semibold" style="background: #ffffff !important; color: #111827 !important; border: none; width: fit-content;">Explore <i class="bi bi-arrow-right ms-2"></i></span>
                        </div>
                    </div>
                </a>
            </div>
        </div>
    </div>
</section>

<!-- New Arrivals Section -->
<section class="mb-5" id="newArrivalsSection">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0"><i class="bi bi-lightning-charge" style="color:#e85d2a;"></i> New Arrivals</h3>
        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-dark rounded-pill btn-sm">View All <i class="bi bi-arrow-right ms-1"></i></a>
    </div>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
        @{
            var newProducts = Model.FeaturedProducts?.OrderByDescending(p => p.Id).Take(4).ToList() ?? new List<Product>();
        }
        @foreach (var p in newProducts)
        {
            var rating = p.Reviews?.Any() == true ? p.Reviews.Average(r => r.Rating) : 0;
            <div class="col product-card-wrapper" data-category-id="@p.CategoryId">
                <div class="card h-100 border-0 shadow-sm product-card" style="border-radius: 20px;">
                    <div class="position-relative" style="border-radius: 20px 20px 0 0;">
                        <span class="position-absolute top-0 start-0 m-3 badge rounded-pill" style="background: #10b981; color: white;"><i class="bi bi-lightning-charge me-1"></i> NEW</span>
                        <button class="btn btn-light rounded-circle position-absolute wishlist-btn" style="top: 16px; right: 16px; z-index: 10;" onclick="addToWishlist(event, @p.Id)" data-id="@p.Id"><i class="bi bi-heart"></i></button>
                        <a asp-controller="Product" asp-action="Details" asp-route-id="@p.Id" class="d-block" style="text-decoration: none;">
                            <img src="@p.ImageUrl" class="card-img-top p-3" style="height: 180px; object-fit: contain;" alt="@p.Name" onerror="this.src='https://commercial.bunn.com/img/image-not-available.png'" />
                        </a>
                    </div>
                    <div class="card-body">
                        <span class="badge" style="background: rgba(232,93,42,0.1); color: #e85d2a;">@p.Category?.Name</span>
                        <h5 class="fw-bold mt-2">@p.Name</h5>
                        <div class="d-flex align-items-center mb-2">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <i class="@(i <= rating ? "bi-star-fill" : "bi-star")" style="color: #fbbf24; font-size: 0.9rem;"></i>
                            }
                            <span class="text-muted small ms-1">(@(p.Reviews?.Count() ?? 0))</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="fw-bold fs-5 mt-2 d-block" style="color: #e85d2a;">Rs. @p.SellingPrice.ToString("0.00")</span>
                            @if (p.BasePrice > p.SellingPrice)
                            {
                                <span class="text-muted text-decoration-line-through small">Rs. @p.BasePrice.ToString("0.00")</span>
                            }
                        </div>
                    </div>
                    <div class="card-footer bg-transparent border-0 px-4 pb-4 d-flex gap-2">
                        <a asp-controller="Product" asp-action="Details" asp-route-id="@p.Id" class="btn rounded-pill flex-fill" style="background: #f3f4f6;"><i class="bi bi-eye"></i> View</a>
                        <button type="button" class="btn w-100 rounded-pill text-white" style="background: #111827;" onclick="addToCartAjax(event, @p.Id, 1)"><i class="bi bi-cart-plus"></i> Add</button>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<!-- Category Filter Tabs with Scroll Arrows -->
<div class="d-flex align-items-center gap-2 mb-4">
    <button class="btn btn-light rounded-circle flex-shrink-0 category-scroll-btn category-scroll-left" onclick="scrollCategories('left')" style="width: 40px; height: 40px; border: 1px solid #e5e7eb; display: none; z-index: 10;">
        <i class="bi bi-chevron-left"></i>
    </button>
    <div class="category-tabs-wrapper flex-grow-1 position-relative">
        <div class="d-flex gap-2 category-tabs-scroll" id="categoryTabsContainer" style="overflow-x: hidden; scroll-behavior: smooth;">
            <button class="btn btn-brand rounded-3 px-4 category-tab active fw-medium flex-shrink-0" style="height: 40px;" data-category-id="all">
                <i class="bi bi-grid-3x3-gap me-1"></i> All
            </button>
            @if (Model.Categories != null)
            {
                @foreach (var cat in Model.Categories)
                {
                    <button class="btn btn-outline-secondary rounded-3 px-4 category-tab fw-medium flex-shrink-0" style="height: 40px;" data-category-id="@cat.Id">
                        <i class="bi bi-tag me-1"></i> @cat.Name
                    </button>
                }
            }
        </div>
    </div>
    <button class="btn btn-light rounded-circle flex-shrink-0 category-scroll-btn category-scroll-right" onclick="scrollCategories('right')" style="width: 40px; height: 40px; border: 1px solid #e5e7eb; z-index: 10;">
        <i class="bi bi-chevron-right"></i>
    </button>
</div>

<style>
    .category-tabs-wrapper {
        overflow: hidden;
        position: relative;
    }
    .category-tabs-scroll::-webkit-scrollbar {
        display: none;
    }
    .category-tabs-scroll {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
    .category-scroll-btn {
        transition: all 0.2s ease;
        background: white;
    }
    .category-scroll-btn:hover {
        background: #f3f4f6;
        transform: scale(1.05);
    }
    [data-theme="dark"] .category-scroll-btn {
        background: var(--bg-tertiary);
        border-color: var(--border-color);
        color: var(--text-primary);
    }
    [data-theme="dark"] .category-scroll-btn:hover {
        background: var(--hover-bg);
    }
</style>

<script>
function scrollCategories(direction) {
    const container = document.getElementById('categoryTabsContainer');
    const scrollAmount = 200;
    if (direction === 'left') {
        container.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
    } else {
        container.scrollBy({ left: scrollAmount, behavior: 'smooth' });
    }
}

// Update arrow visibility based on scroll position
function updateScrollArrows() {
    const container = document.getElementById('categoryTabsContainer');
    const leftBtn = document.querySelector('.category-scroll-left');
    const rightBtn = document.querySelector('.category-scroll-right');
    if (container && leftBtn && rightBtn) {
        const isScrolledLeft = container.scrollLeft > 10;
        const isScrolledRight = container.scrollLeft < (container.scrollWidth - container.clientWidth - 10);
        leftBtn.style.display = isScrolledLeft ? 'flex' : 'none';
        rightBtn.style.display = isScrolledRight ? 'flex' : 'none';
    }
}

// Initialize arrows and listen for scroll
document.addEventListener('DOMContentLoaded', function() {
    const container = document.getElementById('categoryTabsContainer');
    if (container) {
        container.addEventListener('scroll', updateScrollArrows);
        // Initial check
        setTimeout(updateScrollArrows, 100);
        // Check on window resize
        window.addEventListener('resize', updateScrollArrows);
    }
});
</script>

<!-- Featured Products Section with AJAX Filtering -->
<section class="mb-5" id="featuredProductsSection">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0"><i class="bi bi-star-fill" style="color:#fbbf24;"></i> Featured Products</h3>
    </div>
    
    <div class="mb-4" id="filterStatus" style="display: none;">
        <span class="badge bg-primary rounded-pill px-3 py-2">
            <i class="bi bi-funnel me-1"></i> Filtering: <span id="currentFilterName">All</span>
            <button class="btn btn-sm btn-light ms-2 rounded-pill" onclick="clearCategoryFilter()"><i class="bi bi-x"></i> Clear</button>
        </span>
    </div>
    
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4 mb-4" id="productsGrid">
        @if (Model.FeaturedProducts != null && Model.FeaturedProducts.Any())
        {
            @foreach (var p in Model.FeaturedProducts)
            {
                var rating = p.Reviews?.Any() == true ? p.Reviews.Average(r => r.Rating) : 0;
                var discount = p.BasePrice > 0 && p.BasePrice > p.SellingPrice ? (int)((1 - p.SellingPrice / p.BasePrice) * 100) : 0;
                <div class="col product-card-wrapper" data-category-id="@p.CategoryId" data-product-id="@p.Id">
                    <div class="card h-100 border-0 shadow-sm product-card" style="border-radius: 20px; transition: transform 0.3s, box-shadow 0.3s;">
                        <button class="btn btn-light rounded-circle position-absolute wishlist-btn" style="top: 16px; right: 16px; z-index: 10;" onclick="addToWishlist(event, @p.Id)" data-id="@p.Id">
                            <i class="bi bi-heart"></i>
                        </button>
                        <div class="position-relative" style="border-radius: 20px 20px 0 0;">
                            <img src="@p.ImageUrl" class="card-img-top p-3" style="height: 180px; object-fit: contain;" alt="@p.Name" onerror="this.src='https://commercial.bunn.com/img/image-not-available.png'" />
                            @if (discount > 0)
                            {
                                <span class="position-absolute bottom-0 start-0 m-3 badge rounded-pill" style="background: #ef4444;">-@discount% OFF</span>
                            }
                            <button class="btn btn-dark rounded-pill position-absolute bottom-0 end-0 m-3 translate-y-100 quick-view-btn opacity-0" style="transition: all 0.3s ease;" onclick="event.stopPropagation(); window.location.href='/Product/Details/@p.Id'"><i class="bi bi-eye me-1"></i> Quick View</button>
                        </div>
                        <div class="card-body">
                            <span class="badge" style="background: rgba(232,93,42,0.1); color: #e85d2a;">@p.Category?.Name</span>
                            <h5 class="fw-bold mt-2">@p.Name</h5>
                            <p class="text-muted small" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">@p.Description</p>
                            <div class="d-flex align-items-center mt-2">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="@(i <= rating ? "bi-star-fill" : "bi-star")" style="color: #fbbf24; font-size: 0.9rem;"></i>
                                }
                                <span class="text-muted small ms-2">(@(p.Reviews?.Count() ?? 0) reviews)</span>
                            </div>
                            <span class="fw-bold fs-5 mt-2 d-block" style="color: #e85d2a;">Rs. @p.SellingPrice.ToString("0.00")</span>
                        </div>
                        <div class="card-footer bg-transparent border-0 px-4 pb-4 d-flex gap-2">
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@p.Id" class="btn rounded-pill flex-fill" style="background: #f3f4f6;">
                                <i class="bi bi-eye"></i> View
                            </a>
                            <button type="button" class="btn w-100 rounded-pill text-white" style="background: #111827;" onclick="addToCartAjax(event, @p.Id, 1)">
                                <i class="bi bi-cart-plus"></i> Add
                            </button>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</section>

<!-- Newsletter Section - Always light text regardless of theme -->
<section class="mb-5 newsletter-section" style="background: linear-gradient(135deg, rgba(17,24,39,0.95), rgba(31,41,55,0.95)); border-radius: 24px; padding: 3rem 2rem; color: #ffffff !important;">
    <div class="row align-items-center">
        <div class="col-lg-6 mb-4 mb-lg-0">
            <h3 class="fw-bold mb-2" style="color: #ffffff !important;"><i class="bi bi-envelope-open me-2" style="color:#fbbf24;"></i> Stay Updated</h3>
            <p class="mb-0 opacity-75" style="color: rgba(255,255,255,0.85) !important;">Subscribe to our newsletter for exclusive deals and new arrivals.</p>
        </div>
        <div class="col-lg-6">
            <form class="d-flex gap-2" onsubmit="event.preventDefault(); showToast('Thanks for subscribing!', 'success');">
                <input type="email" class="form-control rounded-pill" placeholder="Enter your email" required style="border-radius: 50rem; padding: 0.75rem 1.5rem; background: rgba(255,255,255,0.95) !important; color: #111827 !important; border: none;">
                <button type="submit" class="btn btn-warning rounded-pill px-4 fw-semibold" style="background: #fbbf24 !important; color: #111827 !important; border: none;">Subscribe</button>
            </form>
        </div>
    </div>
</section>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function() {
    @if (User.Identity.IsAuthenticated)
    {
        <text>
        fetch('/Wishlist/GetWishlistIds')
            .then(function(response) { return response.json(); })
            .then(function(ids) {
                ids.forEach(function(id) {
                    var btn = document.querySelector('[data-id="' + id + '"]');
                    if (btn && btn.classList.contains('wishlist-btn')) {
                        btn.innerHTML = '<i class="bi bi-heart-fill" style="color:#ef4444;"></i>';
                        btn.classList.add('in-wishlist');
                    }
                });
            })
            .catch(function() {});
        </text>
    }
    
    // Initialize enhanced product card effects
    initProductCardEffects();
    initCategoryFilter();
});

// Enhanced product card hover effects with Quick View button
function initProductCardEffects() {
    document.querySelectorAll('.product-card').forEach(function(card) {
        var quickViewBtn = card.querySelector('.quick-view-btn');
        card.addEventListener('mouseenter', function() {
            this.style.transform = 'translateY(-8px)';
            this.style.boxShadow = '0 20px 40px rgba(0,0,0,0.15)';
            if (quickViewBtn) {
                quickViewBtn.style.transform = 'translateY(0)';
                quickViewBtn.classList.remove('opacity-0');
            }
        });
        card.addEventListener('mouseleave', function() {
            this.style.transform = '';
            this.style.boxShadow = '';
            if (quickViewBtn) {
                quickViewBtn.style.transform = 'translateY(100%)';
                quickViewBtn.classList.add('opacity-0');
            }
        });
    });
}

// Category filter functionality
function initCategoryFilter() {
    var tabs = document.querySelectorAll('.category-tab');
    tabs.forEach(function(tab) {
        tab.addEventListener('click', function() {
            // Update active tab styling
            tabs.forEach(function(t) {
                t.classList.remove('btn-brand', 'active');
                t.classList.add('btn-outline-secondary');
            });
            this.classList.add('btn-brand', 'active');
            this.classList.remove('btn-outline-secondary');

            var categoryId = this.getAttribute('data-category-id');
            var categoryName = this.textContent.trim();
            
            // Show filter status
            var filterStatus = document.getElementById('filterStatus');
            if (categoryId !== 'all') {
                filterStatus.style.display = 'block';
                document.getElementById('currentFilterName').textContent = categoryName;
            } else {
                filterStatus.style.display = 'none';
            }
            
            filterProducts(categoryId);
        });
    });
}

function filterProducts(categoryId) {
    var cards = document.querySelectorAll('.product-card-wrapper[data-product-id]');
    var visibleCount = 0;
    
    cards.forEach(function(card) {
        var cardCategoryId = card.getAttribute('data-category-id');
        var isMatch = categoryId === 'all' || String(cardCategoryId) === String(categoryId);
        
        if (isMatch) {
            card.style.display = '';
            card.style.animation = 'fadeIn 0.4s ease forwards';
            visibleCount++;
        } else {
            card.style.display = 'none';
        }
    });
    
    // Show count message
    var grid = document.getElementById('productsGrid');
    var existingCount = grid.parentElement.querySelector('.filtered-count');
    if (existingCount) existingCount.remove();
    
    if (categoryId !== 'all' && visibleCount > 0) {
        var countMsg = document.createElement('div');
        countMsg.className = 'filtered-count text-muted mb-3';
        countMsg.innerHTML = '<i class="bi bi-check-circle me-1"></i> Showing ' + visibleCount + ' product(s)';
        grid.before(countMsg);
    }
}

function clearCategoryFilter() {
    // Reset tabs
    var tabs = document.querySelectorAll('.category-tab');
    tabs.forEach(function(t) {
        t.classList.remove('btn-brand', 'active');
        t.classList.add('btn-outline-secondary');
    });
    var allTab = document.querySelector('[data-category-id="all"]');
    if (allTab) {
        allTab.classList.add('btn-brand', 'active');
        allTab.classList.remove('btn-outline-secondary');
    }
    
    // Hide filter status
    document.getElementById('filterStatus').style.display = 'none';
    
    // Show all products
    var cards = document.querySelectorAll('.product-card-wrapper[data-product-id]');
    cards.forEach(function(card) {
        card.style.display = '';
        card.style.animation = 'fadeIn 0.4s ease forwards';
    });
    
    // Remove count message
    var existingCount = document.querySelector('.filtered-count');
    if (existingCount) existingCount.remove();
}

function addToWishlist(event, productId) {
    event.preventDefault();
    event.stopPropagation();

    @if (!User.Identity.IsAuthenticated)
    {
        <text>
        window.location.href = '/Account/Login';
        return;
        </text>
    }

    var btn = event.currentTarget;
    var isInWishlist = btn.classList.contains('in-wishlist');
    var token = document.querySelector('input[id="af-token"]') ? document.querySelector('input[id="af-token"]').value : '';

    var endpoint = isInWishlist ? '/Wishlist/RemoveFromWishlist' : '/Wishlist/AddToWishlist';
    
    fetch(endpoint + '?productId=' + productId, {
        method: 'POST',
        headers: {
            'RequestVerificationToken': token
        }
    })
    .then(function(response) { return response.json(); })
    .then(function(data) {
        if (data.success) {
            if (isInWishlist) {
                btn.innerHTML = '<i class="bi bi-heart"></i>';
                btn.classList.remove('in-wishlist');
                showToast('Removed from wishlist', 'info');
            } else {
                btn.innerHTML = '<i class="bi bi-heart-fill" style="color:#ef4444;"></i>';
                btn.classList.add('in-wishlist');
                showToast('Added to wishlist!', 'success');
            }
            // Update wishlist badge
            updateWishlistBadgeAjax();
        } else {
            showToast(data.message || 'Error updating wishlist', 'error');
        }
    })
    .catch(function(err) { 
        console.error(err);
        showToast('Error updating wishlist', 'error'); 
    });
}

function showToast(message, type) {
    var toast = document.createElement('div');
    toast.className = 'alert alert-' + (type === 'success' ? 'success' : type === 'error' ? 'danger' : 'info') + ' position-fixed';
    toast.style.cssText = 'top:20px;right:20px;z-index:9999;min-width:250px;animation:slideIn 0.3s ease;';
    var icon = type === 'success' ? 'bi-check-circle-fill' : type === 'error' ? 'bi-x-circle-fill' : 'bi-info-circle-fill';
    toast.innerHTML = '<i class="bi ' + icon + ' me-2"></i>' + message;
    document.body.appendChild(toast);
    setTimeout(function() {
        toast.style.opacity = '0';
        toast.style.transition = 'opacity 0.3s ease';
        setTimeout(function() { toast.remove(); }, 300);
    }, 3000);
}

// AJAX Add to Cart - doesn't redirect
async function addToCartAjax(event, productId, quantity) {
    event.preventDefault();
    event.stopPropagation();
    
    var token = document.querySelector('input[id="af-token"]') ? document.querySelector('input[id="af-token"]').value : '';
    var btn = event.currentTarget;
    var originalContent = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>';
    
    try {
        var response = await fetch('/Cart/AddToCart?productId=' + productId + '&quantity=' + quantity, {
            method: 'POST',
            headers: {
                'RequestVerificationToken': token
            }
        });
        
        if (response.ok || response.redirected) {
            // Update cart badge
            updateCartBadgeAjax();
            showToast('Added to cart!', 'success');
        } else {
            showToast('Error adding to cart', 'error');
        }
    } catch (error) {
        console.error('Error:', error);
        showToast('Error adding to cart', 'error');
    } finally {
        btn.disabled = false;
        btn.innerHTML = originalContent;
    }
}

// Update cart badge via AJAX (defined locally to be available in this page)
async function updateCartBadgeAjax() {
    try {
        var response = await fetch('/Cart/GetCartCount');
        if (response.ok) {
            var data = await response.json();
            var badge = document.getElementById('cart-count');
            if (badge) {
                badge.textContent = data.count || 0;
                badge.style.display = (data.count > 0) ? 'inline' : 'none';
            }
        }
    } catch (e) {}
}

// Update wishlist badge via AJAX
async function updateWishlistBadgeAjax() {
    try {
        var response = await fetch('/Wishlist/GetWishlistCount');
        if (response.ok) {
            var data = await response.json();
            var badge = document.getElementById('wishlist-count');
            if (badge) {
                badge.textContent = data.count || 0;
                badge.style.display = (data.count > 0) ? 'inline' : 'none';
            }
        }
    } catch (e) {}
}

// Load More Products (AJAX Pagination)
async function loadMoreProducts() {
    var btn = document.getElementById('loadMoreBtn');
    var loadMoreText = document.getElementById('loadMoreText');
    var loadMoreSpinner = document.getElementById('loadMoreSpinner');
    var currentPageEl = document.getElementById('currentPage');
    var totalPagesEl = document.getElementById('totalPages');
    var currentCategory = document.getElementById('currentCategory').value;
    
    var currentPage = parseInt(currentPageEl.value);
    var totalPages = parseInt(totalPagesEl.value);
    
    if (currentPage >= totalPages) {
        btn.style.display = 'none';
        return;
    }
    
    btn.disabled = true;
    loadMoreText.style.display = 'none';
    loadMoreSpinner.style.display = 'inline';
    
    try {
        var nextPage = currentPage + 1;
        var response = await fetch('/Product/LoadMoreProducts?page=' + nextPage + '&category=' + currentCategory);
        var data = await response.json();
        
        if (data.success && data.products && data.products.length > 0) {
            var grid = document.getElementById('productsGrid');
            
            data.products.forEach(function(p) {
                var discount = p.basePrice > 0 && p.basePrice > p.sellingPrice ? Math.round((1 - p.sellingPrice / p.basePrice) * 100) : 0;
                var stars = '';
                for (var i = 1; i <= 5; i++) {
                    stars += '<i class="' + (i <= Math.round(p.avgRating) ? 'bi-star-fill' : 'bi-star') + '" style="color: #fbbf24; font-size: 0.9rem;"></i>';
                }
                
                var card = document.createElement('div');
                card.className = 'col product-card-wrapper';
                card.setAttribute('data-category-id', p.categoryId);
                card.style.animation = 'fadeIn 0.5s ease';
                card.innerHTML = `
                    <div class="card h-100 border-0 shadow-sm product-card" style="border-radius: 20px; transition: transform 0.3s, box-shadow 0.3s;">
                        <button class="btn btn-light rounded-circle position-absolute wishlist-btn" style="top: 16px; right: 16px; z-index: 10;" onclick="addToWishlist(event, ${p.id})" data-id="${p.id}">
                            <i class="bi bi-heart"></i>
                        </button>
                        <div class="position-relative" style="border-radius: 20px 20px 0 0;">
                            <img src="${p.imageUrl}" class="card-img-top p-3" style="height: 180px; object-fit: contain;" alt="${p.name}" onerror="this.src='https://commercial.bunn.com/img/image-not-available.png'" />
                            ${discount > 0 ? '<span class="position-absolute bottom-0 start-0 m-3 badge rounded-pill" style="background: #ef4444;">-' + discount + '% OFF</span>' : ''}
                        </div>
                        <div class="card-body">
                            <span class="badge" style="background: rgba(232,93,42,0.1); color: #e85d2a;">${p.categoryName || ''}</span>
                            <h5 class="fw-bold mt-2">${p.name}</h5>
                            <p class="text-muted small" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">${p.description || ''}</p>
                            <div class="d-flex align-items-center mt-2">
                                ${stars}
                                <span class="text-muted small ms-2">(${p.reviewCount} reviews)</span>
                            </div>
                            <span class="fw-bold fs-5 mt-2 d-block" style="color: #e85d2a;">Rs. ${p.sellingPrice.toFixed(2)}</span>
                        </div>
                        <div class="card-footer bg-transparent border-0 px-4 pb-4 d-flex gap-2">
                            <a href="/Product/Details/${p.id}" class="btn rounded-pill flex-fill" style="background: #f3f4f6;">
                                <i class="bi bi-eye"></i> View
                            </a>
                            <form action="/Cart/AddToCart" method="post">
                                <input type="hidden" name="productId" value="${p.id}" />
                                <input type="hidden" name="quantity" value="1" />
                                <button type="submit" class="btn w-100 rounded-pill text-white" style="background: #111827;">
                                    <i class="bi bi-cart-plus"></i> Add
                                </button>
                            </form>
                        </div>
                    </div>
                `;
                grid.appendChild(card);
            });
            
            // Update page info
            currentPageEl.value = data.currentPage;
            totalPagesEl.value = data.totalPages;
            
            // Hide button if no more pages
            if (!data.hasMore) {
                btn.style.display = 'none';
            }
        } else {
            btn.style.display = 'none';
        }
    } catch (error) {
        console.error('Error loading more products:', error);
        showToast('Error loading products', 'error');
    } finally {
        btn.disabled = false;
        loadMoreText.style.display = 'inline';
        loadMoreSpinner.style.display = 'none';
    }
}

// Initialize total pages from initial data
@if (Model.FeaturedProducts != null && Model.FeaturedProducts.Any())
{
    <text>
    // Assuming we can show all products in one page initially
    document.getElementById('totalPages').value = 1;
    </text>
}

// Category Filter Tabs - Updated to work with pagination
var tabs = document.querySelectorAll('.category-tab');
tabs.forEach(function(tab) {
    tab.addEventListener('click', function() {
        tabs.forEach(function(t) {
            t.classList.remove('btn-brand');
            t.classList.add('btn-outline-secondary');
        });
        this.classList.add('btn-brand');
        this.classList.remove('btn-outline-secondary');

        var categoryId = this.getAttribute('data-category-id');
        document.getElementById('currentCategory').value = categoryId;
        document.getElementById('currentPage').value = 1;
        
        var cards = document.querySelectorAll('.product-card-wrapper');

        cards.forEach(function(card) {
            var cardCategoryId = card.getAttribute('data-category-id');
            if (categoryId === 'all' || String(cardCategoryId) === String(categoryId)) {
                card.style.display = '';
                card.style.animation = 'fadeIn 0.3s ease';
            } else {
                card.style.display = 'none';
            }
        });
        
        // Reset load more button
        var btn = document.getElementById('loadMoreBtn');
        btn.style.display = 'inline';
    });
});

// Add hover effect for product cards
document.querySelectorAll('.product-card').forEach(function(card) {
    card.addEventListener('mouseenter', function() {
        this.style.transform = 'translateY(-8px)';
        this.style.boxShadow = '0 16px 40px rgba(0,0,0,0.12)';
    });
    card.addEventListener('mouseleave', function() {
        this.style.transform = '';
        this.style.boxShadow = '';
    });
});
</script>

<style>
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    @@keyframes slideIn {
        from { transform: translateX(100%); opacity: 0; }
        to { transform: translateX(0); opacity: 1; }
    }
    
    .product-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    
    .product-card:hover .card-img-top {
