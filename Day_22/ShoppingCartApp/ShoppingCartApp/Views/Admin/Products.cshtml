@model ShoppingCartApp.ViewModels.AdminProductsViewModel
@{
    ViewData["Title"] = "Manage Products";
    var hasFilters = !string.IsNullOrEmpty(Model.SearchQuery) || 
                     !string.IsNullOrEmpty(Model.Category) || 
                     !string.IsNullOrEmpty(Model.StockFilter) ||
                     Model.MinPrice.HasValue || 
                     Model.MaxPrice.HasValue ||
                     !string.IsNullOrEmpty(Model.SortBy);
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 mt-2">
    <div>
        @if (Model.TotalPages > 1)
        {
            <span class="text-muted small">
                Page <strong>@Model.CurrentPage</strong> of <strong>@Model.TotalPages</strong>
                <span class="mx-2">|</span>
                Showing @(Model.Products.Count()) of <strong>@Model.TotalProducts</strong> products
            </span>
        }
        else
        {
            <span class="text-muted">Total <strong>@Model.TotalProducts</strong> products</span>
        }
    </div>
    <h2 class="fw-bold mb-0" style="font-family: 'Space Grotesk', sans-serif; letter-spacing: -0.02em;">
        <i class="bi bi-box-seam" style="color: #e85d2a;"></i> Manage Products
    </h2>
    <a asp-action="Index" class="btn rounded-pill px-4 fw-semibold" style="background: #f3f4f6; color: #4b5563; border: 1px solid #e5e7eb;">
        <i class="bi bi-arrow-left me-1"></i> Dashboard
    </a>
</div>

<!-- Stock Health Metrics -->
<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm" style="border-radius: 16px;">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-gray-800 mb-0"><i class="bi bi-box-seam text-warning me-2"></i>Stock Health Overview</h5>
                    <a href="?stockFilter=low_stock" class="btn btn-sm btn-outline-warning rounded-pill">
                        <i class="bi bi-exclamation-triangle me-1"></i> View Low Stock
                    </a>
                </div>
                @{
                    var totalStock = Model.Products?.Sum(p => p.Stock) ?? 0;
                    var inStock = Model.Products?.Count(p => p.Stock > 10) ?? 0;
                    var lowStock = Model.Products?.Count(p => p.Stock > 0 && p.Stock <= 10) ?? 0;
                    var outOfStock = Model.Products?.Count(p => p.Stock == 0) ?? 0;
                    var totalProducts = Model.TotalProducts;
                }
                <div class="row g-3 mt-2">
                    <div class="col-6 col-md-3">
                        <div class="p-3 rounded-3 text-center" style="background: rgba(16, 185, 129, 0.1);">
                            <div class="fw-bold text-success" style="font-size: 1.5rem;">@inStock</div>
                            <small class="text-muted">In Stock (10+)</small>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 rounded-3 text-center" style="background: rgba(245, 158, 11, 0.1);">
                            <div class="fw-bold text-warning" style="font-size: 1.5rem;">@lowStock</div>
                            <small class="text-muted">Low Stock (1-10)</small>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 rounded-3 text-center" style="background: rgba(239, 68, 68, 0.1);">
                            <div class="fw-bold text-danger" style="font-size: 1.5rem;">@outOfStock</div>
                            <small class="text-muted">Out of Stock</small>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 rounded-3 text-center" style="background: rgba(139, 92, 246, 0.1);">
                            <div class="fw-bold" style="font-size: 1.5rem; color: #8b5cf6;">@totalStock</div>
                            <small class="text-muted">Total Units</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100" style="border-radius: 16px;">
            <div class="card-body p-4">
                <h5 class="fw-bold text-gray-800 mb-3"><i class="bi bi-graph-up-arrow text-success me-2"></i>Stock Status Distribution</h5>
                <div style="height: 160px; position: relative;">
                    <canvas id="stockStatusChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" style="border-radius: 12px; border: none; border-left: 4px solid #10b981; font-size: 0.95rem;">
        <i class="bi bi-check-circle-fill me-2" style="color: #10b981;"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Search and Filter Section -->
<div class="card border-0 shadow-sm mb-4" style="border-radius: 16px;">
    <div class="card-body">
        <form asp-action="Products" method="get" id="search-filter-form">
            <div class="row g-3 align-items-end">
                <!-- Search Input -->
                <div class="col-lg-4 col-md-6">
                    <label class="form-label fw-semibold text-muted small" style="letter-spacing: 0.5px;">Search</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0" style="border-radius: 12px 0 0 12px;">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" name="searchQuery" value="@Model.SearchQuery" class="form-control border-start-0 ps-0" style="border-radius: 0 12px 12px 0;" placeholder="Search by name or description..." />
                    </div>
                </div>
                
                <!-- Category Filter -->
                <div class="col-lg-2 col-md-4">
                    <label class="form-label fw-semibold text-muted small" style="letter-spacing: 0.5px;">Category</label>
                    <select name="category" class="form-select" style="border-radius: 12px;">
                        <option value="">All Categories</option>
                        @foreach (var cat in Model.Categories)
                        {
                            <option value="@cat.Name" selected="@(Model.Category == cat.Name)">@cat.Name</option>
                        }
                    </select>
                </div>
                
                <!-- Stock Status Filter -->
                <div class="col-lg-2 col-md-4">
                    <label class="form-label fw-semibold text-muted small" style="letter-spacing: 0.5px;">Stock Status</label>
                    <select name="stockFilter" class="form-select" style="border-radius: 12px;">
                        <option value="" selected="@(Model.StockFilter == null || Model.StockFilter == "")">All Statuses</option>
                        <option value="in_stock" selected="@(Model.StockFilter == "in_stock")">In Stock (10+)</option>
                        <option value="low_stock" selected="@(Model.StockFilter == "low_stock")">Low Stock (1-9)</option>
                        <option value="out_of_stock" selected="@(Model.StockFilter == "out_of_stock")">Out of Stock</option>
                    </select>
                </div>
                
                <!-- Sort By -->
                <div class="col-lg-2 col-md-4">
                    <label class="form-label fw-semibold text-muted small" style="letter-spacing: 0.5px;">Sort By</label>
                    <select name="sortBy" class="form-select" style="border-radius: 12px;">
                        <option value="newest" selected="@(Model.SortBy == null || Model.SortBy == "newest")">Newest First</option>
                        <option value="name_asc" selected="@(Model.SortBy == "name_asc")">Name A-Z</option>
                        <option value="name_desc" selected="@(Model.SortBy == "name_desc")">Name Z-A</option>
                        <option value="price_asc" selected="@(Model.SortBy == "price_asc")">Price: Low to High</option>
                        <option value="price_desc" selected="@(Model.SortBy == "price_desc")">Price: High to Low</option>
                        <option value="stock_asc" selected="@(Model.SortBy == "stock_asc")">Stock: Low to High</option>
                        <option value="stock_desc" selected="@(Model.SortBy == "stock_desc")">Stock: High to Low</option>
                    </select>
                </div>
                
                <!-- Filter Buttons -->
                <div class="col-lg-2">
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn flex-fill text-white fw-semibold" style="background: #e85d2a; border: none; border-radius: 12px;">
                            <i class="bi bi-funnel-fill me-1"></i> Filter
                        </button>
                        @if (hasFilters)
                        {
                            <a asp-action="Products" class="btn btn-outline-secondary fw-semibold" style="border-radius: 12px;" title="Clear all filters">
                                <i class="bi bi-x-lg"></i>
                            </a>
                        }
                    </div>
                </div>
            </div>
            
            <!-- Price Range -->
            <div class="row g-3 mt-2">
                <div class="col-lg-3 col-md-4">
                    <label class="form-label fw-semibold text-muted small" style="letter-spacing: 0.5px;">Min Price (₹)</label>
                    <input type="number" name="minPrice" value="@(Model.MinPrice.HasValue ? Model.MinPrice.Value.ToString() : "")" class="form-control" style="border-radius: 12px;" placeholder="0" min="0" />
                </div>
                <div class="col-lg-3 col-md-4">
                    <label class="form-label fw-semibold text-muted small" style="letter-spacing: 0.5px;">Max Price (₹)</label>
                    <input type="number" name="maxPrice" value="@(Model.MaxPrice.HasValue ? Model.MaxPrice.Value.ToString() : "")" class="form-control" style="border-radius: 12px;" placeholder="No max" min="0" />
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Results Summary -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        @if (hasFilters)
        {
            <span class="text-muted">
                Showing <strong class="text-dark">@Model.TotalResults</strong> of <strong class="text-dark">@Model.TotalProducts</strong> products
                @if (!string.IsNullOrEmpty(Model.SearchQuery))
                {
                    <span>for "<strong>@Model.SearchQuery</strong>"</span>
                }
            </span>
        }
        else
        {
            <span class="text-muted">Total <strong class="text-dark">@Model.TotalProducts</strong> products</span>
        }
    </div>
</div>

<!-- Bulk Data Management Card -->
<div class="card border-0 shadow-sm mb-4" style="border-radius: 16px;">
    <div class="card-body">
        <h6 class="fw-bold mb-3 text-muted">Bulk Data Management</h6>
        <div class="d-flex flex-wrap gap-3 align-items-center">
            <!-- Form for Excel Upload -->
            <form asp-action="ImportExcel" method="post" enctype="multipart/form-data" class="d-flex align-items-center gap-2">
                <input type="file" name="file" class="form-control form-control-sm" accept=".xlsx" required style="max-width: 220px;" />
                <button type="submit" class="btn btn-sm btn-outline-success"><i class="bi bi-file-earmark-excel"></i> Import Excel</button>
            </form>
            
            <!-- Form for CSV Upload -->
            <form asp-action="ImportCsv" method="post" enctype="multipart/form-data" class="d-flex align-items-center gap-2">
                <input type="file" name="file" class="form-control form-control-sm" accept=".csv" required style="max-width: 220px;" />
                <button type="submit" class="btn btn-sm btn-outline-info"><i class="bi bi-filetype-csv"></i> Import CSV</button>
            </form>
            
            <div class="mx-auto"></div>
            
            <!-- Export with date filter -->
            <form asp-action="ExportExcel" method="get" class="d-flex align-items-center gap-1">
                <input type="date" name="startDate" class="form-control form-control-sm" style="width: 130px; border-radius: 8px;" title="From" />
                <input type="date" name="endDate" class="form-control form-control-sm" style="width: 130px; border-radius: 8px;" title="To" />
                <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-download"></i> Export</button>
            </form>
            <form asp-action="ExportCsv" method="get" class="d-flex align-items-center gap-1">
                <button type="submit" class="btn btn-sm btn-info text-white"><i class="bi bi-download"></i> Export CSV</button>
            </form>
            
            <form asp-action="DeleteAllProducts" method="post" onsubmit="return confirm('WARNING: Are you sure you want to delete ALL PRODUCTS, REVIEWS, and CART ITEMS? This action cannot be undone.')">
                <button type="submit" class="btn btn-sm btn-danger"><i class="bi bi-trash-fill"></i> Delete All</button>
            </form>
        </div>
    </div>
</div>

@if (!Model.Products.Any())
{
    <div class="text-center py-5 my-5 rounded-4 shadow-sm" style="background: rgba(248, 250, 252, 0.8); border: 1px dashed #cbd5e1;">
        <div class="d-inline-flex justify-content-center align-items-center rounded-circle mb-3 bg-white shadow-sm text-muted" style="width: 100px; height: 100px; font-size: 3rem;">
            <i class="bi bi-inbox"></i>
        </div>
        <h3 class="fw-bold text-dark mt-2" style="font-family: 'Space Grotesk', sans-serif;">No products found</h3>
        <p class="text-muted mb-4 fs-5">
            @if (hasFilters)
            {
                <text>Try adjusting your search or filter criteria.</text>
            }
            else
            {
                <text>Add your first product to get started.</text>
            }
        </p>
        @if (hasFilters)
        {
            <a asp-action="Products" class="btn btn-dark btn-lg rounded-pill px-5 fw-bold shadow-sm">
                Clear Filters
            </a>
        }
        else
        {
            <a asp-action="CreateProduct" class="btn btn-dark btn-lg rounded-pill px-5 fw-bold shadow-sm">
                <i class="bi bi-plus-circle me-2"></i> Add Product
            </a>
        }
    </div>
}
else
{
<div class="card border-0 shadow-sm mb-4" style="border-radius: 16px; overflow: hidden;">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.95rem;">
                <thead style="background: #f8fafc;">
                    <tr>
                        <th class="border-0 text-muted fw-semibold ps-4 py-3">Image</th>
                        <th class="border-0 text-muted fw-semibold py-3">Name</th>
                        <th class="border-0 text-muted fw-semibold py-3">Category</th>
                        <th class="border-0 text-muted fw-semibold py-3">Base Price</th>
                        <th class="border-0 text-muted fw-semibold py-3">Selling Price</th>
                        <th class="border-0 text-muted fw-semibold py-3">Stock</th>
                        <th class="border-0 text-muted fw-semibold py-3">Reviews</th>
                        <th class="border-0 text-muted fw-semibold pe-4 py-3 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model.Products)
                    {
                        <tr>
                            <td class="ps-4 py-3">
                                <div class="bg-light rounded-3 d-inline-block" style="padding: 2px;">
                                    <img src="@product.ImageUrl" width="56" height="56" class="rounded-3 shadow-sm" style="object-fit:cover;" onerror="this.src='https://commercial.bunn.com/img/image-not-available.png'" />
                                </div>
                            </td>
                            <td class="fw-bold" style="color: #111827;">@product.Name</td>
                            <td>
                                <span class="badge rounded-pill bg-light text-dark border">@product.Category?.Name</span>
                            </td>
                            <td class="fw-bold" style="color: #64748b;">
                                ₹@product.BasePrice.ToString("0.00")
                            </td>
                            <td class="fw-bold" style="color: #10b981;">
                                ₹@product.SellingPrice.ToString("0.00")
                            </td>
                            <td>
                                @if (product.Stock == 0)
                                {
                                    <span class="badge rounded-pill" style="background: rgba(239,68,68,0.1); color: #ef4444; padding: 6px 12px;">
                                        <i class="bi bi-exclamation-triangle me-1"></i> Out of Stock
                                    </span>
                                }
                                else if (product.Stock < 5)
                                {
                                    <span class="badge rounded-pill" style="background: rgba(245,158,11,0.1); color: #d97706; padding: 6px 12px;">
                                        @product.Stock (Low)
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill" style="background: rgba(16,185,129,0.1); color: #10b981; padding: 6px 12px;">@product.Stock</span>
                                }
                            </td>
                            <td>
                                <span class="badge rounded-pill" style="background: rgba(245,158,11,0.1); color: #d97706; padding: 6px 12px;">
                                    @(product.Reviews?.Count ?? 0)
                                </span>
                            </td>
                            <td class="pe-4 py-3 text-end">
                                <div class="d-flex gap-2 justify-content-end">
                                    <a asp-action="EditProduct" asp-route-id="@product.Id" class="btn btn-sm rounded-circle d-flex align-items-center justify-content-center" style="width: 34px; height: 34px; background: rgba(59,130,246,0.1); color: #3b82f6; border: none; transition: all 0.2s ease;" onmouseover="this.style.background='#3b82f6'; this.style.color='#fff';" onmouseout="this.style.background='rgba(59,130,246,0.1)'; this.style.color='#3b82f6';">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="DeleteProduct" method="post" onsubmit="return confirm('Delete @product.Name? This cannot be undone.')">
                                        <input type="hidden" name="id" value="@product.Id" />
                                        <button type="submit" class="btn btn-sm rounded-circle d-flex align-items-center justify-content-center" style="width: 34px; height: 34px; background: rgba(239,68,68,0.1); color: #ef4444; border: none; transition: all 0.2s ease;" onmouseover="this.style.background='#ef4444'; this.style.color='#fff';" onmouseout="this.style.background='rgba(239,68,68,0.1)'; this.style.color='#ef4444';">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
}

<!-- Pagination -->
@if (Model.TotalPages > 1)
{
    <nav aria-label="Products pagination" class="d-flex justify-content-center mt-4">
        <ul class="pagination pagination-rounded mb-0">
            @{
                var prevDisabled = Model.CurrentPage == 1 ? "disabled" : "";
                var nextDisabled = Model.CurrentPage == Model.TotalPages ? "disabled" : "";
                
                var queryParams = new Dictionary<string, string>();
                if (!string.IsNullOrEmpty(Model.SearchQuery)) queryParams["searchQuery"] = Model.SearchQuery;
                if (!string.IsNullOrEmpty(Model.Category)) queryParams["category"] = Model.Category;
                if (!string.IsNullOrEmpty(Model.StockFilter)) queryParams["stockFilter"] = Model.StockFilter;
                if (!string.IsNullOrEmpty(Model.SortBy)) queryParams["sortBy"] = Model.SortBy;
                if (Model.MinPrice.HasValue) queryParams["minPrice"] = Model.MinPrice.Value.ToString();
                if (Model.MaxPrice.HasValue) queryParams["maxPrice"] = Model.MaxPrice.Value.ToString();
            }
            
            <li class="page-item @prevDisabled">
                <a class="page-link" href="?page=@(Model.CurrentPage - 1)@string.Join("", queryParams.Select(x => $"&{x.Key}={x.Value}"))" aria-label="Previous">
                    <i class="bi bi-chevron-left"></i>
                </a>
            </li>
            
            @{
                int startPage = Math.Max(1, Model.CurrentPage - 2);
                int endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
            }
            
            @if (startPage > 1)
            {
                <li class="page-item"><a class="page-link" href="?page=1@string.Join("", queryParams.Select(x => $"&{x.Key}={x.Value}"))">1</a></li>
                @if (startPage > 2) { <li class="page-item disabled"><span class="page-link">...</span></li> }
            }
            
            @for (int i = startPage; i <= endPage; i++)
            {
                var active = i == Model.CurrentPage ? "active" : "";
                <li class="page-item @active"><a class="page-link" href="?page=@i@string.Join("", queryParams.Select(x => $"&{x.Key}={x.Value}"))">@i</a></li>
            }
            
            @if (endPage < Model.TotalPages)
            {
                @if (endPage < Model.TotalPages - 1) { <li class="page-item disabled"><span class="page-link">...</span></li> }
                <li class="page-item"><a class="page-link" href="?page=@Model.TotalPages@string.Join("", queryParams.Select(x => $"&{x.Key}={x.Value}"))">@Model.TotalPages</a></li>
            }
            
            <li class="page-item @nextDisabled">
                <a class="page-link" href="?page=@(Model.CurrentPage + 1)@string.Join("", queryParams.Select(x => $"&{x.Key}={x.Value}"))" aria-label="Next">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
}

<style>
    .form-control:focus, .form-select:focus {
        border-color: #e85d2a !important;
        box-shadow: 0 0 0 4px rgba(232,93,42,0.1) !important;
    }
    .pagination-rounded .page-link {
        border-radius: 50%;
        margin: 0 3px;
    }
    .pagination-rounded .page-item.active .page-link {
        background-color: #e85d2a;
        border-color: #e85d2a;
    }
    .pagination-rounded .page-item.disabled .page-link {
        opacity: 0.5;
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        // Detect current theme for chart colors
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        const chartColors = {
            text: isDark ? '#9ca3af' : '#6b7280',
            grid: isDark ? 'rgba(255,255,255,0.1)' : 'rgba(0,0,0,0.05)'
        };
        
        // Stock Status Doughnut Chart
        const inStock = @inStock;
        const lowStock = @lowStock;
        const outOfStock = @outOfStock;
        
        // Apply theme-aware defaults
        Chart.defaults.color = chartColors.text;
        
        new Chart(document.getElementById('stockStatusChart'), {
            type: 'doughnut',
            data: {
                labels: ['In Stock (10+)', 'Low Stock (1-10)', 'Out of Stock'],
                datasets: [{
                    data: [inStock, lowStock, outOfStock],
                    backgroundColor: [
                        'rgba(16, 185, 129, 0.8)',
                        'rgba(245, 158, 11, 0.8)',
                        'rgba(239, 68, 68, 0.8)'
                    ],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { padding: 15, usePointStyle: true, pointStyle: 'circle', font: { size: 11 } }
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                const total = inStock + lowStock + outOfStock;
                                const percentage = ((context.raw / total) * 100).toFixed(1);
                                return context.label + ': ' + context.raw + ' (' + percentage + '%)';
                            }
                        }
                    }
                }
            }
        });
    });
</script>