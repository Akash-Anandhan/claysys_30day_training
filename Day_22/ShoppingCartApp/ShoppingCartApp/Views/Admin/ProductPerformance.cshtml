@model ShoppingCartApp.ViewModels.ProductPerformanceViewModel

@{
    ViewData["Title"] = "Product Performance";
    var currentSort = ViewBag.SortBy as string ?? "revenue_desc";
    var currentCategory = ViewBag.Category as string;
    var currentSearch = ViewBag.SearchQuery as string;
}

<script src=https://cdn.tailwindcss.com></script>
<script>
  tailwind.config = {
    corePlugins: { preflight: false },
    theme: { extend: { colors: { brand: '#e85d2a', brandDark: '#c74b20', brandLight: '#fff0eb' } } }
  }
</script>
<script src=https://cdn.jsdelivr.net/npm/chart.js></script>

<style>
    .dash-card {
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.03);
        border: 1px solid rgba(0,0,0,0.04);
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .dash-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 30px rgba(0,0,0,0.08);
    }
    .text-brand { color: #e85d2a; }
    .bg-brand-light { background-color: #fff0eb; }
    .performance-badge {
        display: inline-flex;
        align-items: center;
        padding: 4px 12px;
        border-radius: 50rem;
        font-size: 0.75rem;
        font-weight: 600;
    }
    .table-container { overflow-x: auto; }
    .table thead th {
        background: #f9fafb;
        font-weight: 600;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #6b7280;
        border-bottom: 1px solid #e5e7eb;
        padding: 12px 16px;
        white-space: nowrap;
    }
    .table tbody td {
        padding: 16px;
        vertical-align: middle;
        border-bottom: 1px solid #f3f4f6;
    }
    .table tbody tr:hover { background: #f9fafb; }
    .stat-highlight { font-size: 0.85rem; font-weight: 600; }
    .country-bar {
        height: 6px;
        border-radius: 3px;
        background: linear-gradient(90deg, #e85d2a, #f59e0b);
    }
    .star-rating { color: #fbbf24; }
</style>

<!-- Page Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom gap-3">
    <div>
        <h2 class="fw-bold mb-1" style="font-size: 1.5rem; color: #1f2937; font-family: 'Space Grotesk', sans-serif;">
            <i class="bi bi-graph-up text-brand me-2"></i> Product Performance
        </h2>
        <p class="text-muted mb-0" style="font-size: 0.9rem;">Track sales, revenue, reviews, and audience insights for each product</p>
    </div>
    <div class="flex-shrink-0">
        <a href="/Admin/Products" class="btn btn-outline-dark rounded-3 fw-medium px-3 py-2 d-flex align-items-center gap-2">
            <i class="bi bi-arrow-left"></i> Back to Products
        </a>
    </div>
</div>

<!-- Summary Stats Row -->
<div class='row row-cols-1 row-cols-md-2 row-cols-xl-4 g-4 mb-4'>
    <div class=col>
        <div class='dash-card p-4 h-100'>
            <div class='d-flex justify-content-between align-items-start'>
                <div>
                    <p class='text-gray-500 mb-1 text-sm fw-semibold text-uppercase'>Total Revenue</p>
                    <h3 class='fw-bold text-gray-800 mb-0'>Rs @Model.TotalRevenue.ToString("N0")</h3>
                </div>
                <div class='stat-icon bg-success bg-opacity-10 text-success'><i class='bi bi-currency-dollar fs-4'></i></div>
            </div>
            <p class='text-muted text-sm mt-2 mb-0'>Across @Model.TotalProducts products</p>
        </div>
    </div>
    <div class=col>
        <div class='dash-card p-4 h-100'>
            <div class='d-flex justify-content-between align-items-start'>
                <div>
                    <p class='text-gray-500 mb-1 text-sm fw-semibold text-uppercase'>Total Units Sold</p>
                    <h3 class='fw-bold text-gray-800 mb-0'>@Model.TotalUnitsSold.ToString("N0")</h3>
                </div>
                <div class='stat-icon bg-brand-light text-brand'><i class='bi bi-cart-check fs-4'></i></div>
            </div>
            <p class='text-muted text-sm mt-2 mb-0'>From all orders</p>
        </div>
    </div>
    <div class=col>
        <div class='dash-card p-4 h-100'>
            <div class='d-flex justify-content-between align-items-start'>
                <div>
                    <p class='text-gray-500 mb-1 text-sm fw-semibold text-uppercase'>Total Reviews</p>
                    <h3 class='fw-bold text-gray-800 mb-0'>@Model.TotalReviews.ToString("N0")</h3>
                </div>
                <div class='stat-icon bg-warning bg-opacity-10 text-warning'><i class='bi bi-star fs-4'></i></div>
            </div>
            <p class='text-muted text-sm mt-2 mb-0'>Customer feedback</p>
        </div>
    </div>
    <div class=col>
        <div class='dash-card p-4 h-100'>
            <div class='d-flex justify-content-between align-items-start'>
                <div>
                    <p class='text-gray-500 mb-1 text-sm fw-semibold text-uppercase'>Products Analyzed</p>
                    <h3 class='fw-bold text-gray-800 mb-0'>@Model.TotalProducts</h3>
                </div>
                <div class=stat-icon style='background: rgba(139, 92, 246, 0.1);'><i class='bi bi-box-seam fs-4' style='color: #8b5cf6;'></i></div>
            </div>
            <p class='text-muted text-sm mt-2 mb-0'>In performance report</p>
        </div>
    </div>
</div>

<!-- Filters Row -->
<div class='dash-card p-4 mb-4'>
    <form method=get class='row g-3 align-items-end'>
        <div class='col-12 col-md-3'>
            <label class='form-label text-sm fw-semibold text-gray-600 mb-1'>Search</label>
            <input type=text name=searchQuery class=form-control placeholder='Search products...' value='@currentSearch' />
        </div>
        <div class='col-12 col-md-2'>
            <label class='form-label text-sm fw-semibold text-gray-600 mb-1'>Category</label>
            <select name=category class=form-select>
                <option value=''>All Categories</option>
                @foreach (var cat in Model.Categories)
                {
                    <option value='@cat.Name' selected=@(currentCategory == cat.Name)>@cat.Name</option>
                }
            </select>
        </div>
        <div class='col-12 col-md-2'>
            <label class='form-label text-sm fw-semibold text-gray-600 mb-1'>Sort By</label>
            <select name=sortBy class=form-select>
                <option value='revenue_desc' selected=@(currentSort == "revenue_desc")>Revenue (High to Low)</option>
                <option value='revenue_asc' selected=@(currentSort == "revenue_asc")>Revenue (Low to High)</option>
                <option value='orders_desc' selected=@(currentSort == "orders_desc")>Orders (High to Low)</option>
                <option value='orders_asc' selected=@(currentSort == "orders_asc")>Orders (Low to High)</option>
                <option value='rating_desc' selected=@(currentSort == "rating_desc")>Rating (High to Low)</option>
                <option value='name_asc' selected=@(currentSort == "name_asc")>Name (A-Z)</option>
                <option value='name_desc' selected=@(currentSort == "name_desc")>Name (Z-A)</option>
            </select>
        </div>
        <div class='col-12 col-md-2'>
            <button type=submit class='btn btn-primary w-100 rounded-3' style='background-color: #e85d2a; border-color: #e85d2a;'>
                <i class='bi bi-funnel me-1'></i> Apply Filters
            </button>
        </div>
        <div class='col-12 col-md-3'>
            <a href=/Admin/ProductPerformance class='btn btn-outline-secondary w-100 rounded-3'>
                <i class='bi bi-x-circle me-1'></i> Clear Filters
            </a>
        </div>
    </form>
</div>

<!-- Performance Table -->
<div class=dash-card>
    <div class=table-container>
        <table class='table mb-0'>
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Category</th>
                    <th class='text-center'>Sales</th>
                    <th class='text-center'>Revenue</th>
                    <th class='text-center'>Avg Order</th>
                    <th class='text-center'>Reviews</th>
                    <th class='text-center'>Rating</th>
                    <th>Top Audience</th>
                    <th class='text-center'>Stock</th>
                    <th class='text-center'>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Products.Any())
                {
                    <tr>
                        <td colspan=10 class='text-center py-5'>
                            <div class=text-muted>
                                <i class='bi bi-inbox fs-1 d-block mb-2'></i>
                                <p class=mb-0>No products found</p>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var product in Model.Products)
                    {
                        <tr>
                            <td>
                                <div class='d-flex align-items-center gap-3'>
                                    <div class='rounded-3 bg-gray-100 flex-shrink-0 d-flex align-items-center justify-content-center' style='width: 56px; height: 56px; overflow: hidden;'>
                                        @if (!string.IsNullOrEmpty(product.ImageUrl))
                                        {
                                            <img src='@product.ImageUrl' width=56 height=56 style='object-fit: cover;' onerror="this.src='https://commercial.bunn.com/img/image-not-available.png'" />
                                        }
                                        else
                                        {
                                            <i class='bi bi-box text-gray-400 fs-4'></i>
                                        }
                                    </div>
                                    <div>
                                        <h6 class='fw-bold text-gray-800 mb-0' style='max-width: 200px;'>@product.ProductName</h6>
                                        <span class='text-muted text-sm'>Rs @product.Price.ToString("0.00")</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class='performance-badge bg-brand-light text-brand'>@product.CategoryName</span>
                            </td>
                            <td class='text-center'>
                                <div>
                                    <span class=stat-highlight>@product.TotalUnitsSold</span>
                                    <span class='text-muted text-sm ms-1'>units</span>
                                </div>
                                <div class='text-xs text-muted'>@product.TotalOrders orders</div>
                            </td>
                            <td class='text-center'>
                                <span class='stat-highlight text-success fw-bold'>Rs @product.TotalRevenue.ToString("N0")</span>
                            </td>
                            <td class='text-center'>
                                <span class=stat-highlight>Rs @product.AverageOrderValue.ToString("0.00")</span>
                            </td>
                            <td class='text-center'>
                                <span class=stat-highlight>@product.TotalReviews</span>
                            </td>
                            <td class='text-center'>
                                @if (product.AverageRating > 0)
                                {
                                    <div class=star-rating>
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <i class=@((i <= product.AverageRating) ? "bi-star-fill" : "bi-star")></i>
                                        }
                                    </div>
                                    <span class='text-xs text-muted'>@product.AverageRating.ToString("0.0")</span>
                                }
                                else
                                {
                                    <span class='text-muted text-sm'>No ratings</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(product.TopCountry) && product.TopCountry != "N/A")
                                {
                                    <div>
                                        <span class='fw-semibold text-sm'>@product.TopCountry</span>
                                        <div class='country-bar mt-1' style='width: 100px;'></div>
                                        @if (product.CountryDistribution.Count > 1)
                                        {
                                            <span class='text-xs text-muted'>+ @(product.CountryDistribution.Count - 1) more</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class='text-muted text-sm'>No data</span>
                                }
                            </td>
                            <td class='text-center'>
                                @if (product.Stock > 10)
                                {
                                    <span class='performance-badge bg-success bg-opacity-10 text-success'>@product.Stock in stock</span>
                                }
                                else if (product.Stock > 0)
                                {
                                    <span class='performance-badge bg-warning bg-opacity-10 text-warning'>@product.Stock low</span>
                                }
                                else
                                {
                                    <span class='performance-badge bg-danger bg-opacity-10 text-danger'>Out of stock</span>
                                }
                            </td>
                            <td class='text-center'>
                                <div class='d-flex gap-2 justify-content-center flex-wrap'>
                                    <a href="/Product/Details/@product.ProductId" class='btn btn-sm btn-outline-primary rounded-3 d-flex align-items-center gap-1' target='_blank' title='View Product'>
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                        View
                                    </a>
                                    <a href="/Admin/EditProduct/@product.ProductId" class='btn btn-sm btn-outline-warning rounded-3 d-flex align-items-center gap-1' title='Edit Product'>
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                        Edit
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class='d-flex justify-content-between align-items-center p-4 border-top'>
            <div class='text-muted text-sm'>
                Showing @(Model.Products.Any() ? (Model.CurrentPage - 1) * 20 + 1 : 0) to @(Math.Min(Model.CurrentPage * 20, Model.TotalProducts)) of @Model.TotalProducts products
            </div>
            <nav>
                <ul class=pagination mb-0>
                    @if (Model.CurrentPage > 1)
                    {
                        <li class=page-item>
                            <a class=page-link href='?page=@(Model.CurrentPage - 1)&searchQuery=@currentSearch&category=@currentCategory&sortBy=@currentSort'>Previous</a>
                        </li>
                    }
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class='page-item @(i == Model.CurrentPage ? "active" : "")'>
                            <a class=page-link href='?page=@i&searchQuery=@currentSearch&category=@currentCategory&sortBy=@currentSort'>@i</a>
                        </li>
                    }
                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <li class=page-item>
                            <a class=page-link href='?page=@(Model.CurrentPage + 1)&searchQuery=@currentSearch&category=@currentCategory&sortBy=@currentSort'>Next</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    }
</div>

<!-- Revenue Distribution Chart -->
@if (Model.Products.Any())
{
    <div class='row g-4 mt-2'>
        <div class=col-lg-8>
            <div class='dash-card p-4'>
                <div class='d-flex justify-content-between align-items-center mb-3'>
                    <h5 class='fw-bold text-gray-800 mb-0'>Revenue Distribution</h5>
                    <span class='badge bg-brand-light text-brand'>Top 10 Products</span>
                </div>
                <div style='height: 280px; position: relative;'>
                    <canvas id=revenueChart></canvas>
                </div>
            </div>
        </div>
        <div class=col-lg-4>
            <div class='dash-card p-4' style='max-height: 320px; overflow-y: auto;'>
                <h5 class='fw-bold text-gray-800 mb-4'>Top Countries</h5>
                <div id=countryList class='d-flex flex-column gap-3'>
                    @{
                        var topCountries = Model.Products
                            .Where(p => p.CountryDistribution != null && p.CountryDistribution.Any())
                            .SelectMany(p => p.CountryDistribution)
                            .GroupBy(c => c.Key)
                            .OrderByDescending(g => g.Sum(c => c.Value))
                            .Take(5)
                            .ToList();
                    }
                    @if (topCountries.Any())
                    {
                        @foreach (var country in topCountries)
                        {
                            var maxCount = topCountries.First().Sum(c => c.Value);
                            var percentage = (country.Sum(c => c.Value) * 100.0 / maxCount).ToString("0");
                            <div class='d-flex align-items-center justify-content-between'>
                                <span class=fw-medium>@country.Key</span>
                                <div class='d-flex align-items-center gap-2'>
                                    <div class='progress rounded-pill' style='width: 80px; height: 6px;'>
                                        <div class=progress-bar style='width: @percentage%; background-color: #e85d2a;'></div>
                                    </div>
                                    <span class='text-muted text-sm'>@country.Sum(c => c.Value)</span>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class='text-muted text-center py-4'>
                            <i class='bi bi-globe fs-1 d-block mb-2 opacity-50'></i>
                            <p class=mb-0>No country data available</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function() {
    var productNames = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Products.Take(10).Select(p => p.ProductName.Length > 20 ? p.ProductName.Substring(0, 20) + "..." : p.ProductName).ToList()));
    var revenues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Products.Take(10).Select(p => p.TotalRevenue).ToList()));

    if (productNames.length > 0) {
        new Chart(document.getElementById('revenueChart'), {
            type: 'bar',
            data: {
                labels: productNames,
                datasets: [{
                    label: 'Revenue (Rs)',
                    data: revenues,
                    backgroundColor: 'rgba(232, 93, 42, 0.8)',
                    borderColor: '#e85d2a',
                    borderWidth: 1,
                    borderRadius: 8,
                    barThickness: 40
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return 'Rs ' + context.raw.toLocaleString('en-IN');
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return 'Rs ' + value.toLocaleString('en-IN');
                            }
                        },
                        grid: { color: 'rgba(0,0,0,0.05)' }
                    },
                    x: { grid: { display: false } }
                }
            }
        });
    }
});
</script>
}