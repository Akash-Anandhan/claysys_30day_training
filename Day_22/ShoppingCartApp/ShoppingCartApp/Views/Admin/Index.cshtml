@model ShoppingCartApp.DTOs.Admin.AdminDashboardDto

@{
    ViewData["Title"] = "Admin Dashboard";
    var stats = Model;
    var currentRange = ViewBag.CurrentDateRange as string ?? "This Month";
}

<!-- Map libraries -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/jsvectormap/dist/css/jsvectormap.min.css" />

<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = {
    corePlugins: { preflight: false },
    theme: { extend: { colors: { brand: '#e85d2a', brandDark: '#c74b20', brandLight: '#fff0eb' } } }
  }
</script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jsvectormap"></script>
<script src="https://cdn.jsdelivr.net/npm/jsvectormap/dist/maps/world.js"></script>

<style>
.dash-card {
    background: #ffffff;
    border-radius: 16px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.03);
    border: 1px solid rgba(0,0,0,0.04);
    transition: transform 0.2s, box-shadow 0.2s;
    overflow: hidden;
}
.dash-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(0,0,0,0.08);
}
.chart-container-lg { position: relative; height: 350px; width: 100%; }
.chart-container-md { position: relative; height: 250px; width: 100%; }
.chart-container-sm { position: relative; height: 200px; width: 100%; }
.stat-icon { width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; border-radius: 12px; }
.text-brand { color: #e85d2a; }
.bg-brand-light { background-color: #fff0eb; }
</style>

<!-- Dashboard Header / Controls Row -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="mb-2 mb-lg-0">
        <h2 class="fw-bold mb-1 text-2xl text-gray-800" style="font-family: 'Space Grotesk', sans-serif;">
            <i class="bi bi-grid-fill text-brand me-2"></i> Executive Dashboard
        </h2>
    </div>
    <div class="d-flex gap-3 align-items-center">
        <!-- Functional Date Selector -->
        <select id="dateRangeSelect" class="form-select bg-white shadow-sm border-0 rounded-3 text-sm fw-medium" style="width: 140px;" onchange="window.location.href='/Admin?dateRange=' + this.value">
            <option value="Today" selected="@(currentRange == "Today")">Today</option>
            <option value="This Week" selected="@(currentRange == "This Week")">This Week</option>
            <option value="This Month" selected="@(currentRange == "This Month")">This Month</option>
            <option value="This Year" selected="@(currentRange == "This Year")">This Year</option>
        </select>
        <button class="btn bg-white shadow-sm rounded-circle position-relative p-2" onclick="window.location.reload()">
            <i class="bi bi-arrow-clockwise text-gray-600 fs-5"></i>
        </button>
        <form asp-action="SeedData" asp-controller="Admin" method="post" class="m-0">
            <button type="submit" class="btn bg-white shadow-sm rounded-3 fw-medium text-brand border border-gray-100 px-3 py-2 d-flex align-items-center gap-2">
                <i class="bi bi-database-add"></i> <span class="d-none d-md-inline">Populate DB</span>
            </button>
        </form>
        <form asp-action="PopulatePaymentMethods" asp-controller="Admin" method="post" class="m-0">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn bg-white shadow-sm rounded-3 fw-medium text-success border border-gray-100 px-3 py-2 d-flex align-items-center gap-2" title="Populate payment methods for existing orders" onclick="return confirm('This will assign random payment methods to all orders without one. Continue?')">
                <i class="bi bi-credit-card-2-front"></i> <span class="d-none d-md-inline">Populate Payments</span>
            </button>
        </form>
        <a asp-action="CreateProduct" class="btn text-white fw-medium shadow-sm rounded-3 d-flex align-items-center gap-2 px-3 py-2" style="background-color: #e85d2a;">
            <i class="bi bi-plus-lg"></i> <span class="d-none d-md-inline">Add Product</span>
        </a>
    </div>
</div>

<!-- ROW 1: KEY METRICS -->
<div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-4 mb-4">
    <div class="col">
        <div class="dash-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <p class="text-gray-500 mb-1 text-sm fw-semibold text-uppercase">New Orders</p>
                    <h3 class="fw-bold text-gray-800 mb-0">@stats.TotalOrders</h3>
                </div>
                <div class="stat-icon bg-brand-light text-brand"><i class="bi bi-cart fs-4"></i></div>
            </div>
            <div class="d-flex align-items-center text-sm">
                <span class="@(stats.OrdersGrowth >= 0 ? "text-success" : "text-danger") fw-bold me-2"><i class="bi @(stats.OrdersGrowth >= 0 ? "bi-arrow-up-right" : "bi-arrow-down-right")"></i> @stats.OrdersGrowth%</span>
                <span class="text-gray-400">vs prev @currentRange</span>
            </div>
            <div class="mt-3"><canvas id="sparklineOrders" height="40"></canvas></div>
        </div>
    </div>
    <div class="col">
        <div class="dash-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <p class="text-gray-500 mb-1 text-sm fw-semibold text-uppercase">Gross Income</p>
                    <h3 class="fw-bold text-gray-800 mb-0">₹@stats.TotalIncome.ToString("N0")</h3>
                </div>
                <div class="stat-icon bg-success bg-opacity-10 text-success"><i class="bi bi-currency-dollar fs-4"></i></div>
            </div>
            <div class="d-flex align-items-center text-sm">
                <span class="@(stats.IncomeGrowth >= 0 ? "text-success" : "text-danger") fw-bold me-2"><i class="bi @(stats.IncomeGrowth >= 0 ? "bi-arrow-up-right" : "bi-arrow-down-right")"></i> @stats.IncomeGrowth%</span>
                <span class="text-gray-400">vs prev @currentRange</span>
            </div>
            <div class="mt-3"><canvas id="sparklineIncome" height="40"></canvas></div>
        </div>
    </div>
    <div class="col">
        <div class="dash-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <p class="text-gray-500 mb-1 text-sm fw-semibold text-uppercase">Total Cost (Est)</p>
                    <h3 class="fw-bold text-gray-800 mb-0">₹@stats.TotalExpense.ToString("N0")</h3>
                </div>
                <div class="stat-icon bg-danger bg-opacity-10 text-danger"><i class="bi bi-graph-down fs-4"></i></div>
            </div>
            <div class="d-flex align-items-center text-sm">
                <span class="@(stats.ExpenseGrowth >= 0 ? "text-danger" : "text-success") fw-bold me-2"><i class="bi @(stats.ExpenseGrowth >= 0 ? "bi-arrow-up-right" : "bi-arrow-down-right")"></i> @stats.ExpenseGrowth%</span>
                <span class="text-gray-400">vs prev @currentRange</span>
            </div>
            <div class="mt-3"><canvas id="sparklineExpense" height="40"></canvas></div>
        </div>
    </div>
    <div class="col">
        <div class="dash-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <p class="text-gray-500 mb-1 text-sm fw-semibold text-uppercase">Total Users</p>
                    <h3 class="fw-bold text-gray-800 mb-0">@stats.TotalUsers</h3>
                </div>
                <div class="stat-icon bg-info bg-opacity-10 text-info"><i class="bi bi-people fs-4"></i></div>
            </div>
            <div class="d-flex align-items-center text-sm">
                <span class="text-success fw-bold me-2"><i class="bi bi-arrow-up-right"></i> @stats.UsersGrowth%</span>
                <span class="text-gray-400">Registered overall</span>
            </div>
            <div class="mt-3">
                <div class="progress border-0 rounded-pill" style="height: 6px;">
                    <div class="progress-bar bg-info" style="width: 70%"></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="dash-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <p class="text-gray-500 mb-1 text-sm fw-semibold text-uppercase">Stock Turnover</p>
                    <h3 class="fw-bold text-gray-800 mb-0">@stats.StockTurnover</h3>
                </div>
                <div class="stat-icon bg-warning bg-opacity-10 text-warning"><i class="bi bi-arrow-repeat fs-4"></i></div>
            </div>
            <div class="d-flex align-items-center text-sm">
                <span class="@(stats.StockTurnoverGrowth >= 0 ? "text-success" : "text-danger") fw-bold me-2"><i class="bi @(stats.StockTurnoverGrowth >= 0 ? "bi-arrow-up-right" : "bi-arrow-down-right")"></i> @stats.StockTurnoverGrowth%</span>
                <span class="text-gray-400">vs prev @currentRange</span>
            </div>
            <div class="mt-3">
                <div class="progress border-0 rounded-pill" style="height: 6px;">
                    <div class="progress-bar bg-warning" style="width: @(Math.Min(100, stats.StockTurnover * 10))%"></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="dash-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <p class="text-gray-500 mb-1 text-sm fw-semibold text-uppercase">Total Products</p>
                    <h3 class="fw-bold text-gray-800 mb-0">@stats.TotalProducts</h3>
                </div>
                <div class="stat-icon" style="background: rgba(139, 92, 246, 0.1);"><i class="bi bi-box-seam fs-4" style="color: #8b5cf6;"></i></div>
            </div>
            <div class="d-flex align-items-center text-sm">
                <span class="text-gray-400">Across all categories</span>
            </div>
            <div class="mt-3">
                <div class="progress border-0 rounded-pill" style="height: 6px;">
                    <div class="progress-bar" style="width: @(Math.Min(100, stats.TotalProducts * 2))%; background-color: #8b5cf6;"></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="dash-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <p class="text-gray-500 mb-1 text-sm fw-semibold text-uppercase">Profit / Loss</p>
                    <h3 class="fw-bold mb-0 @(stats.MonthlyProfitLoss >= 0 ? "text-success" : "text-danger")">₹@stats.MonthlyProfitLoss.ToString("N0")</h3>
                </div>
                <div class="stat-icon bg-@(stats.MonthlyProfitLoss >= 0 ? "success" : "danger") bg-opacity-10 text-@(stats.MonthlyProfitLoss >= 0 ? "success" : "danger")"><i class="bi bi-graph-up fs-4"></i></div>
            </div>
            <div class="d-flex align-items-center text-sm">
                <span class="text-gray-400">For @currentRange</span>
            </div>
            <div class="mt-3">
                @if (stats.MonthlyProfitLoss >= 0)
                {
                    <div class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2">
                        <i class="bi bi-arrow-up me-1"></i> Profit
                    </div>
                }
                else
                {
                    <div class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-2">
                        <i class="bi bi-arrow-down me-1"></i> Loss
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col">
        <div class="dash-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <p class="text-gray-500 mb-1 text-sm fw-semibold text-uppercase">Low Stock</p>
                    <h3 class="fw-bold text-gray-800 mb-0">@stats.LowStockCount</h3>
                </div>
                <div class="stat-icon @(stats.LowStockCount > 0 ? "bg-warning bg-opacity-10 text-warning" : "bg-success bg-opacity-10 text-success")"><i class="bi bi-exclamation-triangle fs-4"></i></div>
            </div>
            <div class="d-flex align-items-center text-sm">
                @if (stats.LowStockCount > 0)
                {
                    <span class="text-warning fw-bold me-2"><i class="bi bi-exclamation-circle"></i> Needs attention</span>
                }
                else
                {
                    <span class="text-success fw-bold me-2"><i class="bi bi-check-circle"></i> All stocked</span>
                }
            </div>
            <div class="mt-3">
                <a href="/Admin/Products?stockFilter=low_stock" class="btn btn-sm btn-outline-warning rounded-pill px-3">
                    View Products <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- ROW 2: PERFORMANCE CHARTS -->
<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="dash-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="fw-bold text-gray-800 mb-0">Revenue Analytics (@currentRange)</h5>
            </div>
            <div class="chart-container-lg"><canvas id="revenueAnalyticsChart"></canvas></div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="dash-card h-100 h-100">
            <div class="p-4 border-bottom border-gray-100 bg-gray-50 pb-3">
                <h5 class="fw-bold text-gray-800 mb-0"><i class="bi bi-trophy text-warning me-2"></i>Top Selling Product</h5>
            </div>
            <div class="p-0">
                <ul class="list-group list-group-flush">
                    @foreach(var product in stats.TopSellingProducts)
                    {
                        <a href="/Product/Details/@product.Id" class="text-decoration-none list-group-item d-flex align-items-center p-4 hover:bg-gray-50 transition border-gray-100">
                            <div class="rounded-3 bg-gray-100 flex-shrink-0 d-flex align-items-center justify-content-center border" style="width: 56px; height: 56px; overflow:hidden;">
                                @if(!string.IsNullOrEmpty(product.ImageUrl)){
                                    <img src="@product.ImageUrl" width="56" height="56" style="object-fit: cover;" onerror="this.src='https://commercial.bunn.com/img/image-not-available.png'" />
                                } else {
                                    <i class="bi bi-box text-gray-400 fs-3"></i>
                                }
                            </div>
                            <div class="ms-3 flex-grow-1">
                                <h6 class="fw-bold text-gray-800 mb-1 text-truncate" style="max-width: 180px;">@product.Name</h6>
                                <div class="text-xs text-gray-500 d-flex align-items-center">
                                    <span class="badge bg-brand-light text-brand me-2">₹@product.SellingPrice</span>
                                    <span class="text-muted"><i class="bi bi-cart-check"></i> Stock: @product.Stock</span>
                                </div>
                            </div>
                        </a>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

<!-- ROW 3: SALES & CUSTOMER INSIGHTS -->
<div class="row g-4 mb-4">
    <!-- Category Chart -->
    <div class="col-lg-4">
        <div class="dash-card p-4 h-100 d-flex flex-column">
            <h5 class="fw-bold text-gray-800 mb-4">Sales by Category</h5>
            <div class="chart-container-md flex-grow-1 d-flex align-items-center justify-content-center">
                <canvas id="salesCategoryChart"></canvas>
            </div>
        </div>
    </div>
    <!-- Monthly Sales Comparison -->
    <div class="col-lg-4">
        <div class="dash-card p-4 h-100 d-flex flex-column">
            <h5 class="fw-bold text-gray-800 mb-0">Comparison over Period</h5>
            <div class="chart-container-md flex-grow-1 mt-4">
                <canvas id="monthlyComparisonChart"></canvas>
            </div>
        </div>
    </div>
    <!-- Funnel -->
    <div class="col-lg-4">
        <div class="dash-card p-4 h-100 bg-gradient-to-br from-gray-900 to-gray-800">
            <h5 class="fw-bold text-white mb-4">Customer Journey Rates</h5>
            <div class="d-flex flex-column gap-3">
                <div class="d-flex align-items-center px-4">
                    <div class="bg-white bg-opacity-10 text-white rounded-3 p-2 fw-medium text-center mx-auto shadow" style="width: 85%;">
                        <div class="text-xs text-gray-400 text-uppercase mb-1">Added to Cart</div>
                        <div class="fs-5">@stats.FunnelCart <span class="text-xs text-brand">(Ratio)</span></div>
                    </div>
                </div>
                <div class="d-flex justify-content-center"><i class="bi bi-arrow-down text-gray-500"></i></div>
                <div class="d-flex align-items-center px-5">
                    <div class="bg-brand text-white rounded-3 p-2 fw-medium text-center mx-auto shadow shadow-brand" style="width: 70%;">
                        <div class="text-xs text-white text-opacity-75 text-uppercase mb-1">Completed Orders</div>
                        <div class="fs-5 fw-bold">@stats.FunnelCompleted</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ROW 4 & ROW 5 COMPACTED -->
<div class="row g-4 mb-4">
    <div class="col-lg-5">
        <div class="dash-card h-100">
            <div class="p-4 border-bottom border-gray-100"><h5 class="fw-bold text-gray-800 mb-0">Recent Order Activity</h5></div>
            <div class="p-4" style="max-height: 380px; overflow-y: auto;">
                <div class="timeline position-relative ps-2">
                    <div class="position-absolute h-100 bg-gray-200" style="width: 2px; left: 15px; top: 10px;"></div>
                    @foreach(var activity in stats.OrderTimeline)
                    {
                        <div class="d-flex position-relative mb-4">
                            <div class="bg-@activity.Color text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm z-index-1" style="width: 32px; height: 32px; z-index: 2;">
                                <i class="bi @activity.Icon"></i>
                            </div>
                            <div class="ms-4">
                                <p class="mb-1 fw-bold text-gray-700 text-sm">@activity.Action</p>
                                <p class="text-xs text-gray-400 mb-0"><i class="bi bi-clock me-1"></i> @activity.TimeAgo</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <!-- Geographic World Map! -->
    <div class="col-lg-7">
        <div class="dash-card p-4 h-100 d-flex flex-column">
            <div class="d-flex justify-content-between mb-2">
                <h5 class="fw-bold text-gray-800">Orders by Geographic Region</h5>
                <span class="text-xs text-gray-500">Derived from Shipping Addresses</span>
            </div>
            <!-- The Map Element -->
            <div id="worldMap" class="flex-grow-1" style="min-height: 300px; width: 100%;"></div>
        </div>
    </div>
</div>

<!-- ROW 6: PAYMENT METHODS -->
<div class="row g-4 mb-4">
    <div class="col-lg-12">
        <div class="dash-card p-4 h-100 d-flex flex-column">
            <h5 class="fw-bold text-gray-800 mb-4">Payment Methods Usage</h5>
            <div class="chart-container-md flex-grow-1 d-flex align-items-center justify-content-center">
                <canvas id="paymentMethodsChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- ROW 7: USER REGISTRATION TREND -->
<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="dash-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="fw-bold text-gray-800 mb-0"><i class="bi bi-person-plus text-info me-2"></i>User Registrations Trend</h5>
                <span class="badge bg-info bg-opacity-10 text-info">@currentRange</span>
            </div>
            <div class="chart-container-md"><canvas id="userRegistrationChart"></canvas></div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="dash-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="fw-bold text-gray-800 mb-0"><i class="bi bi-receipt text-success me-2"></i>Average Order Value Trend</h5>
                <span class="badge bg-success bg-opacity-10 text-success">₹@stats.AverageOrderValue.ToString("0.00") avg</span>
            </div>
            <div class="chart-container-md"><canvas id="aovTrendChart"></canvas></div>
        </div>
    </div>
</div>


<!-- JAVASCRIPT LOGIC -->
<script>
    (function() {
        function initDashboard() {
        // Detect current theme for chart colors
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        const chartColors = {
            text: isDark ? '#9ca3af' : '#6b7280',
            grid: isDark ? 'rgba(255,255,255,0.1)' : 'rgba(0,0,0,0.05)',
            tooltipBg: isDark ? '#1f2937' : '#ffffff',
            tooltipText: isDark ? '#f9fafb' : '#111827'
        };
        
        const data = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { 
            Months = Model.Months, 
            RevenueTrend = Model.RevenueTrend,
            CostTrend = Model.CostTrend,
            ProfitTrend = Model.ProfitTrend,
            CategoryNames = Model.CategoryNames,
            CategorySales = Model.CategorySales,
            CategoryRevenue = Model.CategoryRevenue,
            PaymentMethods = Model.PaymentMethods,
            PaymentCounts = Model.PaymentCounts,
            Regions = Model.Regions,
            RegionSales = Model.RegionSales,
            SatisfactionScore = Model.SatisfactionScore,
            UserRegistrationLabels = Model.UserRegistrationLabels,
            UserRegistrationCounts = Model.UserRegistrationCounts,
            AOVLabels = Model.AOVLabels,
            AOVValues = Model.AOVValues
        }, new System.Text.Json.JsonSerializerOptions { ReferenceHandler = System.Text.Json.Serialization.ReferenceHandler.IgnoreCycles }));
        Chart.defaults.font.family = "'Inter', 'Segoe UI', sans-serif";
        Chart.defaults.color = chartColors.text;
        
        // Revenue Analytics
        new Chart(document.getElementById('revenueAnalyticsChart'), {
            type: 'line',
            data: {
                labels: data.Months,
                datasets: [
                    { label: 'Revenue', data: data.RevenueTrend, borderColor: '#e85d2a', backgroundColor: 'rgba(232, 93, 42, 0.1)', fill: true, tension: 0.4 },
                    { label: 'Cost/Expense', data: data.CostTrend, borderColor: '#6366f1', borderDash: [5,5], fill: false, tension: 0.4 }
                ]
            },
            options: { responsive: true, maintainAspectRatio: false }
        });

        // Sales Category
        new Chart(document.getElementById('salesCategoryChart'), {
            type: 'doughnut',
            data: {
                labels: data.CategoryNames,
                datasets: [{ data: data.CategorySales, backgroundColor: ['#e85d2a', '#f59e0b', '#10b981', '#3b82f6', '#8b5cf6'], borderWidth: 0 }]
            },
            options: { maintainAspectRatio: false }
        });

        // Comparison Bar Chart (Category Revenues)
        new Chart(document.getElementById('monthlyComparisonChart'), {
            type: 'bar',
            data: {
                labels: data.CategoryNames,
                datasets: [{ label: 'Revenue Flow', data: data.CategoryRevenue, backgroundColor: '#e85d2a', borderRadius: 4 }]
            },
            options: { responsive: true, maintainAspectRatio: false, scales: { x: { grid: { display: false } }, y: { display: false } } }
        });

        // Payment Methods Chart (Pie Chart)
        new Chart(document.getElementById('paymentMethodsChart'), {
            type: 'pie',
            data: {
                labels: data.PaymentMethods,
                datasets: [{
                    data: data.PaymentCounts,
                    backgroundColor: ['#e85d2a', '#3b82f6', '#10b981', '#f59e0b', '#8b5cf6'],
                    borderWidth: 2,
                    borderColor: '#ffffff',
                    hoverOffset: 8
                }]
            },
            options: {
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            padding: 20,
                            usePointStyle: true,
                            pointStyle: 'circle'
                        }
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                var total = context.dataset.data.reduce((a, b) => a + b, 0);
                                var value = context.raw;
                                var percentage = ((value / total) * 100).toFixed(1);
                                return context.label + ': ' + value + ' orders (' + percentage + '%)';
                            }
                        }
                    }
                }
            }
        });

        // User Registration Trend Chart
        new Chart(document.getElementById('userRegistrationChart'), {
            type: 'line',
            data: {
                labels: data.UserRegistrationLabels,
                datasets: [{
                    label: 'New Users',
                    data: data.UserRegistrationCounts,
                    borderColor: '#3b82f6',
                    backgroundColor: 'rgba(59, 130, 246, 0.1)',
                    fill: true,
                    tension: 0.4,
                    pointBackgroundColor: '#3b82f6',
                    pointBorderColor: '#fff',
                    pointBorderWidth: 2,
                    pointRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true, ticks: { stepSize: 1 } }
                }
            }
        });

        // Average Order Value Trend Chart
        new Chart(document.getElementById('aovTrendChart'), {
            type: 'line',
            data: {
                labels: data.AOVLabels,
                datasets: [{
                    label: 'Avg Order Value',
                    data: data.AOVValues,
                    borderColor: '#10b981',
                    backgroundColor: 'rgba(16, 185, 129, 0.1)',
                    fill: true,
                    tension: 0.4,
                    pointBackgroundColor: '#10b981',
                    pointBorderColor: '#fff',
                    pointBorderWidth: 2,
                    pointRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { 
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return '₹' + context.raw.toLocaleString('en-IN');
                            }
                        }
                    }
                },
                scales: {
                    y: { 
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return '₹' + value.toLocaleString('en-IN');
                            }
                        }
                    }
                }
            }
        });

        // JsVectorMap Geographic Chart!
        // Convert regions map (Data.Regions / RegionSales) to key value pairs
        let mapDataSeries = {};
        for (let i = 0; i < data.Regions.length; i++) {
            let code = data.Regions[i];
            if(code.length === 2) { 
                mapDataSeries[code] = data.RegionSales[i];
            } else {
                mapDataSeries['US'] = (mapDataSeries['US']||0) + data.RegionSales[i]; // Default fallback mapping
            }
        }

        const map = new jsVectorMap({
            selector: '#worldMap',
            map: 'world',
            theme: isDark ? 'dark' : 'light',
            zoomButtons: false,
            regionStyle: {
                initial: { fill: '#e5e7eb' },
                hover: { fill: '#f59e0b', fillOpacity: 1 }
            },
            visualizeData: {
                scale: ['#fff0eb', '#e85d2a'],
                values: mapDataSeries
            },
            onRegionTooltipShow(event, tooltip, code) {
                let sales = mapDataSeries[code] || 0;
                tooltip.text(tooltip.text() + ': ' + sales + ' Orders');
            }
        });
        }
        
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initDashboard);
        } else {
            initDashboard();
        }
    })();
</script>
