@model List<ShoppingCartApp.Models.Product>

@{
    ViewData["Title"] = "Compare Products";
}

<div class=d-flex align-items-center mb-5 mt-2>
    <h2 class=fw-bold mb-0>
        <i class=bi bi-arrow-left-right text-primary me-2></i> Compare Products
    </h2>
    <a asp-action=Index class=btn btn-outline-secondary rounded-pill ms-auto>
        <i class=bi bi-arrow-left me-1></i> Back
    </a>
</div>

@if (Model == null || !Model.Any())
{
    <div class=text-center py-5 my-5 rounded-4 style=background:rgba(248,250,252,0.8);border:1px dashed #cbd5e1;>
        <div class=d-inline-flex justify-content-center align-items-center rounded-circle mb-3 bg-white shadow-sm text-muted style=width:100px;height:100px;font-size:3rem;>
            <i class=bi bi-plus-circle></i>
        </div>
        <h3 class=fw-bold>No products to compare</h3>
        <p class=text-muted>Add products to compare from the product page.</p>
        <a asp-action=Index class=btn btn-primary btn-lg rounded-pill px-5>Browse Products</a>
    </div>
}
else if (Model.Count == 1)
{
    <div class=alert alert-info text-center>
        <i class=bi bi-info-circle me-2></i> Add at least one more product to compare.
        <a asp-action=Index class=btn btn-sm btn-primary ms-3>Add Products</a>
    </div>
}
else
{
    <div class=table-responsive bg-white rounded-4 shadow-sm style=overflow:hidden;>
        <table class=table table-hover align-middle mb-0>
            <thead style=background:#f8fafc;>
                <tr>
                    <th class=border-0 py-4>Feature</th>
                    @foreach (var product in Model)
                    {
                        <th class=border-0 py-4 text-center>
                            <a asp-action=Details asp-route-id=@product.Id class=text-decoration-none text-dark fw-bold>@product.Name</a>
                            <form asp-action=RemoveFromCompare asp-route-id=@product.Id class=mt-2>
                                <button type=submit class=btn btn-sm btn-outline-danger rounded-pill>
                                    <i class=bi bi-x-lg></i> Remove
                                </button>
                            </form>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                <tr style=background:#fafafa;>
                    <td class=fw-bold text-muted py-3>Image</td>
                    @foreach (var product in Model)
                    {
                        <td class=text-center py-3>
                            <img src="@product.ImageUrl" style="height:120px;object-fit:contain;" onerror="this.src='https://commercial.bunn.com/img/image-not-available.png'" />
                        </td>
                    }
                </tr>
                <tr>
                    <td class=fw-bold text-muted py-3>Price</td>
                    @foreach (var product in Model)
                    {
                        <td class=text-center fw-bold py-3 style=color:#10b981;>@product.SellingPrice.ToString("N0")</td>
                    }
                </tr>
                <tr style=background:#fafafa;>
                    <td class=fw-bold text-muted py-3>Category</td>
                    @foreach (var product in Model)
                    {
                        <td class=text-center py-3>@product.Category?.Name</td>
                    }
                </tr>
                <tr>
                    <td class=fw-bold text-muted py-3>Stock</td>
                    @foreach (var product in Model)
                    {
                        <td class=text-center py-3 @((product.Stock < 5) ? "text-danger" : "text-success")>@product.Stock units</td>
                    }
                </tr>
                <tr style=background:#fafafa;>
                    <td class=fw-bold text-muted py-3>Rating</td>
                    @foreach (var product in Model)
                    {
                        var avg = product.Reviews?.Any() == true ? product.Reviews.Average(r => r.Rating) : 0;
                        <td class=text-center py-3>
                            <span class=text-warning>@avg.ToString("N1")</span> / 5
                        </td>
                    }
                </tr>
                <tr>
                    <td class=py-4></td>
                    @foreach (var product in Model)
                    {
                        <td class=text-center py-4>
                            <a asp-controller=Cart asp-action=AddToCart asp-route-productId=@product.Id asp-route-quantity=1 class=btn btn-success rounded-pill>
                                <i class=bi bi-cart-plus me-1></i> Add to Cart
                            </a>
                        </td>
                    }
                </tr>
            </tbody>
        </table>
    </div>
    
    <div class=text-center mt-4>
        <a asp-action=ClearCompare class=btn btn-outline-secondary rounded-pill>
            <i class=bi bi-trash me-1></i> Clear Comparison
        </a>
    </div>
}

