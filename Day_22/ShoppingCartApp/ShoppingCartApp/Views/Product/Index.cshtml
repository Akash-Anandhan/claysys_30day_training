@model ShoppingCartApp.ViewModels.ProductPaginationViewModel
@{
    ViewData["Title"] = "All Products";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-2">
    <div>
        <h2 class="fw-bold mb-1" style="font-family: 'Space Grotesk', sans-serif; letter-spacing: -0.02em;">
            All Products
        </h2>
        <p class="text-muted mb-0">@Model.TotalProducts products found</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-secondary rounded-3 d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#filterPanel" aria-expanded="false">
            <i class="bi bi-funnel"></i> Filters
        </button>
    </div>
</div>

<!-- Filter Panel - Always visible on large screens, collapsible on mobile -->
<div class="collapse d-lg-block" id="filterPanel">
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 16px;">
        <div class="card-body p-4">
            <form asp-action="Index" method="get" id="filterForm" class="row g-3 align-items-end">
                <input type="hidden" name="page" value="1" />
                <div class="col-12 col-md-3">
                    <label class="form-label small fw-semibold text-muted">Category</label>
                    <select name="category" class="form-select rounded-3" asp-for="Category">
                        <option value="">All Categories</option>
                        @if (Model.Categories != null)
                        {
                            @foreach (var cat in Model.Categories)
                            {
                                <option value="@cat.Name">@cat.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small fw-semibold text-muted">Min Price</label>
                    <input type="number" name="minPrice" class="form-control rounded-3" placeholder="₹ Min" min="0" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small fw-semibold text-muted">Max Price</label>
                    <input type="number" name="maxPrice" class="form-control rounded-3" placeholder="₹ Max" min="0" />
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label small fw-semibold text-muted">Sort By</label>
                    <select name="sortBy" class="form-select rounded-3">
                        <option value="">Default (Newest)</option>
                        <option value="price_asc">Price: Low to High</option>
                        <option value="price_desc">Price: High to Low</option>
                        <option value="name_asc">Name: A to Z</option>
                        <option value="name_desc">Name: Z to A</option>
                    </select>
                </div>
                <div class="col-12 col-md-2">
                    <button type="submit" class="btn btn-dark w-100 rounded-3">
                        <i class="bi bi-search me-1"></i> Apply
                    </button>
                </div>
            </form>
            @if (!string.IsNullOrEmpty(Context.Request.Query["category"]) || Context.Request.Query.ContainsKey("minPrice") || Context.Request.Query.ContainsKey("maxPrice") || Context.Request.Query.ContainsKey("sortBy"))
            {
                <div class="mt-3 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-3">
                        <i class="bi bi-x-circle me-1"></i> Clear Filters
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@if (Model.Products != null && Model.Products.Any())
{
<div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4 mb-5">
    @foreach (var product in Model.Products)
    {
        var rating = product.Reviews?.Any() == true ? product.Reviews.Average(r => r.Rating) : 0;
        <div class="col product-card-wrapper" data-category-id="@product.CategoryId">
            <div class="card h-100 border-0 shadow-sm product-card" style="border-radius: 20px; transition: transform 0.3s, box-shadow 0.3s;">
                <button class="btn btn-light rounded-circle position-absolute wishlist-btn" style="top: 16px; right: 16px; z-index: 10;" onclick="addToWishlist(event, @product.Id)" data-id="@product.Id">
                    <i class="bi bi-heart"></i>
                </button>
                <div class="position-relative" style="border-radius: 20px 20px 0 0;">
                    <img src="@product.ImageUrl" class="card-img-top p-3" style="height: 180px; object-fit: contain;" alt="@product.Name" loading="lazy" onerror="this.src='https://commercial.bunn.com/img/image-not-available.png'" />
                </div>
                <div class="card-body">
                    <span class="badge" style="background: rgba(232,93,42,0.1); color: #e85d2a;">@product.Category?.Name</span>
                    <h5 class="fw-bold mt-2">@product.Name</h5>
                    <div class="d-flex align-items-center mb-2">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <i class="@(i <= rating ? "bi-star-fill" : "bi-star")" style="color: #fbbf24; font-size: 0.9rem;"></i>
                        }
                        <span class="text-muted small ms-1">(@rating.ToString("0.0"))</span>
                    </div>
                    <span class="fw-bold fs-5 mt-2 d-block" style="color: #e85d2a;">Rs. @product.SellingPrice.ToString("0.00")</span>
                </div>
                <div class="card-footer bg-transparent border-0 px-4 pb-4 d-flex gap-2">
                    <a asp-action="Details" asp-route-id="@product.Id" class="btn rounded-pill flex-fill" style="background: #f3f4f6;">
                        <i class="bi bi-eye"></i> View
                    </a>
                    <button type="button" class="btn w-100 rounded-pill text-white" style="background: #111827;" onclick="addToCartAjax(event, @product.Id, 1)">
                        <i class="bi bi-cart-plus"></i> Add
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@if (Model.TotalPages > 1)
{
    <nav aria-label="Product pagination" class="d-flex justify-content-center mt-4">
        <ul class="pagination pagination-lg">
            @{var curPage = Model.CurrentPage; var totPages = Model.TotalPages;}
            <li class="page-item @(curPage <= 1 ? "disabled" : "")">
                <a class="page-link rounded-pill mx-1" asp-action="Index" asp-route-page="@(curPage - 1)" asp-route-query="@Model.SearchQuery" asp-route-category="@Model.Category" asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice" asp-route-sortBy="@Model.SortBy" style="color: #4b5563; border: 1px solid #e5e7eb;"><i class="bi bi-chevron-left"></i></a>
            </li>
            @{var s = Math.Max(1, curPage - 2); var e = Math.Min(totPages, curPage + 2);}
            @for (var i = s; i <= e; i++)
            {
                <li class="page-item @(i == curPage ? "active" : "")">
                    <a class="page-link rounded-pill mx-1" asp-action="Index" asp-route-page="@i" asp-route-query="@Model.SearchQuery" asp-route-category="@Model.Category" asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice" asp-route-sortBy="@Model.SortBy" style="@(i == curPage ? "background:#111827;color:#fff;border-color:#111827;" : "color:#4b5563;border:1px solid #e5e7eb;")">@i</a>
                </li>
            }
            <li class="page-item @(curPage >= totPages ? "disabled" : "")">
                <a class="page-link rounded-pill mx-1" asp-action="Index" asp-route-page="@(curPage + 1)" asp-route-query="@Model.SearchQuery" asp-route-category="@Model.Category" asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice" asp-route-sortBy="@Model.SortBy" style="color: #4b5563; border: 1px solid #e5e7eb;"><i class="bi bi-chevron-right"></i></a>
            </li>
        </ul>
    </nav>
}
}
else
{
    <div class="text-center py-5 my-5 rounded-4" style="background: rgba(248,250,252,0.8); border: 1px dashed #cbd5e1;">
        <div class="d-inline-flex justify-content-center align-items-center rounded-circle mb-3 bg-white shadow-sm text-muted" style="width:100px;height:100px;font-size:3rem;">
            <i class="bi bi-bag-x"></i>
        </div>
        <h3 class="fw-bold">No products found</h3>
        <p class="text-muted">Try adjusting your search criteria.</p>
        <a asp-action="Index" class="btn btn-primary btn-lg rounded-pill px-5">Browse All Products</a>
    </div>
}

<style>
    .product-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 16px 40px rgba(0,0,0,0.08) !important;
    }
    .product-card:hover .card-img-top {
        transform: scale(1.05);
    }
    .page-item.active .page-link { background: #111827 !important; border-color: #111827 !important; }
    .page-item.disabled .page-link { color: #9ca3af; }
    
    .wishlist-btn {
        transition: all 0.2s ease;
    }
    .wishlist-btn:hover {
        transform: scale(1.1);
    }
    .wishlist-btn.in-wishlist {
        color: #ef4444;
    }
</style>

@section Scripts {
<script>
function addToWishlist(event, productId) {
    event.preventDefault();
    event.stopPropagation();

    @if (!User.Identity.IsAuthenticated)
    {
        <text>
        window.location.href = '/Account/Login';
        return;
        </text>
    }

    var btn = event.currentTarget;
    var isInWishlist = btn.classList.contains('in-wishlist');
    var token = document.querySelector('input[id="af-token"]') ? document.querySelector('input[id="af-token"]').value : '';

    var endpoint = isInWishlist ? '/Wishlist/RemoveFromWishlist' : '/Wishlist/Add';
    
    fetch(endpoint + '?productId=' + productId, {
        method: 'POST',
        headers: {
            'RequestVerificationToken': token
        }
    })
    .then(function(response) { return response.json(); })
    .then(function(data) {
        if (data.success) {
            if (isInWishlist) {
                btn.innerHTML = '<i class="bi bi-heart"></i>';
                btn.classList.remove('in-wishlist');
                showToast('Removed from wishlist', 'info');
            } else {
                btn.innerHTML = '<i class="bi bi-heart-fill"></i>';
                btn.classList.add('in-wishlist');
                showToast('Added to wishlist!', 'success');
            }
            updateWishlistBadge();
        } else {
            showToast(data.message || 'Error updating wishlist', 'error');
        }
    })
    .catch(function(err) { 
        console.error(err);
        showToast('Error updating wishlist', 'error'); 
    });
}

async function addToCartAjax(event, productId, quantity) {
    event.preventDefault();
    event.stopPropagation();
    
    var token = document.querySelector('input[id="af-token"]') ? document.querySelector('input[id="af-token"]').value : '';
    var btn = event.currentTarget;
    var originalContent = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>';
    
    try {
        var response = await fetch('/Cart/AddToCart?productId=' + productId + '&quantity=' + quantity, {
            method: 'POST',
            headers: {
                'RequestVerificationToken': token
            }
        });
        
        if (response.ok || response.redirected) {
            updateCartBadge();
            showToast('Added to cart!', 'success');
        } else {
            showToast('Error adding to cart', 'error');
        }
    } catch (error) {
        console.error('Error:', error);
        showToast('Error adding to cart', 'error');
    } finally {
        btn.disabled = false;
        btn.innerHTML = originalContent;
    }
}

function showToast(message, type) {
    var toast = document.createElement('div');
    toast.className = 'alert alert-' + (type === 'success' ? 'success' : type === 'error' ? 'danger' : 'info') + ' position-fixed';
    toast.style.cssText = 'top:20px;right:20px;z-index:9999;min-width:250px;animation:slideIn 0.3s ease;';
    var icon = type === 'success' ? 'bi-check-circle-fill' : type === 'error' ? 'bi-x-circle-fill' : 'bi-info-circle-fill';
    toast.innerHTML = '<i class="bi ' + icon + ' me-2"></i>' + message;
    document.body.appendChild(toast);
    setTimeout(function() {
        toast.style.opacity = '0';
        toast.style.transition = 'opacity 0.3s ease';
        setTimeout(function() { toast.remove(); }, 300);
    }, 3000);
}

async function updateCartBadge() {
    try {
        var response = await fetch('/Cart/GetCartCount');
        if (response.ok) {
            var data = await response.json();
            var badge = document.getElementById('cart-count');
            if (badge) {
                badge.textContent = data.count || 0;
                badge.style.display = (data.count > 0) ? 'inline' : 'none';
            }
        }
    } catch (e) {}
}

async function updateWishlistBadge() {
    try {
        var response = await fetch('/Wishlist/GetWishlistCount');
        if (response.ok) {
            var data = await response.json();
            var badge = document.getElementById('wishlist-count');
            if (badge) {
                badge.textContent = data.count || 0;
                badge.style.display = (data.count > 0) ? 'inline' : 'none';
            }
        }
    } catch (e) {}
}

// Initialize wishlist button states on page load
document.addEventListener('DOMContentLoaded', function() {
    @if (User.Identity.IsAuthenticated)
    {
        <text>
        fetch('/Wishlist/GetWishlistIds')
            .then(function(response) { return response.json(); })
            .then(function(ids) {
                ids.forEach(function(id) {
                    var btn = document.querySelector('[data-id="' + id + '"]');
                    if (btn && btn.classList.contains('wishlist-btn')) {
                        btn.innerHTML = '<i class="bi bi-heart-fill"></i>';
                        btn.classList.add('in-wishlist');
                    }
                });
            })
            .catch(function() {});
        </text>
    }
});
</script>
}