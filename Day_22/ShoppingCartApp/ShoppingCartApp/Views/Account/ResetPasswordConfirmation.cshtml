@{
    ViewData["Title"] = "Reset password confirmation";
}

<div class="row justify-content-center mt-5 text-center">
    <div class="col-md-6 col-lg-5">
        <div class="d-inline-flex justify-content-center align-items-center rounded-circle mb-4" style="width: 80px; height: 80px; background: rgba(16,185,129,0.1);">
            <i class="bi bi-shield-check" style="font-size: 2.5rem; color: #10b981;"></i>
        </div>
        <h2 class="fw-bold mb-3" style="font-family: 'Space Grotesk', sans-serif;">Password Reset Complete</h2>
        <p class="text-muted mb-4">
            Your password has been successfully reset.
        </p>
        <a asp-action="Login" class="btn btn-primary rounded-pill px-5 fw-bold" style="background: #3b82f6;">Log in</a>
    </div>
</div>
