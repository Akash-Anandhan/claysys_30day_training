@model ShoppingCartApp.ViewModels.OrderPaginationViewModel

@{
    ViewData["Title"] = "My Orders";
    var statusOptions = new[] { "All", "Pending", "Processing", "Shipped", "Delivered", "Cancelled" };
    var hasFilters = !string.IsNullOrEmpty(Model.Status) || Model.FromDate.HasValue || Model.ToDate.HasValue;
    var fromDateStr = Model.FromDate.HasValue ? Model.FromDate.Value.ToString("yyyy-MM-dd") : "";
    var toDateStr = Model.ToDate.HasValue ? Model.ToDate.Value.ToString("yyyy-MM-dd") : "";
}

<div class="d-flex align-items-center mb-4 mt-2 border-bottom pb-3">
    <h2 class="fw-bold mb-0" style="font-family: 'Space Grotesk', sans-serif; letter-spacing: -0.02em; color: #111827;">
        <i class="bi bi-box-seam text-brand me-2"></i> My Orders
    </h2>
</div>

<!-- Filter Panel -->
<div class="card border-0 shadow-sm mb-4" style="border-radius: 16px;">
    <div class="card-body p-4">
        <form asp-action="Orders" method="get" class="row g-3 align-items-end">
            <input type="hidden" name="page" value="1" />
            <div class="col-12 col-md-3">
                <label class="form-label small fw-semibold text-muted">Status</label>
                <select name="status" class="form-select rounded-3">
                    @foreach (var status in statusOptions)
                    {
                        var isSelected = (string.IsNullOrEmpty(Model.Status) && status == "All") || status == Model.Status;
                        <option value="@status" selected="@isSelected">@status</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small fw-semibold text-muted">From Date</label>
                <input type="date" name="fromDate" class="form-control rounded-3" value="@fromDateStr" />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small fw-semibold text-muted">To Date</label>
                <input type="date" name="toDate" class="form-control rounded-3" value="@toDateStr" />
            </div>
            <div class="col-12 col-md-3">
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-dark rounded-3 flex-fill">
                        <i class="bi bi-funnel me-1"></i> Apply Filters
                    </button>
                    @if (hasFilters)
                    {
                        <a asp-action="Orders" class="btn btn-outline-secondary rounded-3" title="Clear Filters">
                            <i class="bi bi-x-circle"></i>
                        </a>
                    }
                </div>
            </div>
            <div class="col-12 col-md-2">
                @if (Model.Orders != null && Model.Orders.Any())
                {
                    <span class="text-muted small"><span class="fw-semibold">@Model.TotalOrders</span> total</span>
                }
            </div>
        </form>
    </div>
</div>

<!-- Orders List -->
<div class="row g-4 pb-5">
    @if (Model.Orders == null || !Model.Orders.Any())
    {
        <div class="col-12 text-center py-5">
            <div class="p-5 bg-light rounded-4">
                <i class="bi bi-basket-fill text-muted" style="font-size: 3rem;"></i>
                @if (hasFilters)
                {
                    <h4 class="mt-3 fw-bold text-gray-700">No orders match your filters</h4>
                    <p class="text-muted mb-4">Try adjusting the filter criteria to see more results.</p>
                    <a asp-action="Orders" class="btn btn-outline-dark fw-bold px-4 py-2 rounded-pill">Clear Filters</a>
                }
                else
                {
                    <h4 class="mt-3 fw-bold text-gray-700">No orders yet</h4>
                    <p class="text-muted mb-4">Looks like you haven't placed any orders yet.</p>
                    <a asp-controller="Product" asp-action="Index" class="btn btn-brand text-white fw-bold px-4 py-2 rounded-pill">Start Shopping</a>
                }
            </div>
        </div>
    }
    else
    {
        @foreach (var order in Model.Orders)
        {
            var badgeClass = order.Status == "Delivered" ? "bg-success" :
                             order.Status == "Pending" ? "bg-warning text-dark" :
                             order.Status == "Cancelled" ? "bg-danger" : "bg-primary";
            <div class="col-12">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-2">
                    <div class="card-header bg-light border-bottom-0 py-3 px-4 d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted text-uppercase small fw-semibold d-block">Order #@order.Id</span>
                            <span class="fw-bold">Placed on @order.OrderDate.ToString("MMM dd, yyyy")</span>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <h5 class="mb-0 fw-bold text-brand">Rs.@order.TotalAmount.ToString("N0")</h5>
                            <span class="badge rounded-pill @badgeClass">@order.Status</span>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <ul class="list-group list-group-flush">
                            @foreach (var item in order.OrderItems)
                            {
                                <li class="list-group-item d-flex align-items-center p-4">
                                    <img src="@item.Product.ImageUrl" width="60" height="60" class="rounded-3 shadow-sm border me-3" style="object-fit: cover;" alt="@item.Product.Name" loading="lazy" onerror="this.src='https://commercial.bunn.com/img/image-not-available.png'" />
                                    <div class="flex-grow-1">
                                        <h6 class="fw-bold mb-1"><a asp-controller="Product" asp-action="Details" asp-route-id="@item.ProductId" class="text-dark text-decoration-none">@item.Product.Name</a></h6>
                                        <p class="mb-0 text-muted small">Qty: @item.Quantity x Rs.@item.SellingPrice.ToString("N0")</p>
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                    <div class="card-footer bg-white border-top py-3 px-4 d-flex justify-content-end gap-2">
                        <a asp-action="TrackOrder" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                            <i class="bi bi-geo-alt me-1"></i> Track Order
                        </a>
                        @if (order.Status == "Pending")
                        {
                            <form asp-action="CancelOrder" method="post" onsubmit="return confirm('Are you sure you want to cancel this order?');">
                                <input type="hidden" name="id" value="@order.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">Cancel Order</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }

        @if (Model.TotalPages > 1)
        {
            var startPage = Math.Max(1, Model.CurrentPage - 2);
            var endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
            if (endPage - startPage < 4)
            {
                if (startPage == 1) endPage = Math.Min(5, Model.TotalPages);
                else if (endPage == Model.TotalPages) startPage = Math.Max(1, Model.TotalPages - 4);
            }
            <div class="col-12 d-flex justify-content-center mt-4">
                <nav aria-label="Order pagination">
                    <ul class="pagination">
                        @if (Model.CurrentPage > 1)
                        {
                            <li class="page-item">
         
                                <a class="page-link" asp-action="Orders" asp-route-page="@(Model.CurrentPage - 1)" asp-route-status="@Model.Status" asp-route-fromDate="@fromDateStr" asp-route-toDate="@toDateStr">Previous</a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled"><span class="page-link">Previous</span></li>
                        }

                        @if (startPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="Orders" asp-route-page="1" asp-route-status="@Model.Status" asp-route-fromDate="@fromDateStr" asp-route-toDate="@toDateStr">1</a>
                            </li>
                            @if (startPage > 2)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                        }

                        @for (var i = startPage; i <= endPage; i++)
                        {
                            if (i == Model.CurrentPage)
                            {
                                <li class="page-item active"><span class="page-link">@i</span></li>
                            }
                            else
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-action="Orders" asp-route-page="@i" asp-route-status="@Model.Status" asp-route-fromDate="@fromDateStr" asp-route-toDate="@toDateStr">@i</a>
                                </li>
                            }
                        }

                        @if (endPage < Model.TotalPages)
                        {
                            @if (endPage < Model.TotalPages - 1)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                            <li class="page-item">
                                <a class="page-link" asp-action="Orders" asp-route-page="@Model.TotalPages" asp-route-status="@Model.Status" asp-route-fromDate="@fromDateStr" asp-route-toDate="@toDateStr">@Model.TotalPages</a>
                            </li>
                        }

                        @if (Model.CurrentPage < Model.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="Orders" asp-route-page="@(Model.CurrentPage + 1)" asp-route-status="@Model.Status" asp-route-fromDate="@fromDateStr" asp-route-toDate="@toDateStr">Next</a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled"><span class="page-link">Next</span></li>
                        }
                    </ul>
                </nav>
            </div>
            <div class="col-12 text-center mb-4">
                <span class="text-muted small">Page @Model.CurrentPage of @Model.TotalPages - Showing @(((Model.CurrentPage - 1) * Model.PageSize) + 1)-@Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalOrders) of @Model.TotalOrders orders</span>
            </div>
        }
    }
</div>
