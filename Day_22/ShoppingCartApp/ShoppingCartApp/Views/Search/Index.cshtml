@model ShoppingCartApp.ViewModels.SearchViewModel
@{
    ViewData["Title"] = string.IsNullOrEmpty(Model.Query)
        ? "Search Products" : $"Results for '{Model.Query}'";
}

<div class="d-flex align-items-center mb-4 mt-2">
    <div>
        <h2 class="fw-bold mb-1" style="font-family: 'Space Grotesk', sans-serif; letter-spacing: -0.02em;">
            <i class="bi bi-search text-primary me-2"></i> Search Products
        </h2>
        @if (!string.IsNullOrEmpty(Model.Query))
        {
            <p class="text-muted mb-0 fs-5 mt-2">
                Found <strong class="text-dark">@Model.TotalResults</strong> result(s) for "<strong class="text-primary">@Model.Query</strong>"
            </p>
        }
    </div>
</div>

<div class="row g-5">
    <!-- Filters Sidebar -->
    <div class="col-lg-3">
        <div class="card border-0 shadow-sm sticky-top" style="top: 100px; border-radius: 20px; overflow: hidden; background: #fff;">
            <div class="card-header bg-white border-bottom-0 py-4 px-4 d-flex align-items-center">
                <i class="bi bi-funnel-fill text-muted me-2 border rounded-circle d-flex align-items-center justify-content-center bg-light" style="width: 32px; height: 32px;"></i>
                <h6 class="mb-0 fw-bold" style="font-family: 'Space Grotesk', sans-serif; font-size: 1.1rem;">Filters</h6>
            </div>
            <div class="card-body p-4 pt-0">
                <form asp-action="Index" method="get" id="filter-form">
                    <!-- Search query (hidden, carried over) -->
                    <input type="hidden" name="query" value="@Model.Query" />

                    <!-- Category Filter -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold text-muted small text-uppercase" style="letter-spacing: 0.5px;">Category</label>
                        <select name="category" class="form-select form-select-lg" style="border-radius: 12px; font-size: 0.95rem; border: 1px solid #e5e7eb;" onchange="document.getElementById('filter-form').submit()">
                            <option value="">All Categories</option>
                            @foreach (var cat in Model.Categories)
                            {
                                <option value="@cat.Name" selected="@(Model.Category == cat.Name)">
                                    @cat.Name
                                </option>
                            }
                        </select>
                    </div>

                    <!-- Price Range -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold text-muted small text-uppercase" style="letter-spacing: 0.5px;">Price Range</label>
                        <div class="d-flex align-items-center gap-2">
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0" style="border-radius: 12px 0 0 12px;">₹</span>
                                <input type="number" name="minPrice" value="@Model.MinPrice" class="form-control border-start-0 ps-0" placeholder="Min" min="0" style="border-radius: 0 12px 12px 0;" />
                            </div>
                            <span class="text-muted fw-bold">-</span>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0" style="border-radius: 12px 0 0 12px;">₹</span>
                                <input type="number" name="maxPrice" value="@Model.MaxPrice" class="form-control border-start-0 ps-0" placeholder="Max" min="0" style="border-radius: 0 12px 12px 0;" />
                            </div>
                        </div>
                    </div>

                    <!-- Sort By -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold text-muted small text-uppercase" style="letter-spacing: 0.5px;">Sort By</label>
                        <select name="sortBy" class="form-select form-select-lg" style="border-radius: 12px; font-size: 0.95rem; border: 1px solid #e5e7eb;" onchange="document.getElementById('filter-form').submit()">
                            <option value="">Default</option>
                            <option value="price_asc" selected="@(Model.SortBy == "price_asc")">Price: Low to High</option>
                            <option value="price_desc" selected="@(Model.SortBy == "price_desc")">Price: High to Low</option>
                            <option value="name_asc" selected="@(Model.SortBy == "name_asc")">Name: A to Z</option>
                            <option value="name_desc" selected="@(Model.SortBy == "name_desc")">Name: Z to A</option>
                            <option value="newest" selected="@(Model.SortBy == "newest")">Newest First</option>
                        </select>
                    </div>

                    <div class="d-flex flex-column gap-2 mt-2">
                        <button type="submit" class="btn w-100 rounded-pill text-white fw-bold py-2 shadow-sm" style="background: #111827; border: none; transition: background 0.2s ease;" onmouseover="this.style.background='#1f2937'" onmouseout="this.style.background='#111827'">
                            Apply Filters
                        </button>
                        
                        @if (!string.IsNullOrEmpty(Model.Category) || Model.MinPrice.HasValue || Model.MaxPrice.HasValue || !string.IsNullOrEmpty(Model.SortBy))
                        {
                            <a asp-action="Index" asp-route-query="@Model.Query" class="btn w-100 rounded-pill fw-semibold py-2" style="background: #f1f5f9; color: #4b5563; transition: background 0.2s ease;" onmouseover="this.style.background='#e2e8f0'" onmouseout="this.style.background='#f1f5f9'">
                                Clear Filters
                            </a>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Results -->
    <div class="col-lg-9">
        @if (!Model.Results.Any())
        {
            <div class="text-center py-5 my-5 rounded-4 shadow-sm" style="background: rgba(248, 250, 252, 0.8); border: 1px dashed #cbd5e1;">
                <div class="d-inline-flex justify-content-center align-items-center rounded-circle mb-3 bg-white shadow-sm text-muted" style="width: 100px; height: 100px; font-size: 3rem;">
                    <i class="bi bi-search"></i>
                </div>
                <h3 class="fw-bold text-dark mt-2" style="font-family: 'Space Grotesk', sans-serif;">No products found</h3>
                <p class="text-muted mb-4 fs-5">Try a different search term or clear the filters.</p>
                <a asp-action="Index" class="btn btn-dark btn-lg rounded-pill px-5 fw-bold shadow-sm">
                    Clear Search
                </a>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4 mb-5">
                @foreach (var product in Model.Results)
                {
                    var avgRating = product.Reviews != null && product.Reviews.Any() ? product.Reviews.Average(r => r.Rating) : 0;

                    <div class="col">
                        <div class="card h-100 border-0 shadow-sm product-card" style="border-radius: 20px; transition: all 0.3s ease; overflow: hidden; background: #fff;">
                            <div class="position-relative overflow-hidden" style="border-radius: 20px 20px 0 0;">
                                <img src="@product.ImageUrl" class="card-img-top p-3" alt="@product.Name" style="height: 240px; object-fit: contain; background-color: #fafafa; transition: transform 0.5s ease;" onerror="this.src='https://commercial.bunn.com/img/image-not-available.png'" />
                                <div class="position-absolute top-0 end-0 p-3 d-flex flex-column gap-2 align-items-end">
                                    <span class="badge rounded-pill bg-white text-dark shadow-sm px-3 py-2 fw-bold" style="font-family: 'Space Grotesk', sans-serif;">₹@product.SellingPrice.ToString("0.00")</span>
                                </div>
                                <div class="position-absolute top-0 start-0 p-3">
                                    <span class="badge rounded-pill shadow-sm" style="background: rgba(255,255,255,0.9); color: #e85d2a; backdrop-filter: blur(4px); font-weight: 600;">@product.Category?.Name</span>
                                </div>
                            </div>
                            <div class="card-body p-4">
                                <h5 class="card-title fw-bold mb-2 text-dark" style="font-family: 'Space Grotesk', sans-serif;">@product.Name</h5>
                                <p class="card-text text-muted small mb-3" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">@product.Description</p>
                                
                                <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-3">
                                    <div class="d-flex align-items-center gap-1 rounded bg-light px-2 py-1">
                                        <i class="bi bi-star-fill text-warning" style="font-size: 0.8rem;"></i>
                                        <span class="fw-bold small ms-1">@(avgRating.ToString("0.0"))</span>
                                        <span class="text-muted small ms-1">(@(product.Reviews?.Count ?? 0))</span>
                                    </div>
                                    <div class="d-flex align-items-center text-muted small fw-medium">
                                        <i class="bi bi-box-seam me-1 text-success" style="font-size: 0.8rem;"></i>
                                        <span style="@(product.Stock < 5 ? "color: #ef4444;" : "")">@product.Stock stock</span>
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer bg-transparent border-0 px-4 pb-4 pt-0 d-flex flex-column gap-2 mt-auto">
                                <div class="d-flex gap-2">
                                    <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" class="btn rounded-pill flex-fill fw-semibold" style="background: #f3f4f6; color: #4b5563; border: none; transition: background 0.2s ease;" onmouseover="this.style.background='#e5e7eb'" onmouseout="this.style.background='#f3f4f6'">
                                        <i class="bi bi-eye"></i> View
                                    </a>
                                    <form asp-controller="Cart" asp-action="AddToCart" method="post" class="flex-fill add-to-cart-form">
                                        <input type="hidden" name="productId" value="@product.Id" />
                                        <input type="hidden" name="quantity" value="1" />
                                        <button type="submit" class="btn w-100 rounded-pill text-white fw-semibold shadow-sm" style="background: #111827; border: none; transition: background 0.2s ease;" onmouseover="this.style.background='#1f2937'" onmouseout="this.style.background='#111827'">
                                            <i class="bi bi-cart-plus"></i> Add
                                        </button>
                                    </form>
                                </div>
                                <form asp-controller="Wishlist" asp-action="Add" method="post">
                                    <input type="hidden" name="productId" value="@product.Id" />
                                    <button type="submit" class="btn w-100 rounded-pill fw-semibold" style="background: rgba(239,68,68,0.05); color: #ef4444; border: 1px solid rgba(239,68,68,0.1); transition: all 0.2s ease;" onmouseover="this.style.background='#ef4444'; this.style.color='#fff';" onmouseout="this.style.background='rgba(239,68,68,0.05)'; this.style.color='#ef4444';">
                                        <i class="bi bi-heart me-1"></i> Add to Wishlist
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<style>
    .product-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 16px 40px rgba(0,0,0,0.08) !important;
    }
    .product-card:hover .card-img-top {
        transform: scale(1.05);
    }
    .form-control:focus, .form-select:focus {
        border-color: #3b82f6 !important;
        box-shadow: 0 0 0 4px rgba(59,130,246,0.1) !important;
    }
</style>