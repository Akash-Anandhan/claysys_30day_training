@model ShoppingCartClient.Models.ProductDto
@{
    ViewData["Title"] = "Edit Product";
}

<div class="row pt-4 pb-3">
    <div class="col-6">
        <h2 class="text-primary fw-bold" style="font-family: 'Space Grotesk', sans-serif; letter-spacing: -0.02em;">Edit Product</h2>
    </div>
    <div class="col-6 text-end">
        <a asp-action="Products" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Products
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm p-4" style="border-radius: 16px;">
    <form asp-action="EditProduct" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 font-weight-bold"></div>
        <input type="hidden" asp-for="Id" />

        <div class="row">
            <div class="col-md-6 mb-4">
                <label asp-for="Name" class="form-label fw-semibold">Product Name</label>
                <input asp-for="Name" class="form-control" style="border-radius: 12px;" required />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="col-md-6 mb-4">
                <label asp-for="CategoryName" class="form-label fw-semibold">Category Name</label>
                <input asp-for="CategoryName" class="form-control" style="border-radius: 12px;" required />
                <span asp-validation-for="CategoryName" class="text-danger small"></span>
            </div>
            
            <div class="col-12 mb-4">
                <label asp-for="Description" class="form-label fw-semibold">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3" style="border-radius: 12px;"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="col-md-4 mb-4">
                <label asp-for="Price" class="form-label fw-semibold">Price</label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input asp-for="Price" type="number" step="0.01" class="form-control" required />
                </div>
                <span asp-validation-for="Price" class="text-danger small"></span>
            </div>

            <div class="col-md-4 mb-4">
                <label asp-for="Stock" class="form-label fw-semibold">Stock Quantity</label>
                <input asp-for="Stock" type="number" class="form-control" required />
                <span asp-validation-for="Stock" class="text-danger small"></span>
            </div>

            <div class="col-md-4 mb-4">
                <label asp-for="CategoryId" class="form-label fw-semibold">Category ID</label>
                <input asp-for="CategoryId" type="number" class="form-control" required />
                <span asp-validation-for="CategoryId" class="text-danger small"></span>
            </div>

            <div class="col-12 mb-4">
                <label asp-for="ImageUrl" class="form-label fw-semibold">Image URL</label>
                <input asp-for="ImageUrl" type="url" class="form-control" style="border-radius: 12px;" />
                <span asp-validation-for="ImageUrl" class="text-danger small"></span>
            </div>
        </div>

        <button type="submit" class="btn text-white rounded-pill px-5 py-2 fw-bold" style="background:#e85d2a; box-shadow: 0 4px 12px rgba(232,93,42,0.3);">
            Update Product
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
