@model ShoppingCartClient.Models.CheckoutDto
@{
    ViewData["Title"] = "Checkout";
}

<div class="row pt-4 pb-3">
    <div class="col-12 text-center">
        <h2 class="text-primary fw-bold" style="font-family: 'Space Grotesk', sans-serif; letter-spacing: -0.02em;">Secure Checkout</h2>
        <p class="text-muted">Complete your order swiftly and securely.</p>
    </div>
</div>

<div class="row justify-content-center mb-5">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm p-4" style="border-radius: 16px;">
            <form asp-action="Checkout" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 font-weight-bold"></div>

                <div class="mb-4">
                    <label asp-for="ShippingAddress" class="form-label fw-semibold">Shipping Address</label>
                    <textarea asp-for="ShippingAddress" class="form-control" rows="3" placeholder="123 Main St, Appt 4B, New York, NY 10001" required style="border-radius: 12px;"></textarea>
                    <span asp-validation-for="ShippingAddress" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="PaymentType" class="form-label fw-semibold">Payment Method</label>
                    <select asp-for="PaymentType" class="form-select" required style="border-radius: 12px;">
                        <option value="">Select Payment Method...</option>
                        <option value="CreditCard">Credit Card</option>
                        <option value="PayPal">PayPal</option>
                    </select>
                    <span asp-validation-for="PaymentType" class="text-danger small"></span>
                </div>

                <div class="mb-4" id="payment-id-div" style="display:none;">
                    <label asp-for="PaymentId" class="form-label fw-semibold">Card / Account Ref</label>
                    <input asp-for="PaymentId" class="form-control" placeholder="**** **** **** 1234" style="border-radius: 12px;" />
                    <span asp-validation-for="PaymentId" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="TransactionId" class="form-label fw-semibold">Transaction ID (Optional)</label>
                    <input asp-for="TransactionId" class="form-control" placeholder="ABC-123-XYZ" style="border-radius: 12px;" />
                    <span asp-validation-for="TransactionId" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn w-100 text-white rounded-pill py-2 fw-bold" style="background:#e85d2a; box-shadow: 0 4px 12px rgba(232,93,42,0.3);">
                    Confirm & Pay
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('PaymentType').addEventListener('change', function (e) {
            var val = e.target.value;
            if (val === 'CreditCard' || val === 'PayPal') {
                document.getElementById('payment-id-div').style.display = 'block';
            } else {
                document.getElementById('payment-id-div').style.display = 'none';
            }
        });
    </script>
}
