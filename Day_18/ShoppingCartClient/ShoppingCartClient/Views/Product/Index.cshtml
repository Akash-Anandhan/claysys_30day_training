@model IEnumerable<ProductDto>
@{
    var title = ViewData["Title"] as string ?? "All Products";
    ViewData["Title"] = title;
}

<div class="d-flex justify-content-between align-items-center mb-5 mt-2">
    <div>
        <h2 class="fw-bold mb-1" style="font-family: 'Space Grotesk', sans-serif; letter-spacing: -0.02em;">
            @title
        </h2>
        <p class="text-muted mb-0">Browse our complete collection</p>
    </div>
</div>

<div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4 mb-5">
    @foreach (var product in Model)
    {
        <div class="col">
            <div class="card h-100 border-0 shadow-sm product-card" style="border-radius: 20px; transition: all 0.3s ease; overflow: hidden; background: #fff;">
                <div class="position-relative overflow-hidden" style="border-radius: 20px 20px 0 0;">
                    <img src="@product.ImageUrl" class="card-img-top p-3" alt="@product.Name" style="height: 240px; object-fit: contain; background-color: #fafafa; transition: transform 0.5s ease;" />
                    <div class="position-absolute top-0 end-0 p-3 d-flex flex-column gap-2 align-items-end">
                        <span class="badge rounded-pill bg-white text-dark shadow-sm px-3 py-2 fw-bold" style="font-family: 'Space Grotesk', sans-serif;">$@product.Price.ToString("0.00")</span>
                    </div>
                    <div class="position-absolute top-0 start-0 p-3">
                        <span class="badge rounded-pill shadow-sm" style="background: rgba(255,255,255,0.9); color: #e85d2a; backdrop-filter: blur(4px); font-weight: 600;">@product.CategoryName</span>
                    </div>
                </div>
                <div class="card-body p-4">
                    <h5 class="card-title fw-bold mb-2 text-dark" style="font-family: 'Space Grotesk', sans-serif;">@product.Name</h5>
                    <p class="card-text text-muted small mb-3" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">@product.Description</p>
                    <div class="d-flex align-items-center text-muted small fw-medium mt-auto">
                        <div class="d-flex align-items-center justify-content-center rounded-circle me-2" style="width: 24px; height: 24px; background: rgba(16,185,129,0.1);">
                            <i class="bi bi-box-seam" style="color: #10b981; font-size: 11px;"></i>
                        </div>
                        <span style="@(product.Stock < 5 ? "color: #ef4444;" : "")">@product.Stock in stock</span>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 px-4 pb-4 pt-0 d-flex flex-column gap-2">
                    <div class="d-flex gap-2">
                        <a asp-action="Details" asp-route-id="@product.Id" class="btn rounded-pill flex-fill fw-semibold" style="background: #f3f4f6; color: #4b5563; border: none; transition: background 0.2s ease;" onmouseover="this.style.background='#e5e7eb'" onmouseout="this.style.background='#f3f4f6'">
                            <i class="bi bi-eye"></i> View
                        </a>
                        <form asp-controller="Wishlist" asp-action="Add" method="post" class="m-0">
                            <input type="hidden" name="productId" value="@product.Id" />
                            <button type="submit" class="btn btn-outline-danger rounded-pill px-3 shadow-sm" style="transition: all 0.2s ease;" onmouseover="this.style.backgroundColor='#fee2e2'" onmouseout="this.style.backgroundColor='transparent'">
                                <i class="bi bi-heart"></i>
                            </button>
                        </form>
                    </div>
                    
                    <button onclick="addToCartAjax(@product.Id)" class="btn w-100 rounded-pill text-white fw-semibold shadow-sm mt-1" style="background: #111827; border: none; transition: background 0.2s ease;" onmouseover="this.style.background='#1f2937'" onmouseout="this.style.background='#111827'">
                        <i class="bi bi-cart-plus"></i> Add to Cart
                    </button>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .product-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 16px 40px rgba(0,0,0,0.08) !important;
    }
    .product-card:hover .card-img-top {
        transform: scale(1.05);
    }
</style>

@section Scripts {
    <script>
        function addToCartAjax(productId) {
            fetch('/Cart/AddToCartAjax', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? ''
                },
                body: `productId=${productId}&quantity=1`
            })
            .then(res => res.json())
            .then(data => {
                if(data.success) {
                    var badge = document.getElementById('cart-count');
                    if(badge) badge.innerText = data.cartCount;
                } else {
                    if(data.redirectUrl) {
                        window.location.href = data.redirectUrl;
                    } else {
                        alert('Could not add to cart.');
                    }
                }
            })
            .catch(err => console.error(err));
        }
    </script>
}