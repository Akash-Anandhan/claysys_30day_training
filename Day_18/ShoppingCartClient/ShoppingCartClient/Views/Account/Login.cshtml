@model LoginDto
@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center" style="margin-top: 4rem; margin-bottom: 4rem;">
    <div class="col-md-5 col-lg-4">
        <div class="card border-0 shadow-sm" style="border-radius: 20px; overflow: hidden; box-shadow: 0 20px 40px rgba(0,0,0,0.04) !important; border: 1px solid rgba(0,0,0,0.05) !important;">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 64px; height: 64px; background: rgba(232,93,42,0.1);">
                        <i class="bi bi-box-arrow-in-right" style="color: #e85d2a; font-size: 1.8rem;"></i>
                    </div>
                    <h3 class="fw-bold mb-1" style="font-family: 'Space Grotesk', sans-serif; letter-spacing: -0.02em;">Welcome Back</h3>
                    <p class="mb-0" style="color: #6b7280; font-size: 0.95rem;">Please enter your details to sign in.</p>
                </div>

                <form asp-action="Login" method="post">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="All" class="alert alert-danger" style="border-radius: 12px; font-size: 0.9rem;"></div>
                    }

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold" style="font-size: 0.9rem; color: #374151;"></label>
                        <input asp-for="Email" class="form-control" placeholder="john@example.com" style="border-radius: 12px; padding: 0.75rem 1rem; border: 1px solid #e5e7eb;" />
                        <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold" style="font-size: 0.9rem; color: #374151;"></label>
                        <input asp-for="Password" class="form-control" placeholder="••••••••" style="border-radius: 12px; padding: 0.75rem 1rem; border: 1px solid #e5e7eb;" />
                        <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4 d-flex align-items-center justify-content-between">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" style="cursor: pointer;" />
                            <label asp-for="RememberMe" class="form-check-label" style="font-size: 0.9rem; color: #4b5563; cursor: pointer;">Remember me</label>
                        </div>
                        <!-- Password recovery isn't fully implemented in the current system but matching typical modern UX -->
                        <a href="#" style="font-size: 0.9rem; color: #e85d2a; font-weight: 500; text-decoration: none;">Forgot password?</a>
                    </div>

                    <button type="submit" class="btn w-100 text-white rounded-3 mb-4 custom-submit-btn" style="background:#e85d2a; font-weight:600; padding:12px; box-shadow:0 8px 24px rgba(232,93,42,0.25); border:none; transition: all 0.2s ease;">
                        Sign In <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                </form>

                <p class="text-center mb-0" style="font-size: 0.95rem; color: #6b7280;">
                    Don't have an account?
                    <a asp-action="Register" class="fw-bold" style="color: #e85d2a; text-decoration: none;">Register here</a>
                </p>
            </div>
        </div>
    </div>
</div>

<style>
    .form-control:focus {
        border-color: #e85d2a !important;
        box-shadow: 0 0 0 4px rgba(232,93,42,0.1) !important;
    }
    .custom-submit-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 28px rgba(232,93,42,0.3) !important;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}