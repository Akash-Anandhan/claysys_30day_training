@model IEnumerable<ProductDto>
@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<section class="position-relative overflow-hidden mb-5" style="border-radius: 24px; background: linear-gradient(135deg, rgba(232,93,42,0.85), rgba(124,88,204,0.9)), url('https://images.unsplash.com/photo-1607082348824-0a96f2a4b9da?q=80&w=2070&auto=format&fit=crop') center/cover; background-blend-mode: multiply;">
    <div class="position-absolute" style="top:-50px;right:-50px;width:300px;height:300px;background:rgba(255,255,255,0.1);border-radius:50%;filter:blur(40px);"></div>
    <div class="position-absolute" style="bottom:-50px;left:-50px;width:300px;height:300px;background:rgba(255,255,255,0.1);border-radius:50%;filter:blur(40px);"></div>
    <div class="container-fluid py-5 px-4 px-md-5 text-white position-relative" style="z-index: 1;">
        <div class="row align-items-center py-5">
            <div class="col-md-8 col-lg-6">
                <span class="badge rounded-pill mb-3 px-3 py-2" style="background: rgba(255,255,255,0.2); font-weight: 600; letter-spacing: 1px; backdrop-filter: blur(10px);">NEW COLLECTION 2026</span>
                <h1 class="display-4 fw-bold mb-3" style="font-family: 'Space Grotesk', sans-serif; letter-spacing: -0.03em;">
                    <i class="bi bi-bag-heart me-2 text-warning"></i>Welcome to Shopiee
                </h1>
                <p class="fs-5 mb-5 opacity-75" style="line-height: 1.6; max-width: 500px;">Discover amazing products at unbeatable prices. Elevate your lifestyle with our curated collection of premium goods.</p>
                <a class="btn btn-warning btn-lg rounded-pill px-5 py-3 fw-bold shadow-sm" asp-controller="Product" asp-action="Index" style="transition: transform 0.2s ease;" onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='translateY(0)'">
                    Explore Collection <i class="bi bi-arrow-right ms-2"></i>
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Featured Products -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0" style="font-family: 'Space Grotesk', sans-serif; letter-spacing: -0.02em;">
        Featured Products
        <span class="d-block mt-2" style="height: 4px; width: 40px; background: #e85d2a; border-radius: 2px;"></span>
    </h3>
</div>

<div class="row row-cols-1 row-cols-md-4 g-4 mb-5">
    @foreach (var product in Model)
    {
        <div class="col">
            <div class="card h-100 border-0 shadow-sm product-card" style="border-radius: 20px; transition: all 0.3s ease; overflow: hidden; background: #fff;">
                <div class="position-relative overflow-hidden" style="border-radius: 20px 20px 0 0;">
                    <img src="@product.ImageUrl" class="card-img-top p-3" alt="@product.Name" style="height: 220px; object-fit: contain; background-color: #ffffff; transition: transform 0.5s ease;" />
                    <div class="position-absolute top-0 end-0 p-3">
                        <span class="badge rounded-pill bg-white text-dark shadow-sm px-3 py-2 fw-bold" style="font-family: 'Space Grotesk', sans-serif; font-size: 0.9rem;">$@product.Price.ToString("0.00")</span>
                    </div>
                </div>
                <div class="card-body p-4">
                    <h5 class="card-title fw-bold mb-2 text-dark" style="font-family: 'Space Grotesk', sans-serif;">@product.Name</h5>
                    <p class="card-text text-muted small mb-0" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">@product.Description</p>
                </div>
                <div class="card-footer bg-transparent border-0 px-4 pb-4 pt-0 d-flex flex-column gap-2">
                    <div class="d-flex gap-2">
                        <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" class="btn rounded-pill flex-fill fw-semibold" style="background: #f3f4f6; color: #4b5563; border: none; transition: background 0.2s ease;" onmouseover="this.style.background='#e5e7eb'" onmouseout="this.style.background='#f3f4f6'">
                            <i class="bi bi-eye"></i> View
                        </a>
                        <form asp-controller="Wishlist" asp-action="Add" method="post" class="m-0">
                            <input type="hidden" name="productId" value="@product.Id" />
                            <button type="submit" class="btn btn-outline-danger rounded-pill px-3 shadow-sm" style="transition: all 0.2s ease;" onmouseover="this.style.backgroundColor='#fee2e2'" onmouseout="this.style.backgroundColor='transparent'">
                                <i class="bi bi-heart"></i>
                            </button>
                        </form>
                    </div>
                    
                    <button onclick="addToCartAjax(@product.Id)" class="btn w-100 rounded-pill text-white fw-semibold shadow-sm mt-1" style="background: #111827; border: none; transition: background 0.2s ease;" onmouseover="this.style.background='#1f2937'" onmouseout="this.style.background='#111827'">
                        <i class="bi bi-cart-plus"></i> Add to Cart
                    </button>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .product-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 16px 40px rgba(0,0,0,0.08) !important;
    }
    .product-card:hover .card-img-top {
        transform: scale(1.05);
    }
</style>

@section Scripts {
    <script>
        function addToCartAjax(productId) {
            fetch('/Cart/AddToCartAjax', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? ''
                },
                body: `productId=${productId}&quantity=1`
            })
            .then(res => res.json())
            .then(data => {
                if(data.success) {
                    var badge = document.getElementById('cart-count');
                    if(badge) badge.innerText = data.cartCount;
                } else {
                    if(data.redirectUrl) {
                        window.location.href = data.redirectUrl;
                    } else {
                        alert('Could not add to cart.');
                    }
                }
            })
            .catch(err => console.error(err));
        }
    </script>
}