@model ShoppingCartApp.ViewModels.ProductPaginationViewModel
@{
    ViewData["Title"] = "All Products";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-2">
    <div>
        <h2 class="fw-bold mb-1" style="font-family: 'Space Grotesk', sans-serif; letter-spacing: -0.02em;">
            All Products
        </h2>
        <p class="text-muted mb-0">@Model.TotalProducts products found</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-secondary rounded-3 d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#filterPanel" aria-expanded="false">
            <i class="bi bi-funnel"></i> Filters
        </button>
    </div>
</div>

<!-- Filter Panel - Always visible on large screens, collapsible on mobile -->
<div class="collapse d-lg-block" id="filterPanel">
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 16px;">
        <div class="card-body p-4">
            <form asp-action="Index" method="get" id="filterForm" class="row g-3 align-items-end">
                <input type="hidden" name="page" value="1" />
                <div class="col-12 col-md-3">
                    <label class="form-label small fw-semibold text-muted">Category</label>
                    <select name="category" class="form-select rounded-3" asp-for="Category">
                        <option value="">All Categories</option>
                        @if (Model.Categories != null)
                        {
                            @foreach (var cat in Model.Categories)
                            {
                                <option value="@cat.Name">@cat.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small fw-semibold text-muted">Min Price</label>
                    <input type="number" name="minPrice" class="form-control rounded-3" placeholder="₹ Min" min="0" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small fw-semibold text-muted">Max Price</label>
                    <input type="number" name="maxPrice" class="form-control rounded-3" placeholder="₹ Max" min="0" />
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label small fw-semibold text-muted">Sort By</label>
                    <select name="sortBy" class="form-select rounded-3">
                        <option value="">Default (Newest)</option>
                        <option value="price_asc">Price: Low to High</option>
                        <option value="price_desc">Price: High to Low</option>
                        <option value="name_asc">Name: A to Z</option>
                        <option value="name_desc">Name: Z to A</option>
                    </select>
                </div>
                <div class="col-12 col-md-2">
                    <button type="submit" class="btn btn-dark w-100 rounded-3">
                        <i class="bi bi-search me-1"></i> Apply
                    </button>
                </div>
            </form>
            @if (!string.IsNullOrEmpty(Context.Request.Query["category"]) || Context.Request.Query.ContainsKey("minPrice") || Context.Request.Query.ContainsKey("maxPrice") || Context.Request.Query.ContainsKey("sortBy"))
            {
                <div class="mt-3 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-3">
                        <i class="bi bi-x-circle me-1"></i> Clear Filters
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@if (Model.Products != null && Model.Products.Any())
{
<div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4 mb-5">
    @foreach (var product in Model.Products)
    {
        <div class="col">
            <div class="card h-100 border-0 shadow-sm product-card" style="border-radius: 20px; transition: all 0.3s ease; overflow: hidden; background: #fff;">
                <div class="position-relative overflow-hidden" style="border-radius: 20px 20px 0 0;">
                    <img src="@product.ImageUrl" class="card-img-top p-3" alt="@product.Name" style="height: 240px; object-fit: contain; background-color: #fafafa; transition: transform 0.5s ease;" loading="lazy" />
                    <div class="position-absolute top-0 end-0 p-3 d-flex flex-column gap-2 align-items-end">
                        <span class="badge rounded-pill bg-white text-dark shadow-sm px-3 py-2 fw-bold" style="font-family: 'Space Grotesk', sans-serif;">₹@product.SellingPrice.ToString("0.00")</span>
                    </div>
                    <div class="position-absolute top-0 start-0 p-3">
                        <span class="badge rounded-pill shadow-sm" style="background: rgba(255,255,255,0.9); color: #e85d2a; backdrop-filter: blur(4px); font-weight: 600;">@product.Category?.Name</span>
                    </div>
                </div>
                <div class="card-body p-4">
                    <h5 class="card-title fw-bold mb-2 text-dark" style="font-family: 'Space Grotesk', sans-serif;">@product.Name</h5>
                    <p class="card-text text-muted small mb-3" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">@product.Description</p>
                    <div class="d-flex align-items-center text-muted small fw-medium mt-auto">
                        <div class="d-flex align-items-center justify-content-center rounded-circle me-2" style="width: 24px; height: 24px; background: rgba(16,185,129,0.1);">
                            <i class="bi bi-box-seam" style="color: #10b981; font-size: 11px;"></i>
                        </div>
                        <span style="@(product.Stock < 5 ? "color: #ef4444;" : "")">@product.Stock in stock</span>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 px-4 pb-4 pt-0 d-flex flex-column gap-2">
                    <div class="d-flex gap-2">
                        <a asp-action="Details" asp-route-id="@product.Id" class="btn rounded-pill flex-fill fw-semibold" style="background: #f3f4f6; color: #4b5563; border: none; transition: background 0.2s ease;" onmouseover="this.style.background='#e5e7eb'" onmouseout="this.style.background='#f3f4f6'">
                            <i class="bi bi-eye"></i> Details
                        </a>
                        <form asp-controller="Cart" asp-action="AddToCart" method="post" class="flex-fill add-to-cart-form">
                            <input type="hidden" name="productId" value="@product.Id" />
                            <input type="hidden" name="quantity" value="1" />
                            <button type="submit" class="btn w-100 rounded-pill text-white fw-semibold shadow-sm" style="background: #111827; border: none; transition: background 0.2s ease;" onmouseover="this.style.background='#1f2937'" onmouseout="this.style.background='#111827'">
                                <i class="bi bi-cart-plus"></i> Add
                            </button>
                        </form>
                    </div>
                    <form asp-controller="Wishlist" asp-action="Add" method="post">
                        <input type="hidden" name="productId" value="@product.Id" />
                        <button type="submit" class="btn w-100 rounded-pill fw-semibold" style="background: rgba(239,68,68,0.05); color: #ef4444; border: 1px solid rgba(239,68,68,0.1); transition: all 0.2s ease;" onmouseover="this.style.background='#ef4444'; this.style.color='#fff';" onmouseout="this.style.background='rgba(239,68,68,0.05)'; this.style.color='#ef4444';">
                            <i class="bi bi-heart me-1"></i> Add to Wishlist
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

@if (Model.TotalPages > 1)
{
    <nav aria-label="Product pagination" class="d-flex justify-content-center mt-4">
        <ul class="pagination pagination-lg">
            @{var curPage = Model.CurrentPage; var totPages = Model.TotalPages;}
            <li class="page-item @(curPage <= 1 ? "disabled" : "")">
                <a class="page-link rounded-pill mx-1" asp-action="Index" asp-route-page="@(curPage - 1)" asp-route-query="@Model.SearchQuery" asp-route-category="@Model.Category" asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice" asp-route-sortBy="@Model.SortBy" style="color: #4b5563; border: 1px solid #e5e7eb;"><i class="bi bi-chevron-left"></i></a>
            </li>
            @{var s = Math.Max(1, curPage - 2); var e = Math.Min(totPages, curPage + 2);}
            @for (var i = s; i <= e; i++)
            {
                <li class="page-item @(i == curPage ? "active" : "")">
                    <a class="page-link rounded-pill mx-1" asp-action="Index" asp-route-page="@i" asp-route-query="@Model.SearchQuery" asp-route-category="@Model.Category" asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice" asp-route-sortBy="@Model.SortBy" style="@(i == curPage ? "background:#111827;color:#fff;border-color:#111827;" : "color:#4b5563;border:1px solid #e5e7eb;")">@i</a>
                </li>
            }
            <li class="page-item @(curPage >= totPages ? "disabled" : "")">
                <a class="page-link rounded-pill mx-1" asp-action="Index" asp-route-page="@(curPage + 1)" asp-route-query="@Model.SearchQuery" asp-route-category="@Model.Category" asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice" asp-route-sortBy="@Model.SortBy" style="color: #4b5563; border: 1px solid #e5e7eb;"><i class="bi bi-chevron-right"></i></a>
            </li>
        </ul>
    </nav>
}
}
else
{
    <div class="text-center py-5 my-5 rounded-4" style="background: rgba(248,250,252,0.8); border: 1px dashed #cbd5e1;">
        <div class="d-inline-flex justify-content-center align-items-center rounded-circle mb-3 bg-white shadow-sm text-muted" style="width:100px;height:100px;font-size:3rem;">
            <i class="bi bi-bag-x"></i>
        </div>
        <h3 class="fw-bold">No products found</h3>
        <p class="text-muted">Try adjusting your search criteria.</p>
        <a asp-action="Index" class="btn btn-primary btn-lg rounded-pill px-5">Browse All Products</a>
    </div>
}

<style>
    .product-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 16px 40px rgba(0,0,0,0.08) !important;
    }
    .product-card:hover .card-img-top {
        transform: scale(1.05);
    }
    .page-item.active .page-link { background: #111827 !important; border-color: #111827 !important; }
    .page-item.disabled .page-link { color: #9ca3af; }
</style>