@model ShoppingCartApp.DTOs.Admin.AdminDashboardDto

@{
    ViewData["Title"] = "Revenue Analytics";
    var stats = Model;
    var currentRange = ViewBag.CurrentDateRange as string ?? "This Year";
}

<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = {
    corePlugins: { preflight: false },
    theme: { extend: { colors: { brand: '#e85d2a', brandDark: '#c74b20', brandLight: '#fff0eb' } } }
  }
</script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
.dash-card {
    background: #ffffff;
    border-radius: 16px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.03);
    border: 1px solid rgba(0,0,0,0.04);
}
.chart-container-lg { position: relative; height: 400px; width: 100%; }
.stat-icon { width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; border-radius: 12px; }
</style>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="mb-2 mb-lg-0">
        <h2 class="fw-bold mb-1 text-2xl text-gray-800" style="font-family: 'Space Grotesk', sans-serif;">
            <i class="bi bi-graph-up-arrow text-brand me-2"></i> Revenue Analytics
        </h2>
    </div>
    <div class="d-flex gap-3 align-items-center">
        <a asp-action="ExportRevenueExcel" class="btn btn-sm btn-success rounded-pill">
            <i class="bi bi-download me-1"></i> Export Excel
        </a>
        <a asp-action="ExportRevenueCsv" class="btn btn-sm btn-info text-white rounded-pill">
            <i class="bi bi-download me-1"></i> Export CSV
        </a>
        <select class="form-select bg-white shadow-sm border-0 rounded-3 text-sm fw-medium" style="width: 140px;" onchange="window.location.href='/Admin/Revenue?dateRange=' + this.value">
            <option value="Today" selected="@(currentRange == "Today")">Today</option>
            <option value="This Week" selected="@(currentRange == "This Week")">This Week</option>
            <option value="This Month" selected="@(currentRange == "This Month")">This Month</option>
            <option value="This Year" selected="@(currentRange == "This Year")">This Year</option>
        </select>
        <button class="btn bg-white shadow-sm rounded-circle position-relative p-2" onclick="window.location.reload()">
            <i class="bi bi-arrow-clockwise text-gray-600 fs-5"></i>
        </button>
    </div>
</div>

<div class="row row-cols-1 row-cols-md-3 g-4 mb-4">
    <div class="col">
        <div class="dash-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <p class="text-gray-500 mb-1 text-sm fw-semibold text-uppercase">Gross Income</p>
                    <h3 class="fw-bold text-gray-800 mb-0">₹@stats.TotalIncome.ToString("N0")</h3>
                </div>
                <div class="stat-icon bg-success bg-opacity-10 text-success"><i class="bi bi-currency-dollar fs-4"></i></div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="dash-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <p class="text-gray-500 mb-1 text-sm fw-semibold text-uppercase">Total Exepnse</p>
                    <h3 class="fw-bold text-gray-800 mb-0">₹@stats.TotalExpense.ToString("N0")</h3>
                </div>
                <div class="stat-icon bg-danger bg-opacity-10 text-danger"><i class="bi bi-graph-down fs-4"></i></div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="dash-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <p class="text-gray-500 mb-1 text-sm fw-semibold text-uppercase">Net Profit</p>
                    <h3 class="fw-bold text-gray-800 mb-0">₹@((stats.TotalIncome - stats.TotalExpense).ToString("N0"))</h3>
                </div>
                <div class="stat-icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-piggy-bank fs-4"></i></div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-12">
        <div class="dash-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="fw-bold text-gray-800 mb-0">Income vs Expense Analytics (@currentRange)</h5>
            </div>
            <div class="chart-container-lg"><canvas id="detailedRevenueChart"></canvas></div>
        </div>
    </div>
</div>

<!-- Average Order Value Trend -->
<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="dash-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="fw-bold text-gray-800 mb-0"><i class="bi bi-graph-up text-success me-2"></i>Average Order Value Trend</h5>
                <span class="badge bg-success bg-opacity-10 text-success">₹@stats.AverageOrderValue.ToString("0.00") current avg</span>
            </div>
            <div class="chart-container-lg"><canvas id="aovTrendChart"></canvas></div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="dash-card p-4 h-100">
            <h5 class="fw-bold text-gray-800 mb-4"><i class="bi bi-wallet2 text-info me-2"></i>Revenue Summary</h5>
            <div class="d-flex flex-column gap-3">
                <div class="p-3 rounded-3" style="background: rgba(16, 185, 129, 0.1);">
                    <div class="text-muted small text-uppercase">Gross Income</div>
                    <div class="fw-bold text-success fs-4">₹@stats.TotalIncome.ToString("N0")</div>
                </div>
                <div class="p-3 rounded-3" style="background: rgba(239, 68, 68, 0.1);">
                    <div class="text-muted small text-uppercase">Total Expenses</div>
                    <div class="fw-bold text-danger fs-4">₹@stats.TotalExpense.ToString("N0")</div>
                </div>
                <div class="p-3 rounded-3" style="background: rgba(59, 130, 246, 0.1);">
                    <div class="text-muted small text-uppercase">Net Profit</div>
                    <div class="fw-bold text-primary fs-4">₹@((stats.TotalIncome - stats.TotalExpense).ToString("N0"))</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-12">
        <div class="dash-card h-100">
            <div class="p-4 border-bottom border-gray-100 pb-3">
                <h5 class="fw-bold text-gray-800 mb-0"><i class="bi bi-table text-brand me-2"></i>Breakdown Report</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 border-top-0">
                    <thead class="bg-gray-50 text-gray-600 text-xs text-uppercase fw-semibold" style="font-family: 'Inter', sans-serif;">
                        <tr>
                            <th class="ps-4 py-3 border-bottom-0">Period</th>
                            <th class="py-3 border-bottom-0 text-end">Revenue</th>
                            <th class="py-3 border-bottom-0 text-end">Expense</th>
                            <th class="py-3 border-bottom-0 text-end pe-4">Profit</th>
                        </tr>
                    </thead>
                    <tbody class="text-sm">
                        @for (int i = 0; i < stats.Months.Count; i++)
                        {
                            <tr>
                                <td class="ps-4 py-3 fw-medium text-gray-800">@stats.Months[i]</td>
                                <td class="py-3 text-end text-success">₹@stats.RevenueTrend[i].ToString("N2")</td>
                                <td class="py-3 text-end text-danger">₹@stats.CostTrend[i].ToString("N2")</td>
                                <td class="py-3 text-end pe-4 fw-bold text-primary">₹@stats.ProfitTrend[i].ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const data = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { 
            Months = Model.Months, 
            RevenueTrend = Model.RevenueTrend,
            CostTrend = Model.CostTrend,
            ProfitTrend = Model.ProfitTrend,
            AOVLabels = Model.AOVLabels,
            AOVValues = Model.AOVValues
        }, new System.Text.Json.JsonSerializerOptions { ReferenceHandler = System.Text.Json.Serialization.ReferenceHandler.IgnoreCycles }));

        Chart.defaults.font.family = "'Inter', 'Segoe UI', sans-serif";
        
        new Chart(document.getElementById('detailedRevenueChart'), {
            type: 'bar',
            data: {
                labels: data.Months,
                datasets: [
                    { label: 'Revenue', data: data.RevenueTrend, backgroundColor: '#10b981', borderRadius: 4 },
                    { label: 'Expense', data: data.CostTrend, backgroundColor: '#ef4444', borderRadius: 4 },
                    { label: 'Profit', data: data.ProfitTrend, backgroundColor: '#3b82f6', borderRadius: 4, type: 'line', tension: 0.4, borderWidth: 3 }
                ]
            },
            options: { responsive: true, maintainAspectRatio: false }
        });

        // Average Order Value Trend Chart
        if (data.AOVLabels && data.AOVLabels.length > 0 && data.AOVLabels[0] !== 'No Data') {
            new Chart(document.getElementById('aovTrendChart'), {
                type: 'line',
                data: {
                    labels: data.AOVLabels,
                    datasets: [{
                        label: 'Avg Order Value',
                        data: data.AOVValues,
                        borderColor: '#10b981',
                        backgroundColor: 'rgba(16, 185, 129, 0.1)',
                        fill: true,
                        tension: 0.4,
                        pointBackgroundColor: '#10b981',
                        pointBorderColor: '#fff',
                        pointBorderWidth: 2,
                        pointRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return '₹' + context.raw.toLocaleString('en-IN');
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    return '₹' + value.toLocaleString('en-IN');
                                }
                            }
                        }
                    }
                }
            });
        }
    });
</script>
