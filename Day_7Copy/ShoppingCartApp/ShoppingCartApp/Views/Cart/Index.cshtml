@model ShoppingCartApp.DTOs.Cart.CartDto
@{
    ViewData["Title"] = "My Cart";
}

<div class="d-flex align-items-center mb-4 mt-2">
    <h2 class="fw-bold mb-0" style="font-family: 'Space Grotesk', sans-serif; letter-spacing: -0.02em;">
        <i class="bi bi-cart3 text-warning me-2"></i> My Cart
    </h2>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" style="border-radius: 12px; border: none; border-left: 4px solid #ef4444; font-size: 0.95rem;">
        <i class="bi bi-exclamation-circle-fill me-2" style="color: #ef4444;"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Items.Any())
{
    <div class="text-center py-5 my-5 rounded-4 shadow-sm" style="background: rgba(248, 250, 252, 0.8); border: 1px dashed #cbd5e1;">
        <div class="d-inline-flex justify-content-center align-items-center rounded-circle mb-3 bg-white shadow-sm text-muted" style="width: 100px; height: 100px; font-size: 3rem;">
            <i class="bi bi-cart-x"></i>
        </div>
        <h3 class="fw-bold text-dark mt-2" style="font-family: 'Space Grotesk', sans-serif;">Your cart is empty</h3>
        <p class="text-muted mb-4 fs-5">Looks like you haven't added anything yet.</p>
        <a asp-controller="Product" asp-action="Index" class="btn btn-warning btn-lg rounded-pill px-5 fw-bold shadow-sm" style="transition: transform 0.2s ease;" onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='translateY(0)'">
            <i class="bi bi-arrow-left me-2"></i> Continue Shopping
        </a>
    </div>
}
else
{
    <div class="row g-4">
        <!-- Cart Items -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm" style="border-radius: 20px; overflow: hidden; background: #fff;">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table align-middle table-hover mb-0" id="cart-table">
                            <thead style="background: #f8fafc; font-size: 0.9rem;">
                                <tr>
                                    <th class="border-0 text-muted fw-semibold ps-4 py-3 text-uppercase" style="letter-spacing: 0.5px;">Product</th>
                                    <th class="border-0 text-muted fw-semibold py-3 text-uppercase" style="letter-spacing: 0.5px;">Price</th>
                                    <th class="border-0 text-muted fw-semibold py-3 text-uppercase text-center" style="letter-spacing: 0.5px;">Quantity</th>
                                    <th class="border-0 text-muted fw-semibold py-3 text-uppercase text-end" style="letter-spacing: 0.5px;">Subtotal</th>
                                    <th class="border-0 text-muted fw-semibold pe-4 py-3"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr id="cart-row-@item.Id" style="border-bottom: 1px solid #f1f5f9;">
                                        <td class="ps-4 py-4 align-middle">
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="bg-light rounded-3 d-inline-block" style="padding: 2px;">
                                                    <img src="@item.ImageUrl" width="64" height="64" style="object-fit:cover;" class="rounded-3 shadow-sm border" loading="lazy" />
                                                </div>
                                                <span class="fw-bold" style="color: #111827; font-size: 1.05rem;">
                                                    @item.ProductName
                                                </span>
                                            </div>
                                        </td>
                                        <td class="py-4 align-middle fw-semibold text-muted">
                                            ₹@item.UnitPrice.ToString("0.00")
                                        </td>
                                        <td class="py-4 align-middle text-center" style="width: 150px;">
                                            <div class="input-group input-group-sm bg-light rounded-pill p-1 d-inline-flex mx-auto" style="border: 1px solid #e2e8f0; width: 110px;">
                                                <button class="btn btn-sm border-0 d-flex align-items-center justify-content-center text-muted" type="button" onclick="changeQty(@item.Id, -1)" style="width: 28px; height: 28px; border-radius: 50%;">
                                                    <i class="bi bi-dash fw-bold"></i>
                                                </button>
                                                <input type="number" id="qty-@item.Id" value="@item.Quantity" min="1" max="99" class="form-control text-center bg-transparent border-0 fw-bold px-0 shadow-none" onchange="updateQty(@item.Id)" style="font-size: 1rem; color: #111827;" />
                                                <button class="btn btn-sm border-0 d-flex align-items-center justify-content-center text-muted" type="button" onclick="changeQty(@item.Id, 1)" style="width: 28px; height: 28px; border-radius: 50%;">
                                                    <i class="bi bi-plus fw-bold"></i>
                                                </button>
                                            </div>
                                        </td>
                                        <td class="py-4 align-middle fw-bold text-success text-end fs-5" id="subtotal-@item.Id">
                                            ₹@item.Subtotal.ToString("0.00")
                                        </td>
                                        <td class="pe-4 py-4 align-middle text-end">
                                            <form asp-action="Remove" method="post" class="remove-form d-inline-block">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-sm rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; background: rgba(239,68,68,0.1); color: #ef4444; border: none; transition: all 0.2s ease;" onmouseover="this.style.background='#ef4444'; this.style.color='#fff';" onmouseout="this.style.background='rgba(239,68,68,0.1)'; this.style.color='#ef4444';">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Order Summary -->
        <div class="col-lg-4">
            <div class="position-sticky" style="top: 100px;">
                <div class="card shadow-sm border-0 summary-card" style="border-radius: 20px; overflow: hidden; background: linear-gradient(180deg, #fff, #f8fafc);">
                    <div class="card-body p-4 pt-5">
                        <h4 class="fw-bold mb-4 border-bottom pb-3" style="font-family: 'Space Grotesk', sans-serif; letter-spacing: -0.02em;">Order Summary</h4>
                        
                        <div class="d-flex justify-content-between mb-3 text-muted fw-medium fs-6">
                            <span>Subtotal (<span id="summary-count">@Model.TotalCount</span> items)</span>
                            <span id="summary-items-total">₹@Model.Total.ToString("0.00")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-4 text-muted fw-medium fs-6">
                            <span>Shipping</span>
                            <span class="badge rounded-pill" style="background: rgba(16,185,129,0.1); color: #10b981; font-size: 0.85rem; padding: 4px 10px;">Free</span>
                        </div>
                        
                        <div class="d-flex justify-content-between align-items-center pt-3 mt-2 border-top">
                            <span class="fs-5 fw-bold" style="color: #111827;">Total</span>
                            <span class="fw-bold" style="color: #10b981; font-size: 2rem; font-family: 'Space Grotesk', sans-serif;" id="cart-total">
                                ₹@Model.Total.ToString("0.00")
                            </span>
                        </div>

                        <div class="mt-5">
                            @if (User.Identity.IsAuthenticated)
                            {
                                <a asp-controller="Order" asp-action="Checkout" class="btn w-100 rounded-pill text-white fw-bold py-3 shadow-sm d-flex justify-content-center align-items-center gap-2 mb-3" style="background: #e85d2a; border: none; font-size: 1.1rem; transition: transform 0.2s ease;" onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='translateY(0)'">
                                    <i class="bi bi-credit-card"></i> Proceed to Checkout
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Account" asp-action="Login" class="btn w-100 rounded-pill text-white fw-bold py-3 shadow-sm d-flex justify-content-center align-items-center gap-2 mb-2" style="background: #3b82f6; border: none; font-size: 1.1rem; transition: transform 0.2s ease;" onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='translateY(0)'">
                                    <i class="bi bi-box-arrow-in-right"></i> Login to Checkout
                                </a>
                                <p class="text-muted text-center small fw-medium mt-2 mb-3">
                                    <i class="bi bi-shield-check me-1 text-success"></i> Your cart will be saved securely.
                                </p>
                            }

                            <a asp-controller="Product" asp-action="Index" class="btn w-100 rounded-pill fw-semibold py-3 d-flex justify-content-center align-items-center gap-2" style="background: #f1f5f9; color: #4b5563; border: 1px solid #e2e8f0; transition: background 0.2s ease;" onmouseover="this.style.background='#e2e8f0'" onmouseout="this.style.background='#f1f5f9'">
                                <i class="bi bi-arrow-left"></i> Continue Shopping
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<style>
    /* Remove arrows from number input */
    input[type=number]::-webkit-inner-spin-button, 
    input[type=number]::-webkit-outer-spin-button { 
        -webkit-appearance: none; 
        margin: 0; 
    }
    input[type=number] {
        -moz-appearance: textfield;
    }
</style>

@section Scripts {
    <script>
        function changeQty(id, delta) {
            const input = document.getElementById('qty-' + id);
            const newQty = Math.max(1, parseInt(input.value) + delta);
            input.value = newQty;
            updateQty(id);
        }

        function updateQty(id) {
            const input  = document.getElementById('qty-' + id);
            const qty    = parseInt(input.value);

            if (isNaN(qty) || qty < 1) {
                input.value = 1;
                return;
            }

            input.disabled = true;

            fetch('/Cart/UpdateQuantity', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-Requested-With': 'XMLHttpRequest',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? ''
                },
                body: `id=${id}&quantity=${qty}`
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    if (data.removed) {
                        const row = document.getElementById('cart-row-' + id);
                        row.style.transition = 'all 0.3s ease';
                        row.style.transform = 'translateX(-20px)';
                        row.style.opacity = '0';
                        setTimeout(() => {
                            row.remove();
                            checkEmptyCart();
                        }, 300);
                    } else {
                        document.getElementById('subtotal-' + id).textContent = '₹' + data.subtotal;
                        document.getElementById('cart-total').textContent = '₹' + data.cartTotal;
                        const itemsTotalElem = document.getElementById('summary-items-total');
                        if (itemsTotalElem) itemsTotalElem.textContent = '₹' + data.cartTotal;
                        
                        const badge = document.getElementById('cart-count');
                        if (badge) badge.textContent = data.cartCount;
                    }
                }
            })
            .catch(() => {
                alert('An error occurred while updating the cart. Please try again.');
            })
            .finally(() => {
                input.disabled = false;
            });
        }

        function checkEmptyCart() {
            const rows = document.querySelectorAll('#cart-table tbody tr');
            if (rows.length === 0) {
                location.reload();
            }
        }

        let debounceTimers = {};
        document.querySelectorAll('input[type="number"]').forEach(input => {
            const id = input.id.replace('qty-', '');
            input.addEventListener('input', function () {
                clearTimeout(debounceTimers[id]);
                debounceTimers[id] = setTimeout(() => updateQty(id), 600);
            });
        });
    </script>
}