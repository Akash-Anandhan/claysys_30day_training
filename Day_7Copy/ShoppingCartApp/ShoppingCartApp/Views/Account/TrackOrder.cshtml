@model ShoppingCartApp.Models.Order
@using Microsoft.AspNetCore.Identity
@inject UserManager<ShoppingCartApp.Models.ApplicationUser> UserManager

@{
    ViewData["Title"] = "Track Order #" + Model.Id;
    var user = await UserManager.FindByIdAsync(Model.UserId);
    
    var statusSteps = new[] {
        new { Status = "Pending", Icon = "bi-clock", Description = "Order placed" },
        new { Status = "Processing", Icon = "bi-gear", Description = "Order prepared" },
        new { Status = "Shipped", Icon = "bi-truck", Description = "In transit" },
        new { Status = "Delivered", Icon = "bi-check-circle", Description = "Order delivered" }
    };
    
    int currentStepIndex = Array.FindIndex(statusSteps, s => s.Status == Model.Status);
    if (currentStepIndex < 0) currentStepIndex = 0;
    
    if (Model.Status == "Cancelled")
    {
        currentStepIndex = -1;
    }
}

<div class="mb-5 mt-2">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Account" asp-action="Orders">My Orders</a></li>
            <li class="breadcrumb-item active">Order #@Model.Id</li>
        </ol>
    </nav>
</div>

<div class="row g-4 mb-5">
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h5 class="card-title fw-bold mb-4">Order Summary</h5>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Order ID</span>
                    <span class="fw-bold">#@Model.Id</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Date</span>
                    <span>@Model.OrderDate.ToString("MMM dd, yyyy HH:mm")</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Status</span>
                    <span class="badge @GetStatusClass(Model.Status)">@Model.Status</span>
                </div>
                <hr />
                <div class="d-flex justify-content-between">
                    <span class="fw-bold">Total</span>
                    <span class="fw-bold" style="color:#10b981">₹@Model.TotalAmount.ToString("N0")</span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h5 class="card-title fw-bold mb-4">Order Timeline</h5>
                <div class="row align-items-center">
                    @for (int i = 0; i < statusSteps.Length; i++)
                    {
                        var step = statusSteps[i];
                        var isCompleted = i <= currentStepIndex;
                        <div class="col text-center">
                            <div class="d-inline-flex justify-content-center align-items-center rounded-circle mb-2 @(isCompleted ? "bg-success-subtle" : "bg-light")" 
                                 style="width:50px;height:50px">
                                <i class="bi @step.Icon" style="color:@(isCompleted ? "#10b981" : "#6b7280")"></i>
                            </div>
                            <h6 class="fw-bold mb-1 small" style="color:@(isCompleted ? "#111827" : "#6b7280")">@step.Status</h6>
                            <p class="text-muted small mb-0">@step.Description</p>
                        </div>
                        @if (i < statusSteps.Length - 1)
                        {
                            <div class="col-auto">
                                <div class="rounded-pill px-2 @(i < currentStepIndex ? "bg-success" : "bg-light")" style="height:2px;width:40px"></div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<h5 class="fw-bold mb-3">Order Items</h5>
<div class="row g-3">
    @foreach (var item in Model.OrderItems)
    {
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center p-3">
                    <img src="@(item.Product?.ImageUrl ?? "/images/placeholder.png")" width="50" height="50" class="rounded-3 me-3" style="object-fit:cover" />
                    <div class="flex-grow-1">
                        <h6 class="fw-bold mb-1">@item.Product?.Name</h6>
                        <p class="text-muted small mb-0">Qty: @item.Quantity × ₹@item.SellingPrice.ToString("N0")</p>
                    </div>
                    <span class="fw-bold" style="color:#10b981">₹@((item.Quantity * item.SellingPrice).ToString("N0"))</span>
                </div>
            </div>
        </div>
    }
</div>

@functions {
    string GetStatusClass(string status) => status switch {
        "Pending" => "bg-warning-subtle",
        "Processing" => "bg-primary-subtle",
        "Shipped" => "bg-info-subtle",
        "Delivered" => "bg-success-subtle",
        "Cancelled" => "bg-danger-subtle",
        _ => "bg-secondary-subtle"
    };
}